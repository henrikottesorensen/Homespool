@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = Localiser["TwoFactor_ConfigureAppTitle"].Value;
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div>
    <p>@Localiser["TwoFactor_Steps"]</p>
    <ol class="list">
        <li>
            <p>
                @Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["TwoFactor_DownloadApp"].Value, "<a href=\"https://go.microsoft.com/fwlink/?Linkid=825072\">Android</a>", "<a href=\"https://go.microsoft.com/fwlink/?Linkid=825073\">iOS</a>", "<a href=\"https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en\">Android</a>", "<a href=\"https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8\">iOS</a>"))
            </p>
        </li>
        <li>
            <p>@Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["TwoFactor_ScanKeyInto"].Value, $"<kbd>{Model.SharedKey}</kbd>"))</p>
            <div class="alert alert-info">@Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["TwoFactor_LearnQr"].Value, $"<a href=\"https://go.microsoft.com/fwlink/?Linkid=852423\">{Localiser["TwoFactor_EnableQrLink"].Value}</a>"))</div>
            <div id="qrCode"></div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        </li>
        <li>
            <p>
                @Localiser["TwoFactor_AfterScanning"]
            </p>
            <div class="row">
                <div class="col-md-6">
                    <form id="send-code" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="Please enter the code."/>
                            <label asp-for="Input.Code" class="control-label form-label">@Localiser["TwoFactor_VerificationCode"]</label>
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-lg btn-primary">@Localiser["TwoFactor_Verify"]</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
