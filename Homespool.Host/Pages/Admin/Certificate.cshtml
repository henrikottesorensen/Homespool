@page
@model CertificateModel
@{
    ViewData["Title"] = Localiser["Cert_Title"].Value;
}

<h1>@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-info" role="alert">@Model.StatusMessage</div>
}

@if (!Model.TlsEnabled)
{
    <div class="alert alert-warning" role="alert">
        <p class="mb-1">
            <strong>@Localiser["Cert_PlainHttpHeading"]</strong>
            (<code>PrusaConnect:PrinterTls</code> is false), so no certificate is issued or served.
        </p>
        <p class="mb-0">
            @Localiser["Cert_PlainHttpBody"]
        </p>
    </div>

    return;
}

<p>
    @Html.Raw(string.Format(
        System.Globalization.CultureInfo.CurrentCulture,
        Localiser["Cert_Explanation"].Value,
        $"<strong>{Localiser["Cert_Once"].Value}</strong>"))
</p>

@if (Model.Covered.Count == 0)
{
    <div class="alert alert-danger" role="alert">
        @Localiser["Cert_NoneIssued"]
    </div>
}

<div class="row">
    <div class="col-md-8">
        <table class="table">
            <tbody>
                <tr>
                    <th scope="row">@Localiser["Cert_Covers"]</th>
                    <td>
                        @if (Model.Covered.Count == 0)
                        {
                            <em>@Localiser["Cert_Nothing"]</em>
                        }
                        else
                        {
                            @foreach (string name in Model.Covered)
                            {
                                <div>
                                    <code>@name</code>
                                    @if (Model.Dropping.Contains(name))
                                    {
                                        <span class="badge text-bg-warning ms-1">@Localiser["Cert_WouldDrop"]</span>
                                    }
                                </div>
                            }
                        }
                    </td>
                </tr>
                <tr>
                    <th scope="row">@Localiser["Cert_MachineAnswersOn"]</th>
                    <td>
                        @if (Model.Current.Count == 0)
                        {
                            <em>@Localiser["Cert_NoUsableAddress"]</em>
                        }
                        else
                        {
                            @foreach (string name in Model.Current)
                            {
                                <div>
                                    <code>@name</code>
                                    @if (Model.Uncovered.Contains(name))
                                    {
                                        <span class="badge text-bg-warning">@Localiser["Cert_NotInCertificate"]</span>
                                    }
                                </div>
                            }
                        }
                    </td>
                </tr>
                <tr>
                    <th scope="row">@Localiser["Cert_PrintersToldToUse"]</th>
                    <td>
                        @if (Model.ConfiguredHost is null)
                        {
                            <em>@Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["Cert_NotConfiguredFor"].Value, "<code>PrusaConnect:PrinterHost</code>"))</em>
                        }
                        else
                        {
                            <code>@Model.ConfiguredHost</code>
                            @if (Model.ConfiguredHostUncovered)
                            {
                                <span class="badge text-bg-danger">@Localiser["Cert_NotInCertificate"]</span>
                            }
                        }
                    </td>
                </tr>
                <tr>
                    <th scope="row">@Localiser["Cert_Expires"]</th>
                    <td>@(Model.LeafExpires?.ToString("yyyy-MM-dd") ?? "-")</td>
                </tr>
                <tr>
                    <th scope="row">@Localiser["Cert_AuthorityExpires"]</th>
                    <td>
                        @(Model.AuthorityExpires?.ToString("yyyy-MM-dd") ?? "-")
                        <div class="form-text">
                            Replacing this one means a USB visit to every printer - it is their entire trust
                            store and cannot be sent over the network. Plan it well ahead.
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@if (Model.ConfiguredHostUncovered)
{
    <div class="alert alert-danger" role="alert">
        The address printers are told to use is not in the certificate, so no provisioning bundle can be
        produced for it and any printer connecting to it cannot verify this server.
    </div>
}
else if (Model.Uncovered.Count > 0)
{
    <div class="alert alert-warning" role="alert">
        This machine has addresses the certificate does not cover. That is only a problem for printers
        told to use one of them - the ones using a covered address are unaffected.
    </div>
}

<form method="post" asp-page-handler="Reissue">
    @if (Model.Dropping.Count > 0)
    {
        <div class="alert alert-warning" role="alert">
            <strong>@Localiser["Cert_WouldNarrow"]</strong> These names are covered today
            and this machine no longer answers on them, so they would not be carried over. That is
            usually right - a certificate should only vouch for what a printer can reach. But
            <strong>@Localiser["Cert_WouldStopConnecting"]</strong>
            once the new certificate is served, reporting a bare TLS error that names nothing, and
            putting it back means a USB visit to repoint it.
            <p class="mt-2 mb-1">@Localiser["Cert_KeepTicked"]</p>
            @foreach (string name in Model.Dropping)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="KeepNames" value="@name"
                           id="keep-@name" />
                    <label class="form-check-label" for="keep-@name">
                        keep <code>@name</code>
                    </label>
                </div>
            }
        </div>
    }

    <button type="submit" class="btn btn-primary">@Localiser["Cert_Reissue"]</button>
    <a class="btn btn-link" asp-page="/Index">@Localiser["Common_Back"]</a>
</form>

<p class="form-text mt-2">
    @Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["Cert_ReissueNeedsReload"].Value, $"<strong>{Localiser["Cert_ProxyReloaded"].Value}</strong>"))<code>docker compose exec
    proxy nginx -s reload</code> - because the proxy is what presents this certificate to printers,
    and it read the current one when it started. The application itself keeps running. A printer that
    is already connected keeps meeting the old certificate until it next reconnects, since the reload
    is graceful and does not interrupt live connections. Nothing is needed at the printers either:
    both certificates are signed by the authority, which this does not touch.
</p>
