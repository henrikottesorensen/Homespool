@page
@model RegisterModel
@{
    ViewData["Title"] = Localiser["Account_AcceptInvitation"].Value;
}

<h1>@ViewData["Title"]</h1>

@if (!Model.InviteValid)
{
    <div class="row">
        <div class="col-md-6">
            <p>
                @Localiser["Account_InviteInvalid"]
            </p>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <h2>@(Model.Reactivating ? Localiser["Account_ReactivateHelp"] : Localiser["Account_CreateAccountHelp"])</h2>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <input type="hidden" asp-for="InviteId" />
                <input type="hidden" asp-for="Code" />
                <div class="form-floating mb-3">
                    <input class="form-control" value="@Model.Email" readonly autocomplete="email" aria-label="@Localiser["Account_Email"]" />
                    <label class="form-label">@Localiser["Account_Email"]</label>
                </div>
                @if (Model.Reactivating)
                {
                    @* Already theirs. Reactivation restores a credential; it does not rename an account. *@
                    <div class="form-floating mb-3">
                        <input class="form-control" value="@Model.ExistingUsername" readonly autocomplete="username" aria-label="@Localiser["Account_Username"]" />
                        <label class="form-label">@Localiser["Account_Username"]</label>
                    </div>
                }
                else
                {
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Username" class="form-control" autocomplete="username" aria-required="true" placeholder="@Localiser["Common_UsernamePlaceholder"]" />
                        <label asp-for="Input.Username">@Localiser["Account_Username"]</label>
                        <span asp-validation-for="Input.Username" class="text-danger"></span>
                        <div class="form-text">@Html.Raw(string.Format(
                            System.Globalization.CultureInfo.CurrentCulture,
                            Localiser["Account_UsernameChars"].Value,
                            "<code>-</code>", "<code>.</code>", "<code>_</code>"))</div>
                    </div>
                }
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@Localiser["Common_PasswordPlaceholder"]" />
                    <label asp-for="Input.Password">@Localiser["Account_Password"]</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@Localiser["Common_PasswordPlaceholder"]" />
                    <label asp-for="Input.ConfirmPassword">@Localiser["Account_ConfirmPassword"]</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">@Localiser["Account_CreateAccount"]</button>
            </form>

            @if (!Model.Reactivating && Model.ExternalLogins.Count > 0)
            {
                @* Accept the invitation with a provider instead of a password. The invite's id and
                   token go with the challenge, so the callback spends it on proof the invitee holds
                   the emailed secret - see RegisterModel.ExternalLogins. *@
                <hr />
                <h2 class="h5">@Localiser["Account_OrAcceptWith"]</h2>
                <form id="invite-external-form" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <input type="hidden" name="inviteId" value="@Model.InviteId" />
                    <input type="hidden" name="code" value="@Model.Code" />
                    @foreach (var provider in Model.ExternalLogins)
                    {
                        <button id="@($"invite-external-{provider.Name}")" type="submit" class="w-100 btn btn-lg btn-outline-primary"
                                name="provider" value="@provider.Name"
                                title="@Localiser["Account_SignInWithProviderTitle", provider.DisplayName ?? provider.Name]">@provider.DisplayName</button>
                    }
                </form>
            }
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
