<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.1.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- ExternalOidcDexTests drives the real ASP.NET Core pipeline through the OIDC handler, the
             one thing a service-level test cannot do: the callback is a request, and the external
             cookie it reads is written by the handler earlier in the same pipeline. -->
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Homespool.Host\Homespool.Host.csproj" />
      <!-- For HomespoolFactory alone. Reimplementing it here would reimplement its content-root
           isolation with it, and that override exists because three components escaped into the
           project tree one at a time - see its own remarks. A test project referencing another is
           worth the smell to not rediscover those. -->
      <ProjectReference Include="..\Homespool.Host.E2ETest\Homespool.Host.E2ETest.csproj" />

      <!-- The fake WebAuthn authenticator, linked as the other two test projects link it. -->
      <Compile Include="..\Homespool.Host.Test\FakeAuthenticator.cs" Link="FakeAuthenticator.cs" />
    </ItemGroup>

</Project>
