@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = Localiser["Account_ResetPasswordConfirmTitle"].Value;
}

<h1>@ViewData["Title"]</h1>
<p>
    @Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["Account_PasswordReset"].Value, $"<a href=\"{Url.Page("./Login")}\">{Localiser["Account_ClickToLogIn"].Value}</a>"))
</p>
@* Worded without reference to the account - this page is reached by anyone who submits the form,
   including for an address that does not exist, so anything specific would confirm whether it did. *@
<p>
    @Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["Account_TokensRevoked"].Value, $"{Localiser["Manage_AccountMenu"].Value} &rsaquo; {Localiser["Manage_ApiTokens"].Value}"))
</p>
@* Passkeys are not revoked by a reset - they are the person's own sign-in, not a machine's - but a
   reset is the path somebody takes after a compromise, and a passkey the other party added is what
   they need to go and look for. Generic for the same reason as the paragraph above. *@
<p>
    @Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["Account_ReviewPasskeysAfterReset"].Value, $"{Localiser["Manage_AccountMenu"].Value} &rsaquo; {Localiser["Manage_Passkeys"].Value}"))
</p>
