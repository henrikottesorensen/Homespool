@model string[]

@*  The one render of a set of recovery codes, drawn by the response to the post that minted them.
    They are never handed to another request: a redirect would carry them in the TempData cookie,
    which any signed-in session can have decrypted and which stays good after it has been read. *@
<div class="alert alert-warning" role="alert">
    <p>
        <strong>@Localiser["TwoFactor_KeepCodesSafe"]</strong>
    </p>
    <p>
        @Localiser["TwoFactor_LoseDeviceWarning"]
    </p>
</div>
<div class="row">
    <div class="col-md-12">
        @*  Two per row, and the odd one out is checked rather than assumed: Identity.UI's original
            steps by two and indexes row + 1 unconditionally, which throws on any odd count. Both
            callers ask for ten today, so the guard costs nothing and stops the count becoming a
            load-bearing coincidence. *@
        @for (int row = 0; row < Model.Length; row += 2)
        {
            <div>
                <code class="recovery-code me-2">@Model[row]</code>
                @if (row + 1 < Model.Length)
                {
                    <code class="recovery-code">@Model[row + 1]</code>
                }
            </div>
        }
    </div>
</div>
