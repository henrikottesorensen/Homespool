@using Homespool.Host.Accounts
@inject SignInManager<HSUser> SignInManager
@inject UserManager<HSUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a id="printers" class="nav-link" asp-page="/Printers/Index">@Localiser["Printers_Title"]</a>
    </li>
    <li class="nav-item">
        <a id="files" class="nav-link" asp-page="/Files/Index">@Localiser["Files_Title"]</a>
    </li>
    <li class="nav-item">
        <a id="cameras" class="nav-link" asp-page="/Cameras/Index">@Localiser["Cameras_Title"]</a>
    </li>
    @if (User.IsInRole(AdminBootstrap.AdminRole))
    {
@*  One menu rather than three links: these are deployment-wide settings an administrator visits
    rarely, and spread across the bar they were three eighths of it that most accounts never see.
    Sitting after the working pages and beside the account links puts the chrome together.

    The two tooltips survive the move because they say something the label does not - which
    certificate, and what the live-view setting decides. The sibling links whose tooltips only
    repeated their own text lost them earlier and gain nothing here.

    Neither the certificate nor the live-view entry is optional: the health banner sends an
    administrator to one and names the setting on the other, so both need somewhere to arrive. *@
        <li class="nav-item dropdown">
            <a id="admin" class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">@Localiser["Nav_Admin"]</a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a id="invites" class="dropdown-item" asp-page="/Admin/Invites/Index">@Localiser["Nav_Invites"]</a>
                </li>
                <li>
                    <a id="certificate" class="dropdown-item" asp-page="/Admin/Certificate" title="@Localiser["Nav_CertificateTitle"]">@Localiser["Nav_Certificate"]</a>
                </li>
                <li>
                    <a id="live-view" class="dropdown-item" asp-page="/Admin/LiveView" title="@Localiser["Nav_LiveViewTitle"]">@Localiser["Nav_LiveView"]</a>
                </li>
                <li>
                    <a id="settings" class="dropdown-item" asp-page="/Admin/Settings" title="@Localiser["Nav_SettingsTitle"]">@Localiser["Settings_Title"]</a>
                </li>
            </ul>
        </li>
    }
@*  The username is already in the cookie - Identity writes it as ClaimTypes.Name - so naming the
    signed-in account costs no query and needs no claim of our own.

    aria-label because the visible text is a bare name: sighted readers get "who am I, and the way
    to my account" from its position in the bar, and a screen reader announcing "henrik.sorensen,
    menu" gets neither.

    Logout is inside the menu rather than beside it, so the bar ends at one account item instead of
    two. It is the only entry that acts rather than navigates, which is what the divider says.

    External logins appears only where a provider is configured. Nothing registers one today, so the
    entry is unreachable - and the page it points at does not exist, which the guard is currently all
    that hides.

    No "Personal data" item. Identity.UI's version offers to export and delete what the service holds
    about you, which is a question that only makes sense when somebody else is holding it - and this
    application exists so that nobody is. The data is on the operator's own disk, in a directory named
    after them. *@
    <li class="nav-item dropdown">
        <a id="manage" class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@Localiser["Nav_ManageAccount"]">@UserManager.GetUserName(User)</a>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <a id="profile" class="dropdown-item" asp-page="/Account/Manage/Index">@Localiser["Manage_Profile"]</a>
            </li>
            <li>
                <a id="email" class="dropdown-item" asp-page="/Account/Manage/Email">@Localiser["Account_Email"]</a>
            </li>
            <li>
                <a id="change-password" class="dropdown-item" asp-page="/Account/Manage/ChangePassword">@Localiser["Account_Password"]</a>
            </li>
            @if ((await SignInManager.GetExternalAuthenticationSchemesAsync()).Any())
            {
                <li>
                    <a id="external-logins" class="dropdown-item" asp-page="/Account/Manage/ExternalLogins">@Localiser["Manage_ExternalLogins"]</a>
                </li>
            }
            <li>
                <a id="two-factor" class="dropdown-item" asp-page="/Account/Manage/TwoFactorAuthentication">@Localiser["Manage_TwoFactor"]</a>
            </li>
            <li>
                <a id="api-tokens" class="dropdown-item" asp-page="/Account/Manage/ApiTokens">@Localiser["Manage_ApiTokens"]</a>
            </li>
            <li>
                <a id="language" class="dropdown-item" asp-page="/Account/Manage/Language">@Localiser["Language_Heading"]</a>
            </li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form id="logoutForm" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button id="logout" type="submit" class="dropdown-item">@Localiser["Nav_Logout"]</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" id="login" asp-page="/Account/Login">@Localiser["Nav_Login"]</a>
    </li>
}
</ul>
