@page "{uuid:guid}"
@using Homespool.Host.Firmware
@model FirmwareModel
@{
    string printerName = PrinterDisplayName.For(Model.Printer);

    ViewData["Title"] = Localiser["Firmware_Title", printerName];

    var uuid = Model.Printer.Uuid;
}

<div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2">
    <h1 class="mb-0">@ViewData["Title"]</h1>
    <a asp-page="Detail" asp-route-uuid="@uuid">@Localiser["Firmware_BackToPrinter", printerName]</a>
</div>

@if (Model.StatusMessage is not null)
{
    <div class="alert alert-dismissible fade show mt-3 @(Model.StatusSuccess ? "alert-success" : "alert-danger")"
         role="alert" @(Model.StatusSuccess ? "data-dismiss-after" : null)>
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localiser["Common_Close"]"></button>
    </div>
}

<p class="mt-3">
    @if (Model.Printer.Firmware is null)
    {
        @Localiser["Firmware_CurrentUnknown"]
    }
    else
    {
        @Localiser["Firmware_Current", Model.Printer.Firmware]
    }
</p>

<h2 class="h5 mt-4">@Localiser["Firmware_StoredHeading"]</h2>

@if (Model.Images.Count == 0)
{
    <p class="text-body-secondary">@Localiser["Firmware_NoneStored"]</p>
}
else
{
    <table class="table align-middle" role="table">
        <thead role="rowgroup">
            <tr role="row">
                <th role="columnheader">@Localiser["Firmware_Version"]</th>
                <th role="columnheader">@Localiser["Common_File"]</th>
                <th role="columnheader" class="text-end">@Localiser["Files_Size"]</th>
                <th role="columnheader">@Localiser["Files_Uploaded"]</th>
            </tr>
        </thead>
        <tbody role="rowgroup">
            @foreach (FirmwareImage image in Model.Images)
            {
                <tr role="row">
                    <td role="cell" class="font-monospace text-nowrap">@image.Header.Version</td>
                    <td role="cell" class="typed-name">@image.Name</td>
                    <td role="cell" class="text-end font-monospace text-nowrap">@ByteSize.Format(image.Size, Localiser)</td>
                    <td role="cell">@image.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h5 mt-4">@Localiser["Firmware_UploadHeading"]</h2>

<p class="text-body-secondary">@Localiser["Firmware_UploadHelp"]</p>

<form method="post" asp-page-handler="Upload" asp-route-uuid="@uuid" enctype="multipart/form-data"
      class="d-flex align-items-center gap-2">
    <input type="file" name="file" accept=".bbf" class="form-control" aria-label="@Localiser["Firmware_UploadLabel"]" required />
    <button type="submit" class="btn btn-primary text-nowrap">@Localiser["Files_Upload"]</button>
</form>
