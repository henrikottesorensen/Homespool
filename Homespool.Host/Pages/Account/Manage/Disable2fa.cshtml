@page
@model Disable2faModel
@{
    ViewData["Title"] = Localiser["TwoFactor_DisableTitle"].Value;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h1>@ViewData["Title"]</h1>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>@Localiser["TwoFactor_DisableOnly"]</strong>
    </p>
    <p>
        @HtmlLocaliser["TwoFactor_DisableKeepsKeys", Markup.Link(Url.Page("./ResetAuthenticator"), Localiser["TwoFactor_ResetKeysLink"].Value)]
    </p>
</div>

<div>
    @* Nothing to prove here: the page is reached only with a recent proof, earned on the one page
       that takes every credential the account holds. *@
    <form method="post">
        <button class="btn btn-danger" type="submit">@Localiser["TwoFactor_Disable"]</button>
    </form>
</div>
