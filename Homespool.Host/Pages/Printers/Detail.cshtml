@page "{uuid:guid}"
@using Homespool.Host.PrusaConnect
@using Homespool.Model
@model DetailModel
@{
    ViewData["Title"] = Model.Statistics.Printer.Name ?? Model.Statistics.Printer.Model ?? Model.Statistics.Printer.Uuid.ToString();

    var uuid = Model.Statistics.Printer.Uuid;

    string printerName = Model.Statistics.Printer.Name
                         ?? Model.Statistics.Printer.Model
                         ?? Model.Statistics.Printer.Uuid.ToString();
}

@* The page answers one question first - what is this printer doing - and everything that is a
   record rather than a state sits behind a disclosure underneath. The order is deliberate: status,
   the controls that change it, the temperatures it has been holding, what it can see, what it will
   do next. *@

<div class="d-flex flex-wrap align-items-baseline justify-content-between gap-2">
    <h1 class="typed-name mb-0">@ViewData["Title"]</h1>
    <a asp-page="Index">@Localiser["Printers_BackToList"]</a>
</div>

<p class="text-body-secondary">
    @Localiser["Printers_TeamLabel"]
    <span class="typed-name">@(Model.Statistics.Printer.Team?.Name
                               ?? Localiser["Common_TeamNumbered", Model.Statistics.Printer.TeamId].Value)</span>
</p>

@* This page is left open for the length of a print, which is what makes an ordinary status alert
   behave badly here: it is rendered once at load and nothing re-renders it, so "Marked ready" sat on
   screen for the whole job it had already started.

   A success is a confirmation of something you just did and just watched happen, so it takes itself
   away. A failure is not - it may be the only place the printer's own refusal is written down, and
   somebody who looked away needs it to still be there. Both can be closed by hand. *@
@if (Model.StatusMessage is not null)
{
    <div class="alert alert-dismissible fade show @(Model.StatusSuccess ? "alert-success" : "alert-danger")"
         role="alert" @(Model.StatusSuccess ? "data-dismiss-after" : null)>
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localiser["Common_Close"]"></button>
    </div>
}

@* Refreshed in place by live-region.js. Without script it is simply what the server rendered when
   the page loaded, which is what it was before any of this. *@
<div class="mb-3" data-live-region
     data-live-url="@Url.Page("Detail", "Status", new { uuid })"
     data-live-interval="2000">
    <partial name="_PrinterStatus" model="Model" />
</div>

@* Outside the refreshed region on purpose - see OnGetStatusAsync. Every control here reaches the
   machine, so all of them are hidden without CanUse rather than rendered and refused. *@
@if (Model.CanUse)
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        @* Gated only on being connected, not on whether a print is actually running - the firmware's
           own refusal ("No print to pause") is the real guard, and it is a better sentence than one
           composed here from a status a second old. *@
        @if (Model.Connected)
        {
            <form method="post" asp-page-handler="Pause" asp-route-uuid="@uuid" class="d-inline">
                <button type="submit" class="btn btn-outline-secondary">@Localiser["Intent_PausePrint"]</button>
            </form>
            <form method="post" asp-page-handler="Resume" asp-route-uuid="@uuid" class="d-inline">
                <button type="submit" class="btn btn-outline-secondary">@Localiser["Intent_ResumePrint"]</button>
            </form>
            <form method="post" asp-page-handler="Stop" asp-route-uuid="@uuid" class="d-inline">
                <button type="submit" class="btn btn-outline-danger">@Localiser["Intent_StopPrint"]</button>
            </form>
        }

        @* Heaters, and only ever both together. The service can set either alone and nothing here
           can: a page that could leave one heater on and the other off would be a way to make a
           mistake quietly.

           Absent on a toolchanger with nothing picked: M140 is the bed and would apply, M104 is the
           nozzle and would not, so the pair half-lands while the frame is answered Accepted. See
           notes/toolchangers.md §3d. *@
        @if (Model.Tools.ReachesAHotend)
        {
        <form method="post" asp-page-handler="Preheat" asp-route-uuid="@uuid"
              class="d-flex align-items-center gap-2">
            <label class="visually-hidden" for="filament">@Localiser["Printers_PreheatFor"]</label>

            <select class="form-select w-auto" id="filament" name="filament">
                @foreach (FilamentPreset preset in Model.Presets)
                {
                    <option value="@preset.Name">
                        @preset.Name &mdash; @preset.NozzleTemperature&deg;C / @preset.BedTemperature&deg;C
                    </option>
                }
            </select>

            <button type="submit" class="btn btn-outline-primary">@Localiser["Printers_Preheat"]</button>
        </form>

        <form method="post" asp-page-handler="Cooldown" asp-route-uuid="@uuid">
            <button type="submit" class="btn btn-outline-secondary">@Localiser["Printers_CoolDown"]</button>
        </form>
        }

        @* Absent unless the printer has named its filament, which is the same condition under which
           firmware will run the unload without stopping at a dialog on the panel - and which usually
           just means there is nothing in the machine to take out. No confirm dialog, matching
           preheat: this changes the physical world, but harmlessly and on purpose. *@
        @if (Model.UnloadShown)
        {
            @* One tool means no choice to make, so it stays a plain button; several means a real
               one, so it opens a picker. Same rule either way - ask only when something is being
               decided - rather than two philosophies by printer type. *@
            @if (Model.UnloadNeedsPicker)
            {
                <button type="button" class="btn btn-outline-secondary"
                        data-bs-toggle="modal" data-bs-target="#unload-tool">
                    @Localiser["Printers_UnloadEllipsis"]
                </button>
            }
            else
            {
                <form method="post" asp-page-handler="Unload" asp-route-uuid="@uuid">
                    <input type="hidden" name="tool" value="@Model.UnloadableTools[0].ToolNumber" />
                    <button type="submit" class="btn btn-outline-secondary">
                        @Localiser["Printers_Unload", Model.UnloadableTools[0].Material!]
                    </button>
                </form>
            }
        }

        @* Setting ready is a person asserting the sheet is clear, which is why the walk to the
           machine was never pure friction - it forced somebody to look. Off unless this printer has
           been judged one whose sheet can be read from here, so the control is absent rather than
           refusing. *@
        @if (Model.Statistics.Printer.RemoteReadyAllowed)
        {
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#set-ready">
                @Localiser["Intent_SetPrinterReady"]
            </button>
        }
    </div>

    @* Cooling is refused mid-print too, which reads as arbitrary unless it is said: the button looks
       like a safety control and is not one. Said on the page rather than only in the refusal, so
       nobody has to press it to find out.

       It used to end by sending the reader to the printers list to stop a print. Stop is on this page
       now, two controls to the left, so the sentence went with it. *@
    <p class="text-body-secondary small">
        @Localiser["Printers_PreheatBoth"]
        @Html.Raw(string.Format(
            System.Globalization.CultureInfo.CurrentCulture,
            Localiser["Printers_PreheatWarning"].Value,
            $"<strong>{Localiser["Printers_CoolingIncluded"].Value}</strong>"))
    </p>

    @* Said beside the button rather than only after pressing it: the unload runs for minutes and
       the printer declines other gcode while it does, so somebody who presses Cool down next and
       meets a refusal should already know why. *@
    @if (Model.UnloadShown)
    {
        <p class="text-body-secondary small">@Localiser["Printers_UnloadNote"]</p>
    }
}

@* Whether the ready prompt can be answered honestly for this printer is a standing judgement about
   the machine, so it sits behind CanManage rather than CanUse: decided once by somebody who has seen
   it, inherited by everyone who has not. *@
@if (Model.CanManage)
{
    @* The switch is the control, not a picture of one. An unchecked checkbox posts nothing, so the
       handler's bool binds false on its own and no hidden field is needed to carry the flipped
       value. The Save button is the no-script path and toggle-submit.js hides it. *@
    <form method="post" asp-page-handler="RemoteReady" asp-route-uuid="@uuid" class="mb-4">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="remote-ready"
                   name="allowed" value="true" data-submit-on-change
                   @(Model.Statistics.Printer.RemoteReadyAllowed ? "checked" : null) />
            <label class="form-check-label" for="remote-ready">@Localiser["Printers_RemoteReadyLabel"]</label>
        </div>

        <p class="text-body-secondary small mt-1">@Localiser["Printers_RemoteReadyHelp"]</p>

        <button type="submit" class="btn btn-outline-secondary btn-sm" data-submit-fallback>
            @Localiser["Common_Save"]
        </button>
    </form>
}

<h2 class="h5">@Localiser["Printers_Temperature"]</h2>

@* A slower poll than the status card above it: the window can be a whole print, and redrawing that
   every two seconds would produce the same picture at a much higher price. *@
<div class="mb-4" data-live-region
     data-live-url="@Url.Page("Detail", "Graph", new { uuid })"
     data-live-interval="30000">
    <partial name="_TemperatureGraph" model="Model" />
</div>

@if (Model.Cameras.Count > 0)
{
    @* One figure per camera. The picture is deliberately the largest thing here: this is what
       somebody looks at to decide whether a bed is clear, and a status line saying "camera fine" is
       not the same claim. *@
    <div class="row g-3 mb-4">
        @for (int index = 0; index < Model.Cameras.Count; index++)
        {
            var camera = Model.Cameras[index];
            <div class="col-md-6">
                <figure class="mb-0">
                    @* ratio-16x9 reserves the space before anything loads, so the panel is a box from
                       the first paint rather than collapsing to nothing and shoving the page down when
                       a frame arrives. The border makes that reserved space legible as "a picture goes
                       here" rather than as an empty gap. Both cameras here are 16:9; a camera that is
                       not will letterbox rather than distort, which object-fit-contain is for. *@
                    <div class="camera-view ratio ratio-16x9 border rounded bg-body-tertiary overflow-hidden"
                         data-camera-frame="@Url.Action("Frame", "Camera", new { uuid = camera.Uuid })"
                         data-camera-live="@Url.Action("Live", "Camera", new { uuid = camera.Uuid })"
                         data-camera-webrtc="@Url.Action("WebRtc", "Camera", new { uuid = camera.Uuid })"
                         data-camera-stream="@Url.Action("Stream", "Camera", new { uuid = camera.Uuid })">
                        @* Empty until a frame arrives. An img with no src draws nothing, which is
                           what "no picture yet" should look like - not a broken-image icon. *@
                        <img class="camera-image w-100 h-100 object-fit-contain d-none" alt="" />
                        @* The same box as the still, so switching between them moves nothing on the
                           page. muted and playsinline are what let it start without a gesture and
                           without iOS taking it fullscreen; there is no audio track to lose. *@
                        <video class="camera-live-video w-100 h-100 object-fit-contain d-none"
                               autoplay muted playsinline></video>
                        <div class="camera-status d-flex align-items-center justify-content-center text-body-secondary small">
                            @Localiser["Cameras_Capturing"]
                        </div>
                        @* In the picture, bottom left, mirroring maximise on the right - which is
                           where a video player puts a play control. Icon-only, so every label it used
                           to show as text is now its accessible name, and the words that used to sit
                           on the button (connecting, failed, stalled) go to the note below the frame.

                           Hidden until the server says this camera may be offered. Nothing can report
                           a camera's codec before something watches it, so the button is offered
                           optimistically and taken away by the first refusal - a JPEG camera loses it
                           after one press, saying why. *@
                        <button type="button" class="camera-overlay-btn camera-live-toggle btn btn-sm d-none"
                                data-label-watch="@Localiser["Cameras_WatchLive"]"
                                data-label-stop="@Localiser["Cameras_StopLive"]"
                                data-label-connecting="@Localiser["Cameras_LiveConnecting"]"
                                data-label-failed="@Localiser["Cameras_LiveFailed"]"
                                data-label-live="@Localiser["Cameras_LiveNow"]"
                                data-label-stalled="@Localiser["Cameras_LiveStalled"]"
                                aria-label="@Localiser["Cameras_WatchLive"]" title="@Localiser["Cameras_WatchLive"]">
                            <svg class="camera-live-icon" width="18" height="18" viewBox="0 0 16 16"
                                 fill="currentColor" aria-hidden="true">
                                <path class="camera-live-play" d="M4.5 2.5v11l9-5.5z" />
                                <path class="camera-live-stop d-none" d="M3.5 3.5h9v9h-9z" />
                            </svg>
                        </button>

                        @* On the picture rather than in the controls row, which is where a video
                           player puts it. Hidden until the script binds it: without JavaScript it
                           would do nothing, and a control that cannot act explains nothing. *@
                        <button type="button" class="camera-overlay-btn camera-maximise btn btn-sm d-none" hidden
                                data-label-maximise="@Localiser["Cameras_Maximise"]"
                                data-label-restore="@Localiser["Cameras_Restore"]"
                                aria-label="@Localiser["Cameras_Maximise"]" title="@Localiser["Cameras_Maximise"]">
                            <svg class="camera-maximise-icon" width="18" height="18" viewBox="0 0 16 16"
                                 fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                                <path d="M6 2H2v4M10 2h4v4M6 14H2v-4M10 14h4v-4" />
                            </svg>
                        </button>
                    </div>
                    <figcaption class="d-flex justify-content-between small text-body-secondary mt-1">
                        <span>@Model.CameraName(camera, index)</span>
                        <span class="camera-age"></span>
                    </figcaption>

                    @* Hidden until the server says this camera may be offered - per camera, and asked
                       rather than rendered, because the answer can change while the page is open.
                       Nothing can report a camera's codec before something watches it (measured on
                       the board: the stream server names none for a stream nobody is consuming), so
                       the button is offered optimistically and taken away by the first refusal. A
                       camera that sends JPEG loses it after one press, saying why. *@
                    @* Only the note now. The button moved into the picture, beside maximise - see
                       the .camera-view block above. This stays outside because it is prose: a
                       failure reason, or why a JPEG camera just lost its button. *@
                    <div class="camera-live-controls d-none mt-1">
                        <span class="camera-live-note small text-body-secondary" role="status"></span>
                    </div>
                </figure>
            </div>
        }
    </div>
}

<h2 class="h5">@Localiser["Common_Queue"]</h2>

@* Refreshed like the status card, and for the same reason: the loop empties this list while
   somebody is looking at it. A queue frozen at load time beside a live status card is the exact
   confusion the rebuild set out to remove, and it was left here by omission.

   Slower than the card. The rows carry reorder and remove buttons, and markup replaced under a
   cursor is a mis-click - live-region.js also skips the swap when nothing changed, which is most
   polls. *@
<div data-live-region
     data-live-url="@Url.Page("Detail", "Queue", new { uuid })"
     data-live-interval="5000">
    <partial name="_PrintQueue" model="Model" />
</div>

@* Outside the queue's refreshed region, and it has to be. These are rendered from SlicerUrl and
   CanManage, which only the full page load resolves - inside the polled partial a queue refresh
   re-rendered them from a handler that sets neither, so the address blanked and the toggle vanished
   until the next reload. *@
@* Shown rather than tucked away (Henrik, 2026-08-20). These were behind a disclosure on the
   reasoning that setup is not state - true, but the slicer address is what somebody opens this page
   to copy the first several times they use it, and a control nobody can find is a control that is
   not there. *@

@* Only for someone who may change this printer's queue: a CanRead visitor given this URL would get
   an upload that succeeds and then a 403 from the queue, which is a worse answer than not offering
   it. *@
@if (Model.CanUse)
{
    <h2 class="h5">@Localiser["Printers_SlicerHeading"]</h2>

    @* PrusaSlicer's own menu labels stay English: they have to match what a person sees in the
       slicer, which this application neither authors nor translates. Only the sentence around them
       is ours.

       Three treatments, because they are three different kinds of thing: <em> for a menu path you
       navigate, <strong> for a setting and the value you give it, and <kbd><samp> for the button you
       press. All bold, a reader has to work out which one is the control.

       The nesting is the spec's, not decoration: a bare <kbd> is text you TYPE, while a <samp>
       inside one is input based on text the system showed you - the names of menus, menu items, and
       buttons on screen. MDN's own example for it is a button. *@
    <p>
        @Html.Raw(string.Format(
            System.Globalization.CultureInfo.CurrentCulture,
            Localiser["Printers_SlicerHelp"].Value,
            "<em>Printer Settings &rarr; Physical Printer</em>",
            "<strong>Host Type</strong>",
            "<strong>OctoPrint</strong>",
            $"<a href=\"{Url.Page("/Account/Manage/ApiTokens")}\">{Localiser["Printers_ApiTokenLink"].Value}</a>",
            "<kbd><samp>Upload and Print</samp></kbd>"))
    </p>

    <div class="input-group mb-3" data-copy>
        <input type="text" class="form-control font-monospace" readonly
               value="@Model.SlicerUrl" aria-label="@Localiser["Printers_SlicerAddressLabel"]"
               data-copy-source />
        <button type="button" class="btn btn-outline-secondary" data-copy-button>@Localiser["Common_Copy"]</button>
    </div>

    @* Announced politely rather than shouted, and empty until something happens, so a screen reader
       hears the outcome without the control describing itself twice. *@
    <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>
}

@* Everything below is a record rather than a state. Closed by default: it used to be seventy rows
   of table, and a page whose height is spent on history buries the thing somebody opened it for. *@
<details class="printer-archive">
    <summary>@Localiser["Printers_PrintHistory"]</summary>

    @if (Model.History.Count == 0)
    {
        <p>@Localiser["Printers_NothingFinished"]</p>
    }
    else
    {
        <table class="table table-sm w-auto">
            <thead>
                <tr>
                    <th scope="col">@Localiser["Common_File"]</th>
                    <th scope="col">@Localiser["Common_Started"]</th>

                    @* "Outcome", though the property is PrintState.State - and deliberately, not left
                       over from the rename. This table is filtered to EndedAt != null, and Close() sets
                       EndedAt and State together, so the only values reachable here are Finished,
                       Stopped, Failed and Unknown: all of them outcomes. "State" would be the worse
                       word, inviting "is it printing?" about a table where everything has ended.

                       Same reason Close(PrintJob, PrintState outcome, ...) keeps "outcome" for its
                       parameter. The type is named for the whole lifecycle because it spans it; this
                       column only ever sees the end of it. *@
                    <th scope="col">@Localiser["Common_Outcome"]</th>

                    @* Only when some row can actually offer something, so a table of other people's
                       prints does not carry an empty column of its own. *@
                    @if (Model.History.Any(Model.CanReprint))
                    {
                        <th scope="col"><span class="visually-hidden">@Localiser["Common_Actions"]</span></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var job in Model.History)
                {
                    <tr>
                        <td class="typed-name">@job.FileName</td>
                        <td>@job.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm",
                            System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td>
                            @job.State
                            @* A stop says who, because the printer cannot: it reports the same state
                               change whether somebody pressed stop here or on the panel. *@
                            @if (job.State == PrintState.Stopped)
                            {
                                <br />

                                <span class="text-muted">@Model.StoppedByDescription(job)</span>
                            }
                            @* Firmware's own words, and the only place a refused print explains itself.
                               Without this a queued print that never ran left nothing a person could read. *@
                            @if (job.Reason is { } reason)
                            {
                                <br />

                                <span class="text-muted">@reason</span>
                            }
                        </td>

                        @* Your own prints only, and the reason is that the file is found by name in
                           your own tree: on somebody else's row this would offer to print your
                           bracket.bgcode believing it was theirs. Offered on every outcome though -
                           a print that failed or was stopped is exactly the one to run again. *@
                        @if (Model.History.Any(Model.CanReprint))
                        {
                            <td class="text-nowrap">
                                @if (Model.CanReprint(job))
                                {
                                    <form method="post" asp-page-handler="Reprint" asp-route-uuid="@uuid">
                                        <input type="hidden" name="id" value="@job.TrackingId" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                aria-label="@Localiser["Printers_ReprintFile", job.FileName]">@Localiser["Printers_Reprint"]</button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</details>

<details class="printer-archive">
    <summary>@Localiser["Printers_RecentEvents"]</summary>

    @if (Model.Statistics.RecentEvents.Count == 0)
    {
        <p>@Localiser["Printers_NoEvents"]</p>
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>@Localiser["Common_Time"]</th>
                    <th>@Localiser["Common_Event"]</th>
                    <th>@Localiser["Common_Reason"]</th>
                    <th>@Localiser["Common_Job"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var printerEvent in Model.Statistics.RecentEvents)
            {
                <tr>
                    <td>@printerEvent.Timestamp</td>
                    <td>@printerEvent.EventType</td>
                    <td>@(printerEvent.Reason ?? "-")</td>
                    <td>@(printerEvent.JobId?.ToString() ?? "-")</td>
                </tr>
            }
            </tbody>
        </table>
    }
</details>


@* Last on the page, and a disclosure like the two archives above it - not because removing is a
   record, but because it is the one control here nobody should reach by accident. Closed by
   default, so even seeing the button takes a deliberate act.

   The disclosure holds the trigger and nothing else. Everything that makes this decision - what is
   destroyed, that the printer is not told, and the name that has to be typed - lives in the dialog,
   because a warning beside a button is read after the decision and a warning in front of one is
   read before it. Ellipsis on the trigger, the convention the unload picker already sets: this
   button opens a question rather than answering one.

   The dialog is inside this CanManage block rather than down with the others, deliberately. The
   unload picker's comment records what the alternative cost: a modal that sat beside an unrelated
   block inherited that block's condition, and its trigger pointed at markup that was simply absent. *@
@if (Model.CanManage)
{
    <details class="printer-archive">
        <summary>@Localiser["Printers_RemoveHeading"]</summary>

        <p class="my-2">
            <button type="button" class="btn btn-outline-danger"
                    data-bs-toggle="modal" data-bs-target="#remove-printer">
                @Localiser["Printers_RemoveEllipsis"]
            </button>
        </p>
    </details>

    <div class="modal fade" id="remove-printer" tabindex="-1" aria-labelledby="remove-printer-heading"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            @* The danger border the card here used to carry, kept when the warning moved into the
               dialog. It is the only thing marking this dialog apart from the two benign ones on the
               page - set-ready and the unload picker share its shape otherwise - so a person who
               opened the wrong one can see it before reading it. A Bootstrap utility rather than a
               colour of our own; the utility wins on !important over .modal-content's own border. *@
            <div class="modal-content border-danger">
                <div class="modal-header">
                    <h5 class="modal-title" id="remove-printer-heading">
                        @string.Format(System.Globalization.CultureInfo.CurrentCulture,
                                       Localiser["Printers_RemoveModalHeading"].Value,
                                       printerName)
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="@Localiser["Common_Cancel"]"></button>
                </div>

                @* The form spans body and footer so the typed name and the button that acts on it are
                   one submission. The name is checked on the server: a confirmation the server never
                   sees is a decoration, and this one costs a forged post the trouble of knowing which
                   printer it is removing. *@
                <form method="post" asp-page-handler="Remove" asp-route-uuid="@uuid">
                    <div class="modal-body">
                        <p>@Localiser["Printers_RemoveWarning"]</p>
                        <p class="text-body-secondary small">@Localiser["Printers_RemoveKnocking"]</p>

                        <label class="form-label" for="remove-confirmation">
                            @Localiser["Printers_RemoveConfirmLabel", printerName]
                        </label>
                        @* No autocomplete: the browser offering the name back would undo the point of
                           asking for it. *@
                        <input class="form-control" id="remove-confirmation" name="confirmation"
                               autocomplete="off" required />
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            @Localiser["Common_Cancel"]
                        </button>

                        <button type="submit" class="btn btn-danger">@Localiser["Printers_RemoveButton"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@* The dialog is gated on CanUse and on there being a choice - and on nothing else. It first
   went in beside the Set ready modal and inherited that block's RemoteReadyAllowed, so the
   trigger pointed at markup which was simply absent on any printer without the ready toggle:
   a button that did nothing, with no error anywhere. *@
@if (Model.CanUse && Model.UnloadNeedsPicker)
{
    @* A picker, not a confirmation - which is why it exists here and the single-tool button has no
       dialog at all. It is the thing that reaches tools that are not on the carriage: M702 carries an
       explicit T and firmware changes to that tool itself (M701_2.cpp:168-171), so "picked" is a cost
       here rather than a constraint.

       Rendered from the page load, not from the poll: the control strip sits outside the refreshed
       region on purpose, so these temperatures are as old as the page. That is the honest trade for
       not having the markup replaced under somebody mid-choice - see notes/printer-page.md §6e. *@
        <div class="modal fade" id="unload-tool" tabindex="-1" aria-labelledby="unload-tool-heading" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" asp-page-handler="Unload" asp-route-uuid="@uuid">
                        <div class="modal-header">
                            <h5 class="modal-title" id="unload-tool-heading">@Localiser["Printers_UnloadWhichTool"]</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="@Localiser["Common_Cancel"]"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-body-secondary small">@Localiser["Printers_UnloadPickerNote"]</p>

                            <div data-unload-tools
                                 data-unload-tools-url="@Url.Page("Detail", "Tools", new { uuid })">
                                <partial name="_UnloadTools" model="Model" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                                @Localiser["Common_Cancel"]
                            </button>
                            <button type="submit" class="btn btn-outline-primary">@Localiser["Printers_UnloadConfirm"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
}

@if (Model.CanUse && Model.Statistics.Printer.RemoteReadyAllowed)
{
    <div class="modal fade" id="set-ready" tabindex="-1" aria-labelledby="set-ready-heading" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="set-ready-heading">
                        @string.Format(System.Globalization.CultureInfo.CurrentCulture,
                                       Localiser["Printers_ReadyHeading"].Value,
                                       printerName)
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="@Localiser["Common_Cancel"]"></button>
                </div>

                <div class="modal-body">
                    @* The same polled frame the page uses, not a second snapshot path - camera.js
                       binds every [data-camera-frame] it finds. Seeing the sheet is what makes
                       answering the question honest rather than a guess. *@
                    @if (Model.Cameras.Count > 0)
                    {
                        <div class="camera-view ratio ratio-16x9 border rounded bg-body-tertiary overflow-hidden mb-3"
                             data-camera-frame="@Url.Action("Frame", "Camera", new { uuid = Model.Cameras[0].Uuid })">
                            <img class="camera-image w-100 h-100 object-fit-contain d-none" alt="" />
                            <div class="camera-status d-flex align-items-center justify-content-center text-body-secondary small">
                                @Localiser["Cameras_Capturing"]
                            </div>
                        </div>
                    }
                    else
                    {
                        @* Said out loud rather than left as an absent picture: without a feed this is
                           an assertion made blind, and the walk it replaces was annoying precisely
                           because it forced a look. *@
                        <p class="text-body-secondary">
                            @string.Format(System.Globalization.CultureInfo.CurrentCulture,
                                           Localiser["Printers_ReadyNoCamera"].Value,
                                           printerName)
                        </p>
                    }

                    <p class="fw-semibold mb-2">@Localiser["Printers_ReadyChecklist"]</p>

                    <p class="text-body-secondary mb-0">@Localiser["Printers_ReadyConsequence"]</p>
                </div>

                @* The confirm carries the assertion rather than agreement. A button saying "OK" can be
                   cleared while telling yourself you are dismissing a dialog; one saying what you are
                   claiming has to be read to be pressed. *@
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        @Localiser["Common_Cancel"]
                    </button>

                    <form method="post" asp-page-handler="Ready" asp-route-uuid="@uuid">
                        <button type="submit" class="btn btn-primary">@Localiser["Printers_ReadyConfirm"]</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/live-region.js" asp-append-version="true"></script>
    <script src="~/js/unload-tools.js" asp-append-version="true"></script>
    <script src="~/js/dismiss-alert.js" asp-append-version="true"></script>
    <script src="~/js/camera.js" asp-append-version="true"></script>
    <script src="~/js/camera-live.js" asp-append-version="true"></script>
    <script src="~/js/camera-maximise.js" asp-append-version="true"></script>
    <script src="~/js/toggle-submit.js" asp-append-version="true"></script>
}
