<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.1.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Drives the real ASP.NET Core pipeline (routing, the setup gate, [Authorize], cookie auth)
             through an in-memory TestServer rather than calling services directly - the one thing that
             distinguishes every test in this project from Homespool.Host.Test. -->
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
        <!-- Only used by LoginWith2faTests, to generate a valid RFC 6238 TOTP code for a seeded
             account's authenticator secret. UserManager.GenerateTwoFactorTokenAsync does not work
             for AuthenticatorTokenProvider - it's designed for validation only, since a real
             authenticator app (not this server) generates the code in production. A standard library
             is used deliberately rather than hand-rolling RFC 6238 in test code. -->
        <PackageReference Include="Otp.NET" Version="1.4.1" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Homespool.FakePrinter\Homespool.FakePrinter.csproj" />
      <ProjectReference Include="..\Homespool.Host\Homespool.Host.csproj" />

      <!-- The fake WebAuthn authenticator the unit tests drive the passkey scheme with, linked rather
           than copied so the two suites answer a ceremony the same way. -->
      <Compile Include="..\Homespool.Host.Test\FakeAuthenticator.cs" Link="FakeAuthenticator.cs" />

      <!-- The fake push service and the browser keys it delivers to, linked for the same reason: its
           decryption is checked against RFC 8291's example there, and both suites should read a
           notification with the checked copy. -->
      <Compile Include="..\Homespool.Host.Test\FakePushService.cs" Link="FakePushService.cs" />

      <!-- Firmware images signed with a key made for the run, linked so both suites build an image
           the same way - Prusa's own are never committed. -->
      <Compile Include="..\Homespool.Host.Test\TestFirmwareImages.cs" Link="TestFirmwareImages.cs" />
    </ItemGroup>

    <ItemGroup>
      <!-- The redacted capture lives in Homespool.Host.Test (see CaptureReplayTests there for the
           redaction story); linked rather than duplicated so there is exactly one copy to keep
           honest. FakePrinterIntegrationTests replays it against the full pipeline. -->
      <Content Include="..\Homespool.Host.Test\websocket.capture" Link="websocket.capture">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
