@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Register confirmation";
}

<h1>@ViewData["Title"]</h1>

@if (Model.EmailFailed)
{
    <div class="alert alert-warning" role="alert">
        Your account was created, but the confirmation email could not be sent.
        Contact your administrator - the account cannot be used until it is confirmed.
    </div>
}
else if (Model.SmtpConfigured)
{
    <p>Please check your email to confirm your account.</p>
}
else
{
    <p>
        Your account is ready to use. No confirmation is needed, because this server has no
        outgoing mail configured.
    </p>
    <p><a asp-page="./Login">Sign in</a></p>
}
