@page
@model IndexModel
@{
    ViewData["Title"] = Localiser["Printers_Title"].Value;
}

<h1>@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusSuccess ? "alert-success" : "alert-warning")" role="alert">@Model.StatusMessage</div>
}

@if (Model.Offer is not null)
{
    <partial name="_BundleDownload" model="Model.Offer" />
}

<p>
    <a class="btn btn-outline-primary" asp-page="Claim">@Localiser["Printers_Claim"]</a>
    <a class="btn btn-primary" asp-page="Add">@Localiser["Printers_Add"]</a>
</p>

@if (Model.Printers.Count == 0)
{
    <p>@Localiser["Printers_None"]</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@Localiser["Common_Name"]</th>
                <th>@Localiser["Printers_Location"]</th>
                <th>@Localiser["Common_Team"]</th>
                <th>@Localiser["Common_Status"]</th>
                <th></th>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var row in Model.Printers)
        {
            <tr>
                @* Shared with the front page's tiles, so the two cannot call one printer two things.
                   It also treats a whitespace name as unnamed, which the ?? chain here did not. *@
                <td class="typed-name">
                    <a asp-page="Detail" asp-route-uuid="@row.Printer.Uuid">@PrinterDisplayName.For(row.Printer)</a>
                    @* Filled and grey: this is a resting fact about the reader, not a severity, and a
                       rack where one row glows would compete with the status column beside it. *@
                    @if (row.Printer.Id == Model.DefaultPrinterId)
                    {
                        <span class="badge text-bg-secondary">@Localiser["Printers_Default"]</span>
                    }
                </td>
                <td class="typed-name">@row.Printer.Location</td>
                <td class="typed-name">@row.TeamName</td>
                @* What the printer is doing beats how it was set up, whenever we can know it. A
                   connected printer used to read "Enrolled", which is true, unchanging, and answers a
                   question nobody has once the thing is working. Enrolment still shows when it is the
                   most useful fact - which is when the printer is not there. *@
                <td>
                    @if (row.Connected)
                    {
                        <span class="badge @PrinterStatusBadge.For(row.LiveStatus)">@Model.StatusText(row.LiveStatus)</span>
                    }
                    else if (row.Enrolled)
                    {
                        @* Enrolled and absent. "Offline" is the actionable half; the reissue button
                           beside it already says the credential is in place. *@
                        <span class="badge @PrinterStatusBadge.Absent">@Localiser["PrinterStatus_Offline"]</span>
                    }
                    else if (row.AwaitingUsbProvisioning)
                    {
                        @* Filled, unlike its two neighbours, because this one is the only absence with
                           something for a person to do: put the key in the printer. *@
                        <span class="badge text-bg-warning">@Localiser["Printers_AwaitingUsb"]</span>
                    }
                    else
                    {
                        <span class="badge @PrinterStatusBadge.Absent">@Localiser["Printers_AwaitingAny"]</span>
                    }
                </td>
                <td>
                    @* Only on the rows that are not already it, so the listing's verb is always "make
                       it this one instead". Clearing the idea altogether lives on the printer's page,
                       which has room to say what having no default means. *@
                    @if (row.Printer.Id != Model.DefaultPrinterId)
                    {
                        <form method="post" asp-page-handler="Default" asp-route-printerId="@row.Printer.Id">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@Localiser["Printers_MakeDefault"]</button>
                        </form>
                    }
                </td>
                <td>
                    @* Offered for an enrolled printer too: reissuing here is the supported way to put a
                       fresh credential on one that is already connected, and the only safe one -
                       adding it again from scratch would create a second printer whose token the
                       server refuses to bind. *@
                    @if (row.AwaitingUsbProvisioning || row.Enrolled)
                    {
                        <form method="post" asp-page-handler="Regenerate" asp-route-printerId="@row.Printer.Id">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                @(row.Enrolled ? Localiser["Printers_ReissueToken"].Value : Localiser["Printers_RegenerateToken"].Value)
                            </button>
                        </form>
                    }
                </td>
                <td>
                    @* Sending is gated only on being connected right now, not on whether a print is
                       actually running/paused - the firmware's own Rejected reply (e.g. "No print to
                       pause") is the real guard, surfaced above via StatusMessage. *@
                    @if (row.Connected)
                    {
                        <form method="post" asp-page-handler="Pause" asp-route-printerId="@row.Printer.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@Localiser["Intent_PausePrint"]</button>
                        </form>
                        <form method="post" asp-page-handler="Resume" asp-route-printerId="@row.Printer.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">@Localiser["Intent_ResumePrint"]</button>
                        </form>
                        <form method="post" asp-page-handler="Stop" asp-route-printerId="@row.Printer.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">@Localiser["Intent_StopPrint"]</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
