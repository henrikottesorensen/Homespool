@page
@model LiveViewModel
@{
    ViewData["Title"] = Localiser["LiveView_Title"].Value;
}

<h1>@ViewData["Title"]</h1>

<p>@Localiser["LiveView_Intro"]</p>

@* Said before the switch rather than after it: whether live view works at all is the question
   somebody arriving here is most likely to have, and the STUN choice is meaningless underneath a
   deployment where nothing plays. *@
@if (Model.LiveViewAvailable)
{
    <p>
        <span class="badge text-bg-success">@Localiser["LiveView_Working"]</span>
        <span class="text-body-secondary">@Localiser["LiveView_UsingAddress", Model.Candidate]</span>
    </p>
}
else
{
    <div class="alert alert-warning" role="alert">
        @Localiser["LiveView_NoAddress"]
    </div>
}

<h2>@Localiser["LiveView_StunHeading"]</h2>

<p>
    @if (Model.StunEnabled)
    {
        <span class="badge text-bg-warning">@Localiser["LiveView_StunOn"]</span>
    }
    else
    {
        <span class="badge border border-secondary text-body-secondary">@Localiser["LiveView_StunOff"]</span>
    }
</p>

@* Saved and in force can differ for a moment after a save, or for longer when the stream server
   cannot be reached - and turning STUN off is a privacy choice, so the page must not claim it has
   taken effect before the stream server says so. Meaningless without an address: nothing is told
   to the stream server at all then, and the warning above already says why. *@
@if (Model.LiveViewAvailable && !Model.StunApplied)
{
    <div class="alert alert-warning" role="status">@Localiser["LiveView_StunNotYetApplied"]</div>
}

<p>@Localiser["LiveView_StunExplained"]</p>

<p class="text-body-secondary">@Localiser["LiveView_StunElsewhere"]</p>
