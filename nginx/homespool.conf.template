# The user-facing half of the deployment: pages and /api, over TLS, in front of Kestrel's plain-HTTP
# user listener. Mounted read-only from ./nginx, so editing it is editing a file in the repository -
# no rebuild, just `docker compose restart proxy`.
#
# A TEMPLATE, and named one since 2026-08-05. It is mounted to /etc/nginx/templates and rendered into
# conf.d at start by the base image's 20-envsubst-on-templates.sh, which substitutes
# ${HTTPS_PORT_SUFFIX} into the redirect below. That is not optional decoration: dropped straight into
# conf.d as it used to be, nginx starts perfectly happily and redirects every plain-HTTP visitor to a
# literal "https://$host${HTTPS_PORT_SUFFIX}/..." - a URL no browser can resolve, from a proxy that
# reports itself healthy. The extension is the warning.
#
# Only ${HTTPS_PORT_SUFFIX} is substituted; NGINX_ENVSUBST_FILTER in compose.yaml restricts it. Add a
# variable of your own here and you must add it there too, or it stays a literal - and conversely,
# widening that filter would blank every $host and $request_uri below.
#
# Printers use this proxy but not this file. They have their own port, server block and certificate
# in homespool-printer.conf, installed alongside this one when the deployment has a printer leaf to
# serve. The two stay separate all the way down, which is why /p/* does not exist on the listener
# this proxies to and is refused below as well.

# Used by both halves of the deployment, so it lives in the file that is always installed:
# homespool-printer.conf needs it for the printer's WebSocket and may not be present at all.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Which language the holding page is served in, for @starting at the bottom of this file. A map
# because it has to be decided at http level, not where it is used.
#
# The browser is the only thing that can be asked. The application stores a language on the account
# and that is what every other page follows - but this page exists precisely when the application is
# not answering, so the account, and the database it lives in, are exactly what is unavailable. A
# reader whose account is Danish and whose browser says English gets English here, once, for as long
# as the outage lasts.
#
# QUOTED, and that is not decoration: a `;` inside an unquoted map pattern ends the directive, and
# nginx reports "invalid number of the map parameters" pointing at the line rather than at the
# character.
#
# Matches the FIRST tag only, and ignores q-values, which nginx cannot parse. Browsers send their
# list in preference order, so this agrees with them; a hand-written `en;q=0.7,da;q=0.9` gets English
# where the application itself would give Danish. The word boundary is what keeps "dansk" - a
# language tag nobody sends, but a header nobody validates either - out of the Danish arm.
map $http_accept_language $hs_starting_language {
    default                                 en;
    "~*^[\s]*da([-_][A-Za-z]+)?([,;]|$)"    da;
}

# Kept separate from the language so the file name is the only thing that knows about file names.
# English is the neutral file and takes no suffix, the same shape SharedResource.resx uses.
map $hs_starting_language $hs_starting_suffix {
    default  "";
    da       ".da";
}

# Anything whose Host this deployment does not recognise is refused here, before it can reach a
# server block that would answer it. Two of these, because a default server is per-listener.
#
# WHY: the application builds absolute URLs from Request.Host - a password-reset link most of all -
# so whoever chose the Host chose where the emailed token pointed. server_name used to be `_`, which
# matches nothing and therefore made the first block the default for everything.
#
# 444 closes the connection without a response, which is right for a forged Host and unhelpful for an
# owner who simply browsed to the machine's IP address: they get an empty reply and no reason. If
# that trade reads wrong for your deployment, `return 421;` instead - it costs an attacker nothing
# they did not already know and tells the owner what happened.
#
# So USER_HOST is no longer cosmetic. A name that reaches this deployment and is not in it - a second
# DNS name, the bare IP - is refused. AllowedHosts in compose.yaml carries the same list for the
# application, since a proxy is not the only way in.
server {
    listen 8080 default_server;
    return 444;
}

server {
    listen 8443 ssl default_server;

    # A TLS default server still has to complete a handshake before it can see the Host, so it needs
    # the certificate the real block presents.
    ssl_certificate     /etc/nginx/certs/homespool.crt;
    ssl_certificate_key /etc/nginx/certs/homespool.key;

    return 444;
}

server {
    listen 8080;
    server_name ${USER_HOST} localhost;

    # Not redirected, and this is the same reasoning Program.cs applies to its own redirection: a
    # monitoring probe follows nothing, and `curl --fail` treats a 301 as success - so a redirected
    # /health would report a healthy service that was never actually reached.
    location /health {
        include /etc/nginx/homespool-health-access.conf;

        set $homespool_upstream http://homespool:8080;
        include /etc/nginx/homespool-proxy.conf;

        # A 512 MB upload over a household's wifi takes longer than the 60s default allows. Set here
        # as well as on the TLS block because the include no longer carries timeouts - see its header.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Everything else goes to TLS. $host carries no port, so this needs telling which one HTTPS is
    # published on - ${HTTPS_PORT_SUFFIX} is substituted at container start from HTTPS_PORT, and is
    # empty for the standard 443 so ordinary deployments get a clean URL. It used to assume 443 with
    # a comment telling you to edit this line; the first person to publish HTTPS elsewhere read that
    # comment only after being redirected into a closed port.
    #
    # This file is a TEMPLATE - envsubst renders it into conf.d at start. Only the variables named in
    # NGINX_ENVSUBST_FILTER are touched, which is what keeps $host and $request_uri below from being
    # blanked: unfiltered envsubst would replace every one of them with nothing and the failure would
    # look like nginx misbehaving rather than like a substitution.
    #
    # 308, not 301: a 301 permits the client to replay the request as a GET, and enough of them do
    # that it is the documented behaviour rather than a bug. A form POST that arrives over http -
    # a bookmarked link, a typed address, a client that has not learned the redirect yet - then
    # reaches the application as a GET with its body dropped, which looks like the request silently
    # doing nothing rather than like a redirect problem. 308 preserves the method and the body.
    location / {
        return 308 https://$host${HTTPS_PORT_SUFFIX}$request_uri;
    }
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${USER_HOST} localhost;

    # Generated on first start by /docker-entrypoint.d/25-self-signed-certificate.sh unless the
    # volume already holds a certificate. Replace both files to use your own.
    #
    # Nothing to do with the printer leaf, which is minted by the application from its own authority
    # and served by homespool-printer.conf on another port. Serving that one to a browser would be a
    # certificate signed by an authority no browser has any reason to trust; serving this one to a
    # printer would be RSA, which the firmware's single ciphersuite cannot use at all. Two
    # certificates, two ports, no overlap.
    ssl_certificate     /etc/nginx/certs/homespool.crt;
    ssl_certificate_key /etc/nginx/certs/homespool.key;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # HSTS - uncomment once you serve a certificate browsers already trust. Not on by default,
    # because with the self-signed certificate above it would pin browsers to a certificate the
    # operator is expected to replace, and the lock-out lasts as long as the max-age says.
    # add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    # Matches FileStorageOptions.MaxUploadBytes. nginx defaults this to 1m, which would reject every
    # gcode upload with a 413 that never reaches the application - so the limit would be enforced in
    # two places, one of them invisible and wrong.
    client_max_body_size 512m;

    # Stream uploads through instead of spooling half a gigabyte to the proxy's disk before the
    # application sees a byte of it.
    proxy_request_buffering off;

    # The printer protocol, refused explicitly. It is already absent from the listener behind this
    # proxy - Kestrel serves /p/* on the printer listener alone - so this changes no outcome. It
    # exists to state the boundary where someone reading the proxy configuration will look for it,
    # and it is the reason the printer block is a separate listener rather than a location here.
    location /p/ {
        return 404;
    }

    # Its own location, because otherwise /health falls into `location /` below and the address
    # filter never runs on the TLS listener - which is the one published to the world.
    location /health {
        include /etc/nginx/homespool-health-access.conf;

        set $homespool_upstream http://homespool:8080;
        include /etc/nginx/homespool-proxy.conf;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # The live MJPEG stream, which exists as its own location for one reason: it is allowed to run
    # for as long as somebody watches, and nothing else here should be.
    #
    # Unbuffering is what stops a closed browser tab holding a camera open for ever, and it now
    # comes from homespool-proxy.conf, which turns buffering off for every path - see the reasoning
    # there, which this stream is the worked example of. The application also sends
    # X-Accel-Buffering: no on the response, kept as belt and braces for a deployment whose proxy
    # configuration lags the application's.
    #
    # Scoped to the stream alone, not to /api/v1/cameras/: the 1h timeout is right for a view
    # somebody is watching and wrong for everything else - a hung frame request should die at the
    # ordinary timeout, not dangle for an hour.
    location ~ ^/api/v1/cameras/[0-9a-fA-F-]+/stream\.mjpeg$ {
        set $homespool_upstream http://homespool:8080;
        include /etc/nginx/homespool-proxy.conf;

        # A live view is watched for as long as somebody is interested, so there is no meaningful
        # ceiling here - only the viewer's disconnect, which the unbuffering lets arrive.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location / {
        set $homespool_upstream http://homespool:8080;
        include /etc/nginx/homespool-proxy.conf;

        # A 512 MB upload over a household's wifi takes longer than the 60s default allows.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        # A page instead of a refused connection while the application is still coming up. This
        # proxy no longer waits for the application to be healthy before starting - see
        # compose.yaml - so the window between the two is now visible to a browser rather than
        # being a closed port, and a closed port is what made a first boot look like a failure.
        #
        # Deliberately NOT proxy_intercept_errors: without it, error_page only catches the errors
        # *nginx* produces - upstream unreachable or timed out - and a 500 the application itself
        # returns passes through untouched. Turning it on would replace real application errors
        # with a soothing "still starting", which is the version of this feature that hides bugs.
        #
        # =503 rather than letting the 502 stand: 503 is the honest code for "not ready yet", it is
        # what a monitor should see, and it stops a search engine or a cache treating the holding
        # page as the site.
        error_page 502 504 =503 @starting;
    }

    # Served from the image, not from the mounted configuration directory - see the proxy Dockerfile.
    location @starting {
        root /usr/share/nginx/html;

        # Falls back to the English page rather than to =503, which is what lets the configuration
        # and the image be out of step: this file is bind-mounted and changes on a restart, the
        # pages are baked into the proxy image and change only on a rebuild. A proxy still running
        # an older image simply serves English. Note the header below then says `da` about an
        # English page - a lie confined to that window, and better than the alternative, which is
        # no page at all.
        try_files /homespool-starting$hs_starting_suffix.html /homespool-starting.html =503;

        add_header Content-Language $hs_starting_language always;
        add_header Vary Accept-Language always;

        # Said in the header as well as in the page's own <meta charset>. The meta tag is what a
        # browser honours when the header is silent, and it is inside the first 1024 bytes where the
        # standard requires it - but Danish is the first non-ASCII this page has ever carried, and a
        # holding page rendering its own apology as mojibake is a bad first impression of a
        # deployment that is merely slow.
        charset utf-8;

        # The page refreshes itself, but say so in the headers too, for anything that is not a
        # browser. no-store because the next request may well succeed, and a cached holding page
        # outliving the outage is worse than no page at all.
        add_header Retry-After 5 always;
        add_header Cache-Control "no-store" always;
    }
}
