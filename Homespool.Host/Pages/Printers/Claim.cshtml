@page
@model ClaimModel
@{
    ViewData["Title"] = Localiser["Printers_Claim"].Value;
}

<h1>@ViewData["Title"]</h1>

<p>
    @Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["Printers_ClaimSteps"].Value, "<em>Settings &rarr; Network &rarr; Prusa Connect &rarr; Add Printer to Connect</em>"))
</p>

@* The printer's registration dialog is hardcoded to Prusa's production instance - the QR URL and the
   "visit prusa.io/add" line are both compile-time literals no configuration reaches, unchanged across
   every published firmware release - the QR is not a gate. So this
   warning is permanent, not a workaround for something Prusa might fix. *@
<div class="alert alert-warning" role="alert">
    <strong>@Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["Printers_IgnoreQr"].Value, "<em>prusa.io/add</em>"))</strong>
    @Localiser["Printers_ClaimQrWarning"]
    <hr />
    @Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["Printers_ClaimWrongServer"].Value, "<code>prusa_printer_settings.ini</code>", $"<em>{Localiser["Printers_ClaimThem"].Value}</em>"))
</div>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            @* Name and Location lead, in that order, because Add.cshtml's form opens with the same
               two - the two enrolment pages differ only in how the printer is identified, so the
               fields they share read the same way on both. The code follows as this page's own
               field rather than opening it. *@
            <div class="form-floating mb-3">
                <input asp-for="Input.Name" class="form-control" placeholder="@Localiser["Printers_NamePlaceholder"]" />
                <label asp-for="Input.Name" class="form-label"></label>
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Location" class="form-control" placeholder="@Localiser["Common_LocationPlaceholder"]" />
                <label asp-for="Input.Location" class="form-label"></label>
                <span asp-validation-for="Input.Location" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                @* 10 characters, per CodeGenerator.CodeLength. The placeholder must be drawn from
                   Crockford's own alphabet (no I, L, O or U) - the previous one was 24 base36
                   characters containing "4O3OO5", i.e. it demonstrated the exact O-for-0 misread
                   that cost a real enrolment on 2026-07-28. Autocapitalize/autocorrect are off
                   because a phone keyboard will otherwise "helpfully" rewrite a code. *@
                <input asp-for="Input.Code" class="form-control" placeholder="MUF4RZJF5R" autocomplete="off"
                       autocapitalize="characters" autocorrect="off" spellcheck="false" />
                <label asp-for="Input.Code" class="form-label"></label>
                <span asp-validation-for="Input.Code" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.TeamId" class="form-label"></label>
                <select asp-for="Input.TeamId" asp-items="@Model.TeamOptions" class="form-select"></select>
                <span asp-validation-for="Input.TeamId" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">@Localiser["Printers_ClaimHeading"]</button>
            <a class="btn btn-link" asp-page="Index">@Localiser["Printers_BackToList"]</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
