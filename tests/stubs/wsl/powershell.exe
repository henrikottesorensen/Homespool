#!/bin/sh
# Recorded from Get-NetIPAddress on a Windows host with WSL and Hyper-V. Tab-separated address and
# InterfaceAlias, with Windows' own CRLF endings - all three are the point of the fixture.
printf '192.168.13.50\tEthernet\r\n172.28.112.1\tvEthernet (WSL)\r\n172.17.240.1\tvEthernet (Default Switch)\r\n127.0.0.1\tLoopback Pseudo-Interface 1\r\n'
