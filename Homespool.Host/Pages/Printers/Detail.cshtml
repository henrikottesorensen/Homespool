@page "{uuid:guid}"
@using Homespool.Host.PrusaConnect
@model DetailModel
@{
    ViewData["Title"] = Model.Statistics.Printer.Name ?? Model.Statistics.Printer.Model ?? Model.Statistics.Printer.Uuid.ToString();
}

<h1>@ViewData["Title"]</h1>

<p>
    Team: @(Model.Statistics.Printer.Team?.Name ?? $"Team #{Model.Statistics.Printer.TeamId}")
    &nbsp;
    @if (Model.Connected)
    {
        <span class="badge text-bg-success">Connected</span>
    }
    else
    {
        <span class="badge border border-secondary text-body-secondary">Not connected</span>
    }
</p>

<p>@if (Model.Cameras.Count > 0)
{
    @* One figure per camera. The picture is deliberately the largest thing on the page: this is what
       somebody looks at to decide whether a bed is clear, and a status line saying "camera fine" is
       not the same claim. *@
    <div class="row g-3 mb-3">
        @for (int index = 0; index < Model.Cameras.Count; index++)
        {
            var camera = Model.Cameras[index];
            <div class="col-md-6">
                <figure class="mb-0">
                    @* ratio-16x9 reserves the space before anything loads, so the panel is a box from
                       the first paint rather than collapsing to nothing and shoving the page down when
                       a frame arrives. The border makes that reserved space legible as "a picture goes
                       here" rather than as an empty gap. Both cameras here are 16:9; a camera that is
                       not will letterbox rather than distort, which object-fit-contain is for. *@
                    <div class="camera-view ratio ratio-16x9 border rounded bg-body-tertiary overflow-hidden"
                         data-camera-frame="@Url.Action("Frame", "Camera", new { uuid = camera.Uuid })">
                        @* Empty until a frame arrives. An img with no src draws nothing, which is
                           what "no picture yet" should look like - not a broken-image icon. *@
                        <img class="camera-image w-100 h-100 object-fit-contain d-none" alt="" />
                        <div class="camera-status d-flex align-items-center justify-content-center text-body-secondary small">
                            Capturing…
                        </div>
                    </div>
                    <figcaption class="d-flex justify-content-between small text-body-secondary mt-1">
                        <span>@(camera.Name ?? $"Camera {index + 1}")</span>
                        <span class="camera-age"></span>
                    </figcaption>
                </figure>
            </div>
        }
    </div>
}

<a asp-page="Index">&larr; Back to printers</a></p>

@if (Model.StatusMessage is not null)
{
    <div class="alert @(Model.StatusSuccess ? "alert-success" : "alert-danger")" role="alert">@Model.StatusMessage</div>
}

<h2>Current status</h2>

@{
    var liveState = Model.Statistics.LiveState;
}
@if (liveState is null)
{
    <p>No telemetry yet.</p>
}
else
{
    <table class="table table-sm w-auto">
        <tbody>
            <tr><th>Status</th><td>@liveState.Status</td></tr>
            <tr><th>Progress</th><td>@(liveState.Progress is { } progress ? $"{progress}%" : "-")</td></tr>
            <tr><th>Time printing</th><td>@(liveState.TimePrinting is { } tp ? TimeSpan.FromSeconds(tp).ToString("g") : "-")</td></tr>
            <tr><th>Time remaining</th><td>@(liveState.TimeRemaining is { } tr ? TimeSpan.FromSeconds(tr).ToString("g") : "-")</td></tr>
            @* Only rendered when the printer actually reports it: the firmware emits filament_change_in
               only while a pause is scheduled (render.cpp:164, gated on time_to_pause), so on a print
               with no M600 the field is absent rather than zero. A "-" row would imply "no swap due" on
               every ordinary print, which is noise. *@
            @if (liveState.TimeToFilamentChange is { } untilChange)
            {
                <tr><th>Filament change in</th><td>@TimeSpan.FromSeconds(untilChange).ToString("g")</td></tr>
            }
            <tr><th>Nozzle temperature</th><td>@(liveState.NozzleTemperature?.ToString("0.0") ?? "-")&deg; / target @(liveState.TargetNozzleTemperature?.ToString("0.0") ?? "-")&deg;</td></tr>
            <tr><th>Bed temperature</th><td>@(liveState.BedTemperature?.ToString("0.0") ?? "-")&deg; / target @(liveState.TargetBedTemperature?.ToString("0.0") ?? "-")&deg;</td></tr>
            <tr><th>Material</th><td>@(liveState.Material ?? "-")</td></tr>
            <tr><th>Speed</th><td>@(liveState.Speed is { } speed ? $"{speed}%" : "-")</td></tr>
            <tr><th>Flow</th><td>@(liveState.Flow is { } flow ? $"{flow}%" : "-")</td></tr>
            <tr><th>Last seen</th><td>@liveState.LastSeenAt</td></tr>
        </tbody>
    </table>
}

@if (Model.ActivePrint is { } active)
{
    <h2>Printing now</h2>
    <p>
        <strong>@active.FileName</strong>
        @* Starting is not yet printing - the printer has accepted the command and is heating. Saying
           "printing" through that window would be a small lie the page tells every single time. *@
        @if (active.State == Homespool.Model.PrintState.Starting)
        {
            <span class="badge text-bg-secondary">starting</span>
        }
        <br />
        <span class="text-muted">
            started @active.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm",
                System.Globalization.CultureInfo.InvariantCulture)
        </span>
    </p>
}

@* The queue holds behind a file it cannot send, like a spooler - so the reason has to be here, or a
   held queue is indistinguishable from one that stopped for no reason. *@
@if (Model.HoldReason is { } hold)
{
    <div class="alert alert-warning" role="alert">
        <strong>The queue is held.</strong> @hold
        <br />
        Free some space on the printer and it will carry on by itself.
    </div>
}

<h2>Queue</h2>

@* Not a stall to worry about - it is the loop explaining itself. Absent when another part of this
   page already says it, which is why there is no message while a print is starting. *@
@if (Model.WaitingOn is { } waiting)
{
    <p class="text-muted">@waiting</p>
}

@* Reordering and cancelling are edits to a list - nothing here reaches the printer. The producer
   loop is what turns the head of this queue into a transfer and a print, and it advances only when
   the printer is Ready, which only a person sets. *@
@if (Model.Queue.Count == 0)
{
    <p>Nothing queued. Send a file to this printer's queue from <a asp-page="/Files/Index">Files</a>.</p>
}
else
{
    <table class="table table-sm w-auto align-middle">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">File</th>
                <th scope="col" class="text-end">Size</th>
                <th scope="col">Queued</th>
                @if (Model.CanUse)
                {
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                }
            </tr>
        </thead>
        <tbody>
            @for (int index = 0; index < Model.Queue.Count; index++)
            {
                var job = Model.Queue[index];

                <tr>
                    @* The row's place in the list, not its stored Position - cancelling leaves gaps in
                       those, deliberately, and a gap shown to a person reads as a bug. *@
                    <td>@(index + 1)</td>
                    <td>@(job.PrintFile?.Name ?? "(missing)")</td>
                    <td class="text-end">@($"{(job.PrintFile?.Size ?? 0) / 1024.0:N0} KiB")</td>

                    @* Fixed format rather than a culture-dependent one, matching the Files table -
                       and ToLocalTime, without which this column rendered UTC while the print history
                       below it rendered local, two hours apart on the same page. *@
                    <td>@job.QueuedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>

                    @if (Model.CanUse)
                    {
                        <td class="text-nowrap">
                            <form method="post" asp-page-handler="Move" asp-route-uuid="@Model.Statistics.Printer.Uuid"
                                  class="d-inline">
                                <input type="hidden" name="id" value="@job.TrackingId" />
                                <input type="hidden" name="position" value="@(index - 1)" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary"
                                        title="Move up" aria-label="Move @(job.PrintFile?.Name) up"
                                        @(index == 0 ? "disabled" : string.Empty)>&uarr;</button>
                            </form>
                            <form method="post" asp-page-handler="Move" asp-route-uuid="@Model.Statistics.Printer.Uuid"
                                  class="d-inline">
                                <input type="hidden" name="id" value="@job.TrackingId" />
                                <input type="hidden" name="position" value="@(index + 1)" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary"
                                        title="Move down" aria-label="Move @(job.PrintFile?.Name) down"
                                        @(index == Model.Queue.Count - 1 ? "disabled" : string.Empty)>&darr;</button>
                            </form>
                            <form method="post" asp-page-handler="Cancel" asp-route-uuid="@Model.Statistics.Printer.Uuid"
                                  class="d-inline">
                                <input type="hidden" name="id" value="@job.TrackingId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        aria-label="Remove @(job.PrintFile?.Name) from the queue">Remove</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@* Only for someone who may change this printer's queue: a CanRead visitor given this URL would get
   an upload that succeeds and then a 403 from the queue, which is a worse answer than not offering
   it. *@
@if (Model.CanUse)
{
    <h2>Send from a slicer</h2>

    <p>
        PrusaSlicer can send straight to this printer. Under
        <em>Printer Settings &rarr; Physical Printer</em>, set <strong>Host Type</strong> to
        <strong>OctoPrint</strong>, paste this as the hostname, and use a
        <a asp-page="/Account/Manage/ApiTokens">personal access token</a> as the API key.
        <strong>Upload and Print</strong> adds the file to the queue above rather than starting it.
    </p>

    <div class="input-group mb-3" data-copy>
        <input type="text" class="form-control font-monospace" readonly
               value="@Model.SlicerUrl" aria-label="Print host address for this printer"
               data-copy-source />
        <button type="button" class="btn btn-outline-secondary" data-copy-button>Copy</button>
    </div>

    @* Announced politely rather than shouted, and empty until something happens, so a screen reader
       hears the outcome without the control describing itself twice. *@
    <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>
}

@* Heaters, and only ever both together. The service can set either alone and nothing here can:
   a page that could leave one heater on and the other off would be a way to make a mistake
   quietly. Hidden entirely without CanUse, like every other control on this page. *@
@if (Model.CanUse)
{
    <h2>Temperature</h2>

    <p class="text-body-secondary">
        Heats the nozzle and bed together, to the same targets the printer's own preheat menu uses.
    </p>

    @* Cooling is refused mid-print too, which reads as arbitrary unless it is said: the button
       looks like a safety control and is not one. Said on the page rather than only in the refusal,
       so nobody has to press it to find out. *@
    <p class="text-body-secondary">
        Both are refused while the printer is busy, <strong>cooling included</strong>: changing a
        heater mid-print ruins the print without ending it, and the printer will not refuse it on
        your behalf. To stop a print, use the controls on the
        <a asp-page="Index">printers list</a>.
    </p>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <form method="post" asp-page-handler="Preheat" asp-route-uuid="@Model.Statistics.Printer.Uuid"
              class="d-flex align-items-center gap-2">
            <label class="form-label mb-0" for="filament">Preheat for</label>

            <select class="form-select w-auto" id="filament" name="filament">
                @foreach (FilamentPreset preset in Model.Presets)
                {
                    <option value="@preset.Name">
                        @preset.Name &mdash; @preset.NozzleTemperature&deg;C / @preset.BedTemperature&deg;C
                    </option>
                }
            </select>

            <button type="submit" class="btn btn-outline-primary">Preheat</button>
        </form>

        <form method="post" asp-page-handler="Cooldown" asp-route-uuid="@Model.Statistics.Printer.Uuid">
            <button type="submit" class="btn btn-outline-secondary">Cool down</button>
        </form>
    </div>
}

<h2>Print history</h2>

@if (Model.History.Count == 0)
{
    <p>Nothing has finished printing yet.</p>
}
else
{
    <table class="table table-sm w-auto">
        <thead>
            <tr>
                <th scope="col">File</th>
                <th scope="col">Started</th>

                @* "Outcome", though the property is PrintState.State - and deliberately, not left
                   over from the rename. This table is filtered to EndedAt != null, and Close() sets
                   EndedAt and State together, so the only values reachable here are Finished,
                   Stopped, Failed and Unknown: all of them outcomes. "State" would be the worse
                   word, inviting "is it printing?" about a table where everything has ended.

                   Same reason Close(PrintJob, PrintState outcome, ...) keeps "outcome" for its
                   parameter. The type is named for the whole lifecycle because it spans it; this
                   column only ever sees the end of it. *@
                <th scope="col">Outcome</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Model.History)
            {
                <tr>
                    <td>@job.FileName</td>
                    <td>@job.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm",
                        System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>
                        @job.State
                        @* A stop says who, because the printer cannot: it reports the same state
                           change whether somebody pressed stop here or on the panel. *@
                        @if (job.State == Homespool.Model.PrintState.Stopped)
                        {
                            <br />

                            <span class="text-muted">@Model.StoppedByDescription(job)</span>
                        }
                        @* Firmware's own words, and the only place a refused print explains itself.
                           Without this a queued print that never ran left nothing a person could read. *@
                        @if (job.Reason is { } reason)
                        {
                            <br />

                            <span class="text-muted">@reason</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Recent telemetry</h2>

@if (Model.Statistics.RecentSamples.Count == 0)
{
    <p>No telemetry history yet.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Time</th>
                <th>Status</th>
                <th>Progress</th>
                <th>Nozzle</th>
                <th>Bed</th>
                <th>Speed</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var sample in Model.Statistics.RecentSamples)
        {
            <tr>
                <td>@sample.Timestamp</td>
                <td>@sample.Status</td>
                <td>@(sample.Progress is { } progress ? $"{progress}%" : "-")</td>
                <td>@(sample.NozzleTemperature?.ToString("0.0") ?? "-")</td>
                <td>@(sample.BedTemperature?.ToString("0.0") ?? "-")</td>
                <td>@(sample.Speed is { } speed ? $"{speed}%" : "-")</td>
            </tr>
        }
        </tbody>
    </table>
}

<h2>Recent events</h2>

@if (Model.Statistics.RecentEvents.Count == 0)
{
    <p>No events yet.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Time</th>
                <th>Event</th>
                <th>Reason</th>
                <th>Job</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var printerEvent in Model.Statistics.RecentEvents)
        {
            <tr>
                <td>@printerEvent.Timestamp</td>
                <td>@printerEvent.EventType</td>
                <td>@(printerEvent.Reason ?? "-")</td>
                <td>@(printerEvent.JobId?.ToString() ?? "-")</td>
            </tr>
        }
        </tbody>
    </table>
}

@section Scripts {
    <script src="~/js/camera.js" asp-append-version="true"></script>
}
