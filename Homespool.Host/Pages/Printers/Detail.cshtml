@page "{uuid:guid}"
@using Homespool.Host.PrusaConnect
@model DetailModel
@{
    ViewData["Title"] = Model.Statistics.Printer.Name ?? Model.Statistics.Printer.Model ?? Model.Statistics.Printer.Uuid.ToString();
}

<h1 class="typed-name">@ViewData["Title"]</h1>

<p>
    @Localiser["Printers_TeamLabel"] <span class="typed-name">@(Model.Statistics.Printer.Team?.Name
                                       ?? Localiser["Common_TeamNumbered", Model.Statistics.Printer.TeamId].Value)</span>
    &nbsp;
    @if (Model.Connected)
    {
        <span class="badge text-bg-success">@Localiser["PrinterStatus_Connected"]</span>
    }
    else
    {
        <span class="badge border border-secondary text-body-secondary">@Localiser["Printers_NotConnected"]</span>
    }
</p>

<p>@if (Model.Cameras.Count > 0)
{
    @* One figure per camera. The picture is deliberately the largest thing on the page: this is what
       somebody looks at to decide whether a bed is clear, and a status line saying "camera fine" is
       not the same claim. *@
    <div class="row g-3 mb-3">
        @for (int index = 0; index < Model.Cameras.Count; index++)
        {
            var camera = Model.Cameras[index];
            <div class="col-md-6">
                <figure class="mb-0">
                    @* ratio-16x9 reserves the space before anything loads, so the panel is a box from
                       the first paint rather than collapsing to nothing and shoving the page down when
                       a frame arrives. The border makes that reserved space legible as "a picture goes
                       here" rather than as an empty gap. Both cameras here are 16:9; a camera that is
                       not will letterbox rather than distort, which object-fit-contain is for. *@
                    <div class="camera-view ratio ratio-16x9 border rounded bg-body-tertiary overflow-hidden"
                         data-camera-frame="@Url.Action("Frame", "Camera", new { uuid = camera.Uuid })">
                        @* Empty until a frame arrives. An img with no src draws nothing, which is
                           what "no picture yet" should look like - not a broken-image icon. *@
                        <img class="camera-image w-100 h-100 object-fit-contain d-none" alt="" />
                        <div class="camera-status d-flex align-items-center justify-content-center text-body-secondary small">
                            @Localiser["Cameras_Capturing"]
                        </div>
                    </div>
                    <figcaption class="d-flex justify-content-between small text-body-secondary mt-1">
                        <span>@Model.CameraName(camera, index)</span>
                        <span class="camera-age"></span>
                    </figcaption>
                </figure>
            </div>
        }
    </div>
}

<a asp-page="Index">@Localiser["Printers_BackToList"]</a></p>

@if (Model.StatusMessage is not null)
{
    <div class="alert @(Model.StatusSuccess ? "alert-success" : "alert-danger")" role="alert">@Model.StatusMessage</div>
}

<h2>@Localiser["Printers_CurrentStatus"]</h2>

@{
    var liveState = Model.Statistics.LiveState;
}
@if (liveState is null)
{
    <p>@Localiser["Printers_NoTelemetry"]</p>
}
else
{
    <table class="table table-sm w-auto">
        <tbody>
            <tr><th>@Localiser["Common_Status"]</th><td>@liveState.Status</td></tr>
            <tr><th>@Localiser["Printers_Progress"]</th><td>@(liveState.Progress is { } progress ? $"{progress}%" : "-")</td></tr>
            <tr><th>@Localiser["Printers_TimePrinting"]</th><td>@(liveState.TimePrinting is { } tp ? TimeSpan.FromSeconds(tp).ToString("g") : "-")</td></tr>
            <tr><th>@Localiser["Printers_TimeRemaining"]</th><td>@(liveState.TimeRemaining is { } tr ? TimeSpan.FromSeconds(tr).ToString("g") : "-")</td></tr>
            @* Only rendered when the printer actually reports it: the firmware emits filament_change_in
               only while a pause is scheduled (render.cpp:164, gated on time_to_pause), so on a print
               with no M600 the field is absent rather than zero. A "-" row would imply "no swap due" on
               every ordinary print, which is noise. *@
            @if (liveState.TimeToFilamentChange is { } untilChange)
            {
                <tr><th>@Localiser["Printers_FilamentChangeIn"]</th><td>@TimeSpan.FromSeconds(untilChange).ToString("g")</td></tr>
            }
            <tr><th>@Localiser["Printers_NozzleTemp"]</th><td>@Localiser["Printers_TemperatureTarget", liveState.NozzleTemperature?.ToString("0.0") ?? "-", liveState.TargetNozzleTemperature?.ToString("0.0") ?? "-"]</td></tr>
            <tr><th>@Localiser["Printers_BedTemp"]</th><td>@Localiser["Printers_TemperatureTarget", liveState.BedTemperature?.ToString("0.0") ?? "-", liveState.TargetBedTemperature?.ToString("0.0") ?? "-"]</td></tr>
            <tr><th>@Localiser["Printers_Material"]</th><td>@(liveState.Material ?? "-")</td></tr>
            <tr><th>@Localiser["Printers_Speed"]</th><td>@(liveState.Speed is { } speed ? $"{speed}%" : "-")</td></tr>
            <tr><th>@Localiser["Printers_Flow"]</th><td>@(liveState.Flow is { } flow ? $"{flow}%" : "-")</td></tr>
            <tr><th>@Localiser["Printers_LastSeen"]</th><td>@liveState.LastSeenAt</td></tr>
        </tbody>
    </table>
}

@if (Model.ActivePrint is { } active)
{
    <h2>@Localiser["Printers_PrintingNow"]</h2>
    <p>
        <strong class="typed-name">@active.FileName</strong>
        @* Starting is not yet printing - the printer has accepted the command and is heating. Saying
           "printing" through that window would be a small lie the page tells every single time. *@
        @if (active.State == Homespool.Model.PrintState.Starting)
        {
            <span class="badge text-bg-secondary">@Localiser["Printers_Starting"]</span>
        }
        <br />
        <span class="text-muted">
            started @active.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm",
                System.Globalization.CultureInfo.InvariantCulture)
        </span>
    </p>
}

@* The queue holds behind a file it cannot send, like a spooler - so the reason has to be here, or a
   held queue is indistinguishable from one that stopped for no reason. *@
@if (Model.HoldReason is { } hold)
{
    <div class="alert alert-warning" role="alert">
        <strong>@Localiser["Printers_QueueHeld"]</strong> @hold
        <br />
        @Localiser["Printers_FreeSomeSpace"]
    </div>
}

<h2>@Localiser["Common_Queue"]</h2>

@* Not a stall to worry about - it is the loop explaining itself. Absent when another part of this
   page already says it, which is why there is no message while a print is starting. *@
@if (Model.WaitingOn is { } waiting)
{
    <p class="text-muted">@waiting</p>
}

@* Reordering and cancelling are edits to a list - nothing here reaches the printer. The producer
   loop is what turns the head of this queue into a transfer and a print, and it advances only when
   the printer is Ready, which only a person sets. *@
@if (Model.Queue.Count == 0)
{
    <p>
        @Html.Raw(string.Format(
            System.Globalization.CultureInfo.CurrentCulture,
            Localiser["Printers_NothingQueued"].Value,
            $"<a href=\"{Url.Page("/Files/Index")}\">{Localiser["Files_Title"].Value}</a>"))
    </p>
}
else
{
    <table class="table table-sm w-auto align-middle">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">@Localiser["Common_File"]</th>
                <th scope="col" class="text-end">@Localiser["Files_Size"]</th>
                <th scope="col">@Localiser["Common_Queued"]</th>
                @if (Model.CanUse)
                {
                    <th scope="col"><span class="visually-hidden">@Localiser["Common_Actions"]</span></th>
                }
            </tr>
        </thead>
        <tbody>
            @for (int index = 0; index < Model.Queue.Count; index++)
            {
                var job = Model.Queue[index];

                <tr>
                    @* The row's place in the list, not its stored Position - cancelling leaves gaps in
                       those, deliberately, and a gap shown to a person reads as a bug. *@
                    <td>@(index + 1)</td>
                    <td class="typed-name">@(job.PrintFile?.Name ?? "(missing)")</td>
                    <td class="text-end">@($"{(job.PrintFile?.Size ?? 0) / 1024.0:N0} KiB")</td>

                    @* Fixed format rather than a culture-dependent one, matching the Files table -
                       and ToLocalTime, without which this column rendered UTC while the print history
                       below it rendered local, two hours apart on the same page. *@
                    <td>@job.QueuedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>

                    @if (Model.CanUse)
                    {
                        <td class="text-nowrap">
                            <form method="post" asp-page-handler="Move" asp-route-uuid="@Model.Statistics.Printer.Uuid"
                                  class="d-inline">
                                <input type="hidden" name="id" value="@job.TrackingId" />
                                <input type="hidden" name="position" value="@(index - 1)" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary"
                                        title="@Localiser["Printers_MoveUp"]" aria-label="@Localiser["Printers_MoveJobUp", job.PrintFile?.Name ?? string.Empty]"
                                        @(index == 0 ? "disabled" : string.Empty)>&uarr;</button>
                            </form>
                            <form method="post" asp-page-handler="Move" asp-route-uuid="@Model.Statistics.Printer.Uuid"
                                  class="d-inline">
                                <input type="hidden" name="id" value="@job.TrackingId" />
                                <input type="hidden" name="position" value="@(index + 1)" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary"
                                        title="@Localiser["Printers_MoveDown"]" aria-label="@Localiser["Printers_MoveJobDown", job.PrintFile?.Name ?? string.Empty]"
                                        @(index == Model.Queue.Count - 1 ? "disabled" : string.Empty)>&darr;</button>
                            </form>
                            <form method="post" asp-page-handler="Cancel" asp-route-uuid="@Model.Statistics.Printer.Uuid"
                                  class="d-inline">
                                <input type="hidden" name="id" value="@job.TrackingId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger"
                                        aria-label="@Localiser["Printers_RemoveJob", job.PrintFile?.Name ?? string.Empty]">@Localiser["Cameras_Remove"]</button>
                            </form>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@* Only for someone who may change this printer's queue: a CanRead visitor given this URL would get
   an upload that succeeds and then a 403 from the queue, which is a worse answer than not offering
   it. *@
@if (Model.CanUse)
{
    <h2>@Localiser["Printers_SlicerHeading"]</h2>

    @* PrusaSlicer's own menu labels stay English: they have to match what a person sees in the
       slicer, which this application neither authors nor translates. Only the sentence around them
       is ours. *@
    <p>
        @Html.Raw(string.Format(
            System.Globalization.CultureInfo.CurrentCulture,
            Localiser["Printers_SlicerHelp"].Value,
            "<em>Printer Settings &rarr; Physical Printer</em>",
            "<strong>Host Type</strong>",
            "<strong>OctoPrint</strong>",
            $"<a href=\"{Url.Page("/Account/Manage/ApiTokens")}\">{Localiser["Printers_ApiTokenLink"].Value}</a>",
            "<strong>Upload and Print</strong>"))
    </p>

    <div class="input-group mb-3" data-copy>
        <input type="text" class="form-control font-monospace" readonly
               value="@Model.SlicerUrl" aria-label="@Localiser["Printers_SlicerAddressLabel"]"
               data-copy-source />
        <button type="button" class="btn btn-outline-secondary" data-copy-button>@Localiser["Common_Copy"]</button>
    </div>

    @* Announced politely rather than shouted, and empty until something happens, so a screen reader
       hears the outcome without the control describing itself twice. *@
    <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>
}

@* Heaters, and only ever both together. The service can set either alone and nothing here can:
   a page that could leave one heater on and the other off would be a way to make a mistake
   quietly. Hidden entirely without CanUse, like every other control on this page. *@
@if (Model.CanUse)
{
    <h2>@Localiser["Printers_Temperature"]</h2>

    <p class="text-body-secondary">
        @Localiser["Printers_PreheatBoth"]
    </p>

    @* Cooling is refused mid-print too, which reads as arbitrary unless it is said: the button
       looks like a safety control and is not one. Said on the page rather than only in the refusal,
       so nobody has to press it to find out. *@
    <p class="text-body-secondary">
        @Html.Raw(string.Format(
            System.Globalization.CultureInfo.CurrentCulture,
            Localiser["Printers_PreheatWarning"].Value,
            $"<strong>{Localiser["Printers_CoolingIncluded"].Value}</strong>",
            $"<a href=\"{Url.Page("Index")}\">{Localiser["Printers_PrintersListLink"].Value}</a>"))
    </p>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <form method="post" asp-page-handler="Preheat" asp-route-uuid="@Model.Statistics.Printer.Uuid"
              class="d-flex align-items-center gap-2">
            <label class="form-label mb-0" for="filament">@Localiser["Printers_PreheatFor"]</label>

            <select class="form-select w-auto" id="filament" name="filament">
                @foreach (FilamentPreset preset in Model.Presets)
                {
                    <option value="@preset.Name">
                        @preset.Name &mdash; @preset.NozzleTemperature&deg;C / @preset.BedTemperature&deg;C
                    </option>
                }
            </select>

            <button type="submit" class="btn btn-outline-primary">@Localiser["Printers_Preheat"]</button>
        </form>

        <form method="post" asp-page-handler="Cooldown" asp-route-uuid="@Model.Statistics.Printer.Uuid">
            <button type="submit" class="btn btn-outline-secondary">@Localiser["Printers_CoolDown"]</button>
        </form>
    </div>
}

@* Setting ready is a person asserting the sheet is clear, which is why the walk to the machine was
   never pure friction - it forced somebody to look. Off unless this printer has been judged one whose
   sheet can be read from here, so the control is absent rather than refusing. *@
@if (Model.CanUse && Model.Statistics.Printer.RemoteReadyAllowed)
{
    string readyPrinterName = Model.Statistics.Printer.Name
                              ?? Model.Statistics.Printer.Model
                              ?? Model.Statistics.Printer.Uuid.ToString();

    <div class="mb-3">
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#set-ready">
            @Localiser["Intent_SetPrinterReady"]
        </button>
    </div>

    <div class="modal fade" id="set-ready" tabindex="-1" aria-labelledby="set-ready-heading" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="set-ready-heading">
                        @string.Format(System.Globalization.CultureInfo.CurrentCulture,
                                       Localiser["Printers_ReadyHeading"].Value,
                                       readyPrinterName)
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="@Localiser["Common_Cancel"]"></button>
                </div>

                <div class="modal-body">
                    @* The same polled frame the top of the page uses, not a second snapshot path -
                       camera.js binds every [data-camera-frame] it finds. Seeing the sheet is what
                       makes answering the question honest rather than a guess. *@
                    @if (Model.Cameras.Count > 0)
                    {
                        <div class="camera-view ratio ratio-16x9 border rounded bg-body-tertiary overflow-hidden mb-3"
                             data-camera-frame="@Url.Action("Frame", "Camera", new { uuid = Model.Cameras[0].Uuid })">
                            <img class="camera-image w-100 h-100 object-fit-contain d-none" alt="" />
                            <div class="camera-status d-flex align-items-center justify-content-center text-body-secondary small">
                                @Localiser["Cameras_Capturing"]
                            </div>
                        </div>
                    }
                    else
                    {
                        @* Said out loud rather than left as an absent picture: without a feed this is
                           an assertion made blind, and the walk it replaces was annoying precisely
                           because it forced a look. *@
                        <p class="text-body-secondary">
                            @string.Format(System.Globalization.CultureInfo.CurrentCulture,
                                           Localiser["Printers_ReadyNoCamera"].Value,
                                           readyPrinterName)
                        </p>
                    }

                    <p class="fw-semibold mb-2">@Localiser["Printers_ReadyChecklist"]</p>

                    <p class="text-body-secondary mb-0">@Localiser["Printers_ReadyConsequence"]</p>
                </div>

                @* The confirm carries the assertion rather than agreement. A button saying "OK" can be
                   cleared while telling yourself you are dismissing a dialog; one saying what you are
                   claiming has to be read to be pressed. *@
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        @Localiser["Common_Cancel"]
                    </button>

                    <form method="post" asp-page-handler="Ready" asp-route-uuid="@Model.Statistics.Printer.Uuid">
                        <button type="submit" class="btn btn-primary">@Localiser["Printers_ReadyConfirm"]</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@* Whether the prompt above can be answered honestly for this printer is a standing judgement about
   the machine, so it sits behind CanManage rather than CanUse: decided once by somebody who has seen
   it, inherited by everyone who has not. *@
@if (Model.CanManage)
{
    <div class="mb-3">
        @* The switch is the control, not a picture of one. An unchecked checkbox posts nothing, so
           the handler's bool binds false on its own and no hidden field is needed to carry the
           flipped value. The Save button is the no-script path and toggle-submit.js hides it. *@
        <form method="post" asp-page-handler="RemoteReady" asp-route-uuid="@Model.Statistics.Printer.Uuid">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="remote-ready"
                       name="allowed" value="true" data-submit-on-change
                       @(Model.Statistics.Printer.RemoteReadyAllowed ? "checked" : null) />
                <label class="form-check-label" for="remote-ready">@Localiser["Printers_RemoteReadyLabel"]</label>
            </div>

            <p class="text-body-secondary small mt-1">@Localiser["Printers_RemoteReadyHelp"]</p>

            <button type="submit" class="btn btn-outline-secondary btn-sm" data-submit-fallback>
                @Localiser["Common_Save"]
            </button>
        </form>
    </div>
}

<h2>@Localiser["Printers_PrintHistory"]</h2>

@if (Model.History.Count == 0)
{
    <p>@Localiser["Printers_NothingFinished"]</p>
}
else
{
    <table class="table table-sm w-auto">
        <thead>
            <tr>
                <th scope="col">@Localiser["Common_File"]</th>
                <th scope="col">@Localiser["Common_Started"]</th>

                @* "Outcome", though the property is PrintState.State - and deliberately, not left
                   over from the rename. This table is filtered to EndedAt != null, and Close() sets
                   EndedAt and State together, so the only values reachable here are Finished,
                   Stopped, Failed and Unknown: all of them outcomes. "State" would be the worse
                   word, inviting "is it printing?" about a table where everything has ended.

                   Same reason Close(PrintJob, PrintState outcome, ...) keeps "outcome" for its
                   parameter. The type is named for the whole lifecycle because it spans it; this
                   column only ever sees the end of it. *@
                <th scope="col">@Localiser["Common_Outcome"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Model.History)
            {
                <tr>
                    <td class="typed-name">@job.FileName</td>
                    <td>@job.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm",
                        System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>
                        @job.State
                        @* A stop says who, because the printer cannot: it reports the same state
                           change whether somebody pressed stop here or on the panel. *@
                        @if (job.State == Homespool.Model.PrintState.Stopped)
                        {
                            <br />

                            <span class="text-muted">@Model.StoppedByDescription(job)</span>
                        }
                        @* Firmware's own words, and the only place a refused print explains itself.
                           Without this a queued print that never ran left nothing a person could read. *@
                        @if (job.Reason is { } reason)
                        {
                            <br />

                            <span class="text-muted">@reason</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>@Localiser["Printers_RecentTelemetry"]</h2>

@if (Model.Statistics.RecentSamples.Count == 0)
{
    <p>@Localiser["Printers_NoTelemetryHistory"]</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>@Localiser["Common_Time"]</th>
                <th>@Localiser["Common_Status"]</th>
                <th>@Localiser["Printers_Progress"]</th>
                <th>@Localiser["Printers_Nozzle"]</th>
                <th>@Localiser["Printers_Bed"]</th>
                <th>@Localiser["Printers_Speed"]</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var sample in Model.Statistics.RecentSamples)
        {
            <tr>
                <td>@sample.Timestamp</td>
                <td>@sample.Status</td>
                <td>@(sample.Progress is { } progress ? $"{progress}%" : "-")</td>
                <td>@(sample.NozzleTemperature?.ToString("0.0") ?? "-")</td>
                <td>@(sample.BedTemperature?.ToString("0.0") ?? "-")</td>
                <td>@(sample.Speed is { } speed ? $"{speed}%" : "-")</td>
            </tr>
        }
        </tbody>
    </table>
}

<h2>@Localiser["Printers_RecentEvents"]</h2>

@if (Model.Statistics.RecentEvents.Count == 0)
{
    <p>@Localiser["Printers_NoEvents"]</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>@Localiser["Common_Time"]</th>
                <th>@Localiser["Common_Event"]</th>
                <th>@Localiser["Common_Reason"]</th>
                <th>@Localiser["Common_Job"]</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var printerEvent in Model.Statistics.RecentEvents)
        {
            <tr>
                <td>@printerEvent.Timestamp</td>
                <td>@printerEvent.EventType</td>
                <td>@(printerEvent.Reason ?? "-")</td>
                <td>@(printerEvent.JobId?.ToString() ?? "-")</td>
            </tr>
        }
        </tbody>
    </table>
}

@section Scripts {
    <script src="~/js/camera.js" asp-append-version="true"></script>
    <script src="~/js/toggle-submit.js" asp-append-version="true"></script>
}
