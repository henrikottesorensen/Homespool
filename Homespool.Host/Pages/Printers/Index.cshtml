@page
@model IndexModel
@{
    ViewData["Title"] = Localiser["Printers_Title"].Value;
}

<h1>@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusSuccess ? "alert-success" : "alert-warning")" role="alert">@Model.StatusMessage</div>
}

@if (Model.Offer is not null)
{
    <partial name="_BundleDownload" model="Model.Offer" />
}

<p>
    <a class="btn btn-outline-primary" asp-page="Claim">@Localiser["Printers_Claim"]</a>
    <a class="btn btn-primary" asp-page="Add">@Localiser["Printers_Add"]</a>
</p>

@* Polled, at the front page's ten seconds: this page shows the same badges and bars as the tiles,
   and left open beside them it would be the one that went quietly stale. Ten rather than the status
   card's two because these are plaques saying "Printing", not temperatures climbing, and there are
   as many of them as there are printers. The buttons are inside the region and survive it: they hold
   no half-finished input to lose, and live-region.js swaps nothing when the answer is unchanged. *@
<div data-live-region
     data-live-url="@Url.Page("Index", "Rack")"
     data-live-interval="10000">
    <partial name="_PrinterRack" model="Model" />
</div>

@if (Model.CanUpload)
{
    <partial name="_TileDropForm" />
}

@section Scripts {
    <script src="~/js/live-region.js" asp-append-version="true"></script>

    @if (Model.CanUpload)
    {
        @* camera.js before tile-drop.js, as on the front page: the drop dialog's bed-clear step
           carries a camera view and asks camera.js to bind it once that step is shown. *@
        <script src="~/js/camera.js" asp-append-version="true"></script>
        <script src="~/js/tile-drop.js" asp-append-version="true"></script>
    }
}
