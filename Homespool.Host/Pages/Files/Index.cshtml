@page
@model IndexModel
@{
    ViewData["Title"] = Localiser["Files_Title"].Value;
}

<h1>@ViewData["Title"]</h1>

@if (Model.Printers.Count > 0)
{
    @* One printer for every row's Send/Queue button, chosen here rather than per row - a plain GET
       so the choice is bookmarkable and survives the back button, same as the sort headers below.
       data-printer-select is site.js's hook to submit on change - without it, picking a new option
       only changes what the <select> shows, not what Send/Queue below actually target, until Save
       is pressed and the page re-renders with it. *@
    <form method="get" asp-page="./Index" class="d-flex align-items-center gap-2 mb-3" data-printer-select>
        <label class="form-label mb-0" for="printer-select">@Localiser["Common_Printer"]</label>
        <select id="printer-select" name="printerId" class="form-select form-select-sm w-auto">
            @* An empty option, rendered only while nothing is chosen. Without it the browser shows the
               first printer as though it were selected, which is the whole defect: a machine nobody
               picked, presented as the one that will receive the file. *@
            @if (Model.SelectedPrinterId is null)
            {
                <option value="" selected>@Localiser["Files_NoPrinterChosen"]</option>
            }
            @foreach (var printer in Model.Printers)
            {
                <option value="@printer.Id" selected="@(printer.Id == Model.SelectedPrinterId)">@PrinterDisplayName.For(printer)</option>
            }
        </select>
        <input type="hidden" name="sort" value="@Model.Sort" />
        <input type="hidden" name="desc" value="@Model.Descending" />
        <button type="submit" class="btn btn-sm btn-outline-primary">@Localiser["Common_Save"]</button>
    </form>

    @if (Model.SelectedPrinterId is null)
    {
        <p class="text-body-secondary small">@Localiser["Files_ChooseAPrinter"]</p>
    }
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusSuccess ? "alert-success" : "alert-warning")" role="alert">@Model.StatusMessage</div>
}

@if (Model.PendingToken is not null)
{
    @* The bytes are already on disk, so answering this costs nothing more - which is the whole
       reason the upload is held rather than thrown away on a clash. *@
    <div class="alert alert-warning" role="alert">
        <p>@Localiser["Files_DuplicateName"] <strong>@Model.PendingName</strong>.</p>
        <form method="post" asp-page-handler="Replace"
              asp-route-token="@Model.PendingToken"
              asp-route-sort="@Model.Sort"
              asp-route-desc="@Model.Descending"
              asp-route-printerId="@Model.SelectedPrinterId"
              class="d-inline">
            <button type="submit" class="btn btn-sm btn-warning">@Localiser["Files_Replace"]</button>
        </form>
        <form method="post" asp-page-handler="Discard"
              asp-route-token="@Model.PendingToken"
              asp-route-sort="@Model.Sort"
              asp-route-desc="@Model.Descending"
              asp-route-printerId="@Model.SelectedPrinterId"
              class="d-inline">
            <button type="submit" class="btn btn-sm btn-outline-secondary">@Localiser["Files_KeepExisting"]</button>
        </form>
    </div>
}

@* data-upload-dropzone is what site.js looks for. It submits this form itself, on a drop or on a
   file picked through the input - the button is the fallback for when that script never runs.
   The three data-upload-* attributes carry the sentences a multi-file drop needs, unformatted -
   site.js substitutes the placeholders itself once it knows how many files were dropped, which
   the localiser cannot know at render time. *@
<div class="upload-dropzone mb-2" data-upload-dropzone
     data-upload-confirm-batch="@Localiser["Files_ConfirmBatchUpload"]"
     data-upload-too-many="@Localiser["Files_TooManyDropped"]"
     data-upload-progress="@Localiser["Files_UploadingProgress"]">
    <form method="post" asp-page-handler="Upload" enctype="multipart/form-data"
          asp-route-sort="@Model.Sort" asp-route-desc="@Model.Descending" asp-route-printerId="@Model.SelectedPrinterId"
          class="d-flex align-items-center gap-2">
        <input type="file" name="file" accept=".gcode,.bgcode,.gco,.bgc" class="form-control" aria-label="@Localiser["Files_UploadLabel"]" required />
        <button type="submit" class="btn btn-primary text-nowrap">@Localiser["Files_Upload"]</button>
    </form>
    <p class="text-body-secondary small mb-0 mt-2">
        @Localiser["Files_DropHere", ByteSize.Format(Model.MaxUploadBytes, Localiser)]
    </p>
</div>

@if (Model.Files.Count == 0)
{
    <p>@Localiser["Files_None"]</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                @* Headings are links rather than script: the sorted view is then linkable, bookmarkable
                   and survives the back button, none of which a JavaScript toggle would give. *@
                @* Name is the only column with no col-shrink: everything else is pinned to its content
                   width, so Name is left holding all the space nothing else asked for. *@
                <th>
                    <a asp-page="./Index"
                       asp-route-sort="@IndexModel.Columns.Name"
                       asp-route-desc="@Model.NextDescendingFor(IndexModel.Columns.Name)"
                       asp-route-printerId="@Model.SelectedPrinterId"
                       aria-sort="@(Model.Sort == IndexModel.Columns.Name ? (Model.Descending ? "descending" : "ascending") : "none")"
                       class="link-body-emphasis text-decoration-none">@Localiser["Common_Name"]@(Model.IndicatorFor(IndexModel.Columns.Name))</a>
                </th>
                <th class="text-end col-shrink">
                    <a asp-page="./Index"
                       asp-route-sort="@IndexModel.Columns.Size"
                       asp-route-desc="@Model.NextDescendingFor(IndexModel.Columns.Size)"
                       asp-route-printerId="@Model.SelectedPrinterId"
                       aria-sort="@(Model.Sort == IndexModel.Columns.Size ? (Model.Descending ? "descending" : "ascending") : "none")"
                       class="link-body-emphasis text-decoration-none">@Localiser["Files_Size"]@(Model.IndicatorFor(IndexModel.Columns.Size))</a>
                </th>
                <th class="col-shrink">
                    <a asp-page="./Index"
                       asp-route-sort="@IndexModel.Columns.Uploaded"
                       asp-route-desc="@Model.NextDescendingFor(IndexModel.Columns.Uploaded)"
                       asp-route-printerId="@Model.SelectedPrinterId"
                       aria-sort="@(Model.Sort == IndexModel.Columns.Uploaded ? (Model.Descending ? "descending" : "ascending") : "none")"
                       class="link-body-emphasis text-decoration-none">@Localiser["Files_Uploaded"]@(Model.IndicatorFor(IndexModel.Columns.Uploaded))</a>
                </th>
                <th class="col-shrink"></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var file in Model.Files)
        {
            <tr>
                @if (Model.Renaming == file.FileName)
                {
                    <td colspan="3">
                        <form method="post" asp-page-handler="Rename"
                              asp-route-name="@file.FileName"
                              asp-route-sort="@Model.Sort"
                              asp-route-desc="@Model.Descending"
                              asp-route-printerId="@Model.SelectedPrinterId"
                              class="d-flex gap-2">
                            <input type="text" name="newName" value="@file.FileName" class="form-control form-control-sm"
                                   aria-label="@Localiser["Files_NewNameLabel"]" required />
                            <button type="submit" class="btn btn-sm btn-primary">@Localiser["Common_Save"]</button>
                            <a asp-page="./Index" asp-route-sort="@Model.Sort" asp-route-desc="@Model.Descending" asp-route-printerId="@Model.SelectedPrinterId"
                               class="btn btn-sm btn-outline-secondary">@Localiser["Common_Cancel"]</a>
                        </form>
                    </td>
                }
                else
                {
                    <td class="typed-name">@file.FileName</td>
                    <td class="text-end font-monospace">@ByteSize.Format(file.Length, Localiser)</td>
                    @* ISO, deliberately, and not because the reader's culture is unknown - it is known
                       per request, and ByteSize.Format beside this now follows it. A timestamp is the one
                       value where following it would make the column worse: en-GB and en-US are both
                       supported here and disagree silently about 01/02/2026, so a short date is only
                       unambiguous to a reader who knows which of the two they are being shown. This
                       also sorts, and matches what the logs and the printer's own events carry. *@
                    <td>@file.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                }
                <td class="text-end text-nowrap">
                    @* Only when a printer is selected up top: a Send/Queue button with nothing to
                       send to would only produce a "not yours" refusal. *@
                    @if (Model.SelectedPrinterId is not null)
                    {
                        <form method="post" asp-page-handler="Send"
                              asp-route-name="@file.FileName"
                              asp-route-sort="@Model.Sort"
                              asp-route-desc="@Model.Descending"
                              asp-route-printerId="@Model.SelectedPrinterId"
                              class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-primary"
                                    title="@Localiser["Files_SendTitle"]">@Localiser["Files_Send"]</button>
                            @* Second submit on the same form. asp-page-handler on a button emits
                               formaction, which overrides the form's - so the route values have to be
                               repeated here. *@
                            <button type="submit" class="btn btn-sm btn-outline-primary"
                                    asp-page-handler="Queue"
                                    asp-route-name="@file.FileName"
                                    asp-route-sort="@Model.Sort"
                                    asp-route-desc="@Model.Descending"
                                    asp-route-printerId="@Model.SelectedPrinterId"
                                    title="@Localiser["Files_QueueTitle"]">@Localiser["Files_Queue"]</button>
                        </form>
                    }
                    <a asp-page="./Index"
                       asp-route-sort="@Model.Sort"
                       asp-route-desc="@Model.Descending"
                       asp-route-rename="@file.FileName"
                       asp-route-printerId="@Model.SelectedPrinterId"
                       class="btn btn-sm btn-outline-secondary">@Localiser["Files_Rename"]</a>
                    @* Straight to the API, which already answers a cookie-authenticated GET - a second
                       copy of the same download here would be one more place to get ownership wrong. *@
                    <a href="/api/v1/files/@Uri.EscapeDataString(file.FileName)"
                       class="btn btn-sm btn-outline-secondary">@Localiser["Files_Download"]</a>
                    <form method="post" asp-page-handler="Delete"
                          asp-route-name="@file.FileName"
                          asp-route-sort="@Model.Sort"
                          asp-route-desc="@Model.Descending"
                          asp-route-printerId="@Model.SelectedPrinterId"
                          class="d-inline"
                          onsubmit="return confirm('Delete @file.FileName?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">@Localiser["Common_Delete"]</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
