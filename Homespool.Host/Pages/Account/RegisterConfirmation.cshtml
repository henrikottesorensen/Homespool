@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Register confirmation";
}

<h1>@ViewData["Title"]</h1>

@if (Model.EmailFailed)
{
    <div class="alert alert-warning" role="alert">
        @Localiser["Account_ConfirmEmailFailed"]
    </div>
}
else if (Model.SmtpConfigured)
{
    <p>@Localiser["Account_CheckEmail"]</p>
}
else
{
    <p>
        @Localiser["Account_ReadyNoMail"]
    </p>
    <p><a asp-page="./Login">@Localiser["Account_SignIn"]</a></p>
}
