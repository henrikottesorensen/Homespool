@model IReadOnlyList<PrinterService.Host.Services.HealthBannerItem>

@* Renders nothing at all when healthy - no empty container, no reserved space, so a healthy service
   looks exactly as it did before this existed. *@
@foreach (PrinterService.Host.Services.HealthBannerItem item in Model)
{
    <div class="alert @item.CssClass" role="alert">
        <strong>Service problem:</strong> @item.Message
    </div>
}
