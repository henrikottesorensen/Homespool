@@ -98,6 +106,37 @@ func patch(in []byte, path []string, value any) ([]byte, error) {
 	return join(in[:i1], paste, in[i1:]), nil
 }
 
+// replaceParent writes the parent key again as a block mapping, holding what it held with
+// key set to value, or removed when value is nil.
+func replaceParent(in []byte, pKey, pVal *yaml.Node, key string, value any) ([]byte, error) {
+	items := map[string]any{}
+	if pVal.Kind == yaml.MappingNode {
+		if err := pVal.Decode(&items); err != nil {
+			return nil, err
+		}
+	}
+
+	if value != nil {
+		items[key] = value
+	} else {
+		delete(items, key)
+	}
+
+	var paste []byte
+	if len(items) == 0 {
+		paste = []byte(pKey.Value + ":\n")
+	} else {
+		var err error
+		if paste, err = Encode(map[string]any{pKey.Value: items}, 2); err != nil {
+			return nil, err
+		}
+	}
+	paste = addIndent(paste, pKey.Column-1)
+
+	i0, i1 := nodeBounds(in, pKey)
+	return join(in[:i0], paste, in[i1:]), nil
+}
