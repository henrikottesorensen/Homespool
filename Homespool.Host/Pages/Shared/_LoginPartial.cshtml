@using Homespool.Host.Services
@inject SignInManager<HSUser> SignInManager
@inject UserManager<HSUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    @if (User.IsInRole(AdminBootstrap.AdminRole))
    {
        <li class="nav-item">
            <a id="invites" class="nav-link" asp-page="/Admin/Invites/Index" title="Invitations">Invites</a>
        </li>
    }
    <li class="nav-item">
        <a id="printers" class="nav-link" asp-page="/Printers/Index" title="Printers">Printers</a>
    </li>
    <li class="nav-item">
        <a id="manage" class="nav-link" asp-page="/Account/Manage/Index" title="Manage">Hello @UserManager.GetUserName(User)!</a>
    </li>
    <li class="nav-item">
        <form id="logoutForm" class="form-inline" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button id="logout" type="submit" class="nav-link btn btn-link border-0">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" id="login" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
