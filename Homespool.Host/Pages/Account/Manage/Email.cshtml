@page
@model EmailModel
@{
    ViewData["Title"] = Localiser["Manage_EmailTitle"].Value;
}

<h1>@ViewData["Title"]</h1>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form id="email-form" method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            @if (Model.IsEmailConfirmed)
            {
                <div class="form-floating mb-3 input-group">
                    <input asp-for="Email" class="form-control" placeholder="@Localiser["Account_EnterEmailPlaceholder"]" disabled />
                        <div class="input-group-append">
                            <span class="h-100 input-group-text text-success font-weight-bold">✓</span>
                        </div>
                    <label asp-for="Email" class="form-label"></label>
                </div>
            }
            else
            {
                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control" placeholder="@Localiser["Account_EnterEmailPlaceholder"]" disabled />
                    <label asp-for="Email" class="form-label"></label>
                    <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link">@Localiser["Manage_SendVerification"]</button>
                </div>
            }
            <div class="form-floating mb-3">
                <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="@Localiser["Manage_EnterNewEmailPlaceholder"]" />
                <label asp-for="Input.NewEmail" class="form-label"></label>
                <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
            </div>
            @if (Model.UsesPassword)
            {
                @* The address is where a forgotten password is sent, so moving it takes the password. *@
                <div class="form-floating mb-1">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="@Localiser["Common_PasswordPlaceholder"]" />
                    <label asp-for="Input.Password" class="form-label"></label>
                </div>
                <p class="form-text mb-3">@Localiser["StepUp_PasswordWhy"]</p>
            }
            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="w-100 btn btn-lg btn-primary">@Localiser["Manage_ChangeEmail"]</button>
        </form>

        @if (!Model.UsesPassword)
        {
            @* No password to prove, so the provider does the proving: a round trip that ends back
               here with a five-minute confirmation the change above spends. Its own form, since a
               form cannot nest in the change form. *@
            <p class="form-text mt-3">@Localiser["StepUp_ProviderWhy", Model.Providers.Count > 0 ? (Model.Providers[0].DisplayName ?? Model.Providers[0].Name) : Localiser["StepUp_YourProvider"].Value]</p>
            @foreach (var scheme in Model.Providers)
            {
                <form method="post" asp-page-handler="Reauthenticate" class="mb-3">
                    <input type="hidden" name="provider" value="@scheme.Name" />
                    <button type="submit" class="btn btn-outline-primary">@Localiser["StepUp_ProviderConfirm", scheme.DisplayName ?? scheme.Name]</button>
                </form>
            }
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
