{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HomespoolDb": "Data Source=Homespool.Sqlite"
  },
  "Storage": {
    "AutoMigrate": true,
    "TelemetryRetentionDays": 14,
    "MinimumSampleIntervalSeconds": 0,
    "WriteBatchSize": 500,
    "WriteFlushIntervalSeconds": 2,
    "BusyTimeoutMilliseconds": 5000
  },
  "Certificates": {
    "//": "The printer-facing certificate authority. Its private key is the most sensitive secret here - custom_cert is exclusive, so this CA is each provisioned printer's entire trust store. See notes/tls-by-default.md.",
    "Directory": "data/certificates",
    "AuthorityValidityDays": 5475,
    "LeafValidityDays": 730,
    "AuthorityName": "Homespool printer CA"
  },

  "XForwarded": {
    "//": "Which proxy may speak for the client. Empty means the forwarded-headers middleware is not registered at all - see XForwardedOptions. Set KnownNetworks to the proxy's network; compose.yaml does this for the shipped stack.",
    "ClientAddressHeader": "X-Real-IP",
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },

  "PrusaConnect": {
    "RegistrationCodeLifetimeMinutes": 30,
    "PrinterHost": "",
    "PrinterPort": 443,
    "PrinterTls": true,
    "CommandResponseTimeoutSeconds": 10
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseImplicitTls": false,
    "UserName": "",
    "Password": "set-via-Smtp__Password-env-var-or-user-secrets",
    "FromAddress": "",
    "FromName": "Homespool",
    "TimeoutSeconds": 30,
    "ProbeOnStartup": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
