# Copy this file to .env and fill in the values you need:
#
#     cp .env.example .env
#
# .env is gitignored, so secrets stay out of the repository. docker compose reads it
# automatically - you should not need to edit compose.yaml.
#
# Leaving SMTP_HOST empty is a supported configuration. The server then runs with no outgoing
# mail: new accounts are created already confirmed, and password reset is unavailable.

# The zone timestamps are shown in, as an IANA name - Europe/Copenhagen, America/Denver. Left unset
# a container is UTC, which is rarely the right answer for a machine in a house: rendering happens
# on the server, not in the browser, and that includes the expiry an invitation email states.
# Presentation only - times are stored as an absolute instant, so changing this later re-renders
# existing history correctly rather than shifting it.
TZ=UTC

# Host ports for people. The stack ships an nginx that terminates TLS and passes plain HTTP to the
# app over its own network; the app's port is not published at all, so the proxy is the only way in.
# HTTP is redirected to HTTPS, except /health, so a monitoring probe can stay plain.
#
# The redirect from plain HTTP names the HTTPS port automatically: publish on 8443 and visitors
# are sent to https://...:8443/, publish on 443 and the URL stays clean. There is nothing more to
# set as long as browsers connect straight to this machine.
#
# REDIRECT_PORT_SUFFIX is for when they do not, and the difference is what each one names:
# HTTPS_PORT is where Docker publishes on THIS machine, the suffix is the port the redirect tells
# a BROWSER to use. Example: a router forwards public 443 to 8443 here. HTTPS_PORT=8443, but
# browsers reach the site without a port in the address, so the derived ":8443" would send them to
# a port the router does not answer. Set REDIRECT_PORT_SUFFIX= (empty, meaning 443) - or another
# port in ":9443" form - and that is used instead of deriving it.
PORT=80
HTTPS_PORT=443

# What people browse to. Both nginx and the application answer only these names and localhost, and
# a request arriving under any other Host is refused - so a machine reached by more than one name
# needs all of them here. SEMICOLONS between them, no spaces:
#
#   USER_HOSTS=homespool.lan;homespool.local;192.168.1.50
#
# Every name is also put in the self-signed certificate the proxy generates on first start, the
# first one as its common name. A bare IP address goes in as an IP entry rather than a name, which
# is what a browser requires - and the opposite of what the printer certificate does, where the
# firmware's TLS stack matches an address only when it is spelled as a name.
#
# RENAMED from USER_HOST, and the old name is not read at all. A .env still carrying it falls back
# to localhost, and everything reaching this deployment under any other name is then refused - so
# rename the line rather than adding this one beside it. The failure is total and immediate, which
# is the intent: an alias would let a stale .env look configured while the list it names is ignored.
#
# To use a real certificate, put homespool.crt and homespool.key into the homespool-proxy-certs
# volume and restart the proxy; nginx does not care where a certificate came from.
USER_HOSTS=localhost

# The address printers use to reach this server - required for USB-key provisioning (Printers ->
# Add printer won't produce a snippet without it). Printers connect to this stack directly, so this
# is this machine's own name or LAN address, NOT a proxy's: the printer listener serves a
# certificate this deployment mints itself, and a proxy in front of it breaks the handshake the
# firmware requires.
#
# Set it before the first start if you can. The certificate is issued once, on the first run,
# covering every address this machine can see plus whatever this says - so setting it first means
# it is covered by construction rather than by luck.
PRINTER_HOST=

# Port printers connect to, published by the proxy - which terminates their TLS too, on a different
# port and with a completely different certificate from the browser's. It is written into the
# generated ini and typed by no one, so a non-standard number costs nothing.
PRINTER_PORT=15443

# Port a printer on the pre-websocket transport (firmware built without websockets - a 6.2.6 MK3.5,
# say) fetches a file from, published by the proxy as PLAIN HTTP. Not a TLS port to be tidied later:
# the printer opens this with a raw socket and cannot do otherwise. The body is AES-CTR ciphertext,
# so an observer reads nothing - but nothing checks the body's integrity either, which makes this a
# LAN port. Publish it to the internet knowingly or not at all.
TRANSFER_PORT=15080

# Whether printers use TLS to reach PRINTER_HOST. One switch, both ends: it is the tls line in every
# provisioning ini AND whether a certificate is issued for the proxy to present, so the two cannot
# disagree.
#
# false is a testing setting, never a deployment choice, LAN-only included - it puts every printer
# token on the network in clear, in both directions, and the server says so at every startup.
# Setting it here is only half of it: bring the stack up with the plaintext override as well -
#
#   docker compose -f compose.yaml -f compose.plaintext.yaml up
#
# - which that file explains. The web UI's TLS is unaffected either way.
PRINTER_TLS=true

# Mail server hostname. Empty disables outgoing mail entirely.
#
# NOT localhost. Homespool runs in a container, so localhost is the container itself and a mail
# server on this machine is refused from in there. Use host.docker.internal, which compose.yaml maps
# to the host on Linux as well as on Docker Desktop.
SMTP_HOST=

# 587 for submission with STARTTLS, 465 for implicit TLS. A port number on its own decides nothing -
# it is the two settings below that choose the encryption, and they have to match what your server
# actually offers.
SMTP_PORT=587

# true for implicit TLS (port 465), false to upgrade via STARTTLS (port 587).
SMTP_USE_IMPLICIT_TLS=false

# No encryption at all - for a mail server on THIS machine, reached over the loopback, and nothing
# else; it sends every message and every credential in the clear. You need it for a local test
# inbox (Mailpit, MailHog): with SMTP_USE_IMPLICIT_TLS=false the STARTTLS upgrade is required, not
# attempted - deliberately, since a silent fallback would put your password on the network - so a
# server offering no STARTTLS is unreachable until this is true.
SMTP_DISABLE_TLS=false

# Username for SMTP AUTH. Empty connects without authenticating.
SMTP_USERNAME=

# Password for SMTP AUTH. This is why .env is gitignored - keep it out of compose.yaml.
#
# A dollar in any value here is compose's, not yours: SMTP_PASSWORD=p@ss$word reaches the server as
# "p@ss", because the rest is read as a variable name, found undefined, and dropped silently. Write
# it as $$ - SMTP_PASSWORD=p@ss$$word - and the server gets p@ss$word. The failure otherwise is an
# authentication error against a file that looks exactly right. setup-env.sh escapes this for you.
SMTP_PASSWORD=

# Envelope sender address. Falls back to SMTP_USERNAME when empty.
SMTP_FROM_ADDRESS=

# Display name on outgoing mail.
SMTP_FROM_NAME=Homespool

# Connect and authenticate once at startup to report a broken configuration early. Diagnostic
# only - it never changes behaviour. Set false if your mail server is in this same compose
# stack and starts after this container, since the probe would warn about a transient state.
SMTP_PROBE_ON_STARTUP=true

# --- Reverse proxy ---------------------------------------------------------------------------
# The network Homespool's own containers share, and the range whose forwarded headers are
# believed. These two MUST agree: PROXY_NETWORK is what the application trusts, PROXY_SUBNET is
# what Docker actually allocates. Change them together if the default collides with your LAN.
#
# Leave PROXY_NETWORK empty and the forwarded-headers middleware is not registered at all. That is
# the safe state, not a broken one - but behind a reverse proxy it means links in outgoing mail
# will say http:// and logged client addresses will be the proxy's; the application says so at
# startup. NEVER widen this to "trust everything" to make it work: a forwarded header is just a
# request header, and anything trusted here can tell Homespool who the client is.
PROXY_SUBNET=172.28.0.0/16
PROXY_NETWORK=172.28.0.0/16

# --- Telemetry storage -------------------------------------------------------------------------
# A floor, in seconds, on how often each printer's telemetry is written to the database. 0 stores
# every sample, which is the default and what you want on a machine with an ordinary disk.
#
# Raise it if Homespool runs on an SD card, which wears out by being written to - telemetry is the
# largest source of writes, at roughly one sample per second per printer. A value of 10 removes
# about 90% of those writes and still leaves a graph you can read; the cost is resolution, so a
# spike shorter than the interval may not be recorded. Deleting old data is not a substitute:
# retention deletes are writes too.
TELEMETRY_MIN_SAMPLE_INTERVAL_SECONDS=0

# --- Cameras ------------------------------------------------------------------------------------
# Cameras are added in Homespool, not here - it registers them with the go2rtc sidecar for you, and
# neither a network camera nor one plugged into this machine needs anything edited to work. This is
# only the sidecar's address, and the default is right unless you renamed the service.
#
# compose.yaml grants the sidecar this machine's video devices as a class; to narrow that to named
# cameras, see the commented `devices:` block on the `go2rtc` service there.
CAMERA_STREAM_SERVER_BASE_URL=http://go2rtc:1984

# A floor, in seconds, on how often each camera is re-read while somebody is watching. Frames are
# only fetched while a page is open, so a camera nobody is looking at costs nothing.
#
# Lower means a livelier picture and more CPU: measured on a Raspberry Pi 4, one H.264 RTSP camera
# costs about 1.4 seconds of CPU per frame and a USB camera far less. The default is chosen to sit
# just under a typical RTSP camera's own acquisition time, so it is not the limiting factor.
CAMERA_REFRESH_FLOOR_SECONDS=2

# How old a frame may be before it is thrown away rather than shown, in seconds. A safety setting,
# not a performance one: frames are only captured while someone is looking, so a camera nobody has
# opened for a day still holds yesterday's picture - and a day-old photograph of a clear print bed
# looks exactly like a current one. Past this age the page says it is capturing instead.
CAMERA_MAX_AGE_SECONDS=60

# --- Camera stream server -----------------------------------------------------------------------
# A username and password for the go2rtc sidecar's own API. Both or neither: a username with an
# empty password turns its authentication on with an empty key and locks out Homespool too.
#
# REQUIRED IF YOU WANT CAMERAS. Homespool refuses to talk to the sidecar at all while these are
# empty - adding a camera is refused, and any camera already configured stops producing a picture,
# with the reason in the administrator's banner. A deployment with no cameras can leave them empty
# and nothing complains. (The why is in compose.yaml, on the go2rtc service.)
#
# ./setup-env.sh generates these without asking. By hand:
#
#   openssl rand -base64 24
#
# NO DOUBLE QUOTE AND NO BACKSLASH IN THE PASSWORD - it crosses a JSON command line for the sidecar
# and a YAML one for Homespool, and a \ makes the two halves disagree silently: every camera
# answers 401 while both look correctly configured. base64 output has neither character, which is
# why the line above is the recommended way to make one. (A $ is eaten by Compose interpolation as
# well - see the SMTP_PASSWORD note above.)
GO2RTC_USERNAME=
GO2RTC_PASSWORD=

# --- Live camera view (WebRTC) ------------------------------------------------------------------
# Where the sidecar's media port is published - the only port the stack publishes for cameras.
# WebRTC media goes straight from the sidecar to the browser and cannot be proxied, so live view
# exists on this port or not at all; it hands out nothing on its own, since media needs credentials
# from a signalling exchange that goes through Homespool and its permission checks. To switch live
# view off entirely, delete the `ports:` block from the `go2rtc` service in compose.yaml; the
# still keeps working.
WEBRTC_PORT=8555

# The address a browser should send that media to. LEAVE IT EMPTY unless the next paragraph applies:
# Homespool works it out by resolving PRINTER_HOST and writes it to the sidecar at every start, so a
# moved DHCP lease fixes itself as long as PRINTER_HOST is a name rather than a fixed address.
#
# Set it when that derivation cannot be right - a router forwarding a port inward from the internet,
# a VPN or a tunnel, anything where the address a browser must use is not the address this machine
# has. Host and port together, no scheme:
#
#   WEBRTC_CANDIDATE=203.0.113.9:8555
#
# Getting it wrong is this feature's nastiest failure and worth knowing the shape of: WebRTC will
# negotiate successfully, report no error, and deliver no pictures. The page gives up after a few
# seconds and drops back to the still saying so, which is the only reason it is not silent.
WEBRTC_CANDIDATE=

# Which STUN server would be contacted IF an administrator allows it, under Live view in the
# navigation. It is off by default and nothing in this file turns it on - this only decides who
# would be asked, and the page names this address in its prompt before anyone agrees to it.
#
# STUN is what lets somebody watch from outside your own network without a forwarded address being
# named by hand; watching from your own network needs none of it. Point this at your own coturn if
# you would rather not use a public server; the default is the one go2rtc would have used anyway.
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302
