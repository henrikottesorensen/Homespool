@model BundleOffer

<div class="alert alert-success" role="alert">
    <p class="mb-1">
        <strong>@Localiser["Bundle_DownloadNow"]</strong> @Localiser["Bundle_TokenOnce"]
    </p>

    @if (Model.CanBuild)
    {
        <form method="post" asp-page="Bundle" class="mb-2">
@*  Two fields, and the id is not one the page decides: the handler checks it against whoever is
    signed in, and reads the printer's name from that row rather than from anything posted here. *@
            <input type="hidden" name="Token" value="@Model.Token" />
            <input type="hidden" name="PrinterId" value="@Model.PrinterId" />

            <div class="mb-2">
                <label for="bundle-hostname" class="form-label">
                    @Localiser["Bundle_AddressLabel"]
                </label>
                <select id="bundle-hostname" name="Hostname" class="form-select">
                    @foreach (Homespool.Host.Certificates.PrinterAddressSuggestion name in Model.Names)
                    {
                        <option value="@name.Value">@name.Value</option>
                    }
                </select>
@*  The choice between a name and an address is the choice between surviving a moved DHCP lease and
    breaking silently one day, and the classifier already knows which is which. Rendering the note
    under the select rather than inside each option keeps the sentences whole - they are too long to
    read squeezed into a dropdown, and this is the one moment they are worth reading. *@
                <div class="form-text">
                    <p class="mb-1">
                        @Localiser["Bundle_AddressHelp"]
                    </p>
                    <ul class="mb-0">
                        @foreach (Homespool.Host.Certificates.PrinterAddressSuggestion name in Model.Names)
                        {
                            <li><code>@name.Value</code> &mdash; @Localiser[name.NoteKey]</li>
                        }
                    </ul>
                </div>
            </div>

@*  The escape hatch, and only where the deployment has opened one. Two checkboxes rather than one
    and no script anywhere: the second is the confirmation, so choosing this cannot be a single
    mis-click, and both survive scripting being off. The push-back lives HERE rather than at the
    printer's socket because this is the one moment a person is present to read it - refusing the
    connection instead would cut a printer off for having been updated, unattended, and recoverable
    only by walking to it with a stick. *@
            @if (Model.CanOfferLegacyEndpoint)
            {
                <details class="mb-2">
                    <summary>@Localiser["Bundle_LegacySummary"]</summary>

                    <div class="alert alert-warning mt-2 mb-2" role="alert">
                        <p class="mb-1">@Localiser["Bundle_LegacyWhen"]</p>
                        <p class="mb-1"><strong>@Localiser["Bundle_LegacyCost"]</strong></p>

                        @if (Model.FirmwareCouldUseTls)
                        {
                            <p class="mb-0">
                                @* The firmware string is the printer's own claim about itself,
                                   not ours; Markup.Code takes it as text and encodes it. *@
                                <strong>@HtmlLocaliser["Bundle_LegacyNotNeeded", Markup.Code(Model.KnownFirmware)]</strong>
                            </p>
                        }
                    </div>

                    <div class="form-check mb-1">
                        <input class="form-check-input" type="checkbox" name="Legacy" value="true" id="bundle-legacy" />
                        <label class="form-check-label" for="bundle-legacy">
                            @HtmlLocaliser["Bundle_LegacyChoose", Model.LegacyPort!.Value]
                        </label>
                    </div>

                    <div class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" name="LegacyConfirmed" value="true" id="bundle-legacy-confirmed" />
                        <label class="form-check-label" for="bundle-legacy-confirmed">
                            @Localiser["Bundle_LegacyConfirm"]
                        </label>
                    </div>
                </details>
            }

            <button type="submit" class="btn btn-primary">@Localiser["Bundle_Download"]</button>
        </form>

        <p class="mb-2">
            @HtmlLocaliser["Bundle_UnzipToRoot", Markup.Strong(Localiser["Bundle_Root"].Value), Markup.Em("Prusa Connect → Load Settings")]
        </p>

        @if (Model.TlsEnabled)
        {
            <p class="mb-2">
                @HtmlLocaliser["Bundle_TrustStore", Markup.Code("connect.der"), Markup.Code("custom_cert = 1"), Markup.Strong(Localiser["Bundle_Replaces"].Value)]
            </p>
            <p class="mb-2">
                @HtmlLocaliser["Bundle_FirmwareFloor", Markup.Code("Bug: TLS error")]
            </p>
        }
        else
        {
            <p class="mb-2">
                <strong>@Localiser["Bundle_PlainHttp"]</strong>
                @HtmlLocaliser["Bundle_NoCertInBundle", Markup.Code("PrusaConnect:PrinterTls")]
            </p>
        }

        <details class="mb-0">
            <summary>@Localiser["Bundle_ReadIniInstead"]</summary>
            <p class="mt-2 mb-1">
                @HtmlLocaliser["Bundle_WhatFileContains", Markup.Code(Model.PreferredName), Markup.Code("hostname")]
            </p>
            <textarea class="form-control font-monospace" rows="7" readonly data-select-on-click>@Model.Snippet</textarea>
        </details>
    }
    else
    {
        <p class="mb-1">
            @Localiser["Bundle_NoReachableAddress"]
        </p>
        <p class="mb-0">
            @HtmlLocaliser["Bundle_CertIssuedTooEarly", Markup.Code("PrusaConnect:PrinterHost"), Markup.Em("Admin → Printer certificate")]
        </p>
    }
</div>
