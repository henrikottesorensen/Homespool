# The user-facing half of the deployment: pages and /api, in front of Kestrel's plain-HTTP user
# listener. Mounted read-only from ./nginx, so editing it is editing a file in the repository -
# no rebuild, just `docker compose restart proxy`.
#
# What is HERE: the two default servers that refuse an unrecognised Host, and the plain-HTTP block
# that redirects to TLS. What is NOT here: the TLS block that actually serves the site. There is one
# per name now, generated into conf.d at start by 26-user-tls-servers.sh over the body in
# homespool-user-tls.conf - the comment at the foot of this file says why. Looking for
# `client_max_body_size` or a proxy timeout means looking in that file.
#
# A TEMPLATE, and named one since 2026-08-05. It is mounted to /etc/nginx/templates and rendered into
# conf.d at start by the base image's 20-envsubst-on-templates.sh, which substitutes
# ${REDIRECT_PORT_SUFFIX} into the redirect below. That is not optional decoration: dropped straight
# into conf.d as it used to be, nginx starts perfectly happily and redirects every plain-HTTP visitor
# to a literal "https://$host${REDIRECT_PORT_SUFFIX}/..." - a URL no browser can resolve, from a
# proxy that reports itself healthy. The extension is the warning.
#
# Only ${REDIRECT_PORT_SUFFIX} and ${USER_SERVER_NAMES} are substituted; NGINX_ENVSUBST_FILTER in
# compose.yaml restricts it. Add a variable of your own here and you must add it there too, or it
# stays a literal - and conversely, widening that filter would blank every $host and $request_uri
# below.
#
# ${USER_SERVER_NAMES} is USER_HOSTS with its semicolons turned into spaces, deduplicated and with
# localhost folded in, derived by 16-user-server-names.envsh at container start. The conversion is
# why the raw variable is not used here: a semicolon ends a directive, so a two-name USER_HOSTS
# dropped straight in would make the second name an unknown directive and nginx would refuse to
# start. It already includes localhost, so nothing here should append one.
#
# Printers use this proxy but not this file. They have their own port, server block and certificate
# in homespool-printer.conf, installed alongside this one when the deployment has a printer leaf to
# serve. The two stay separate all the way down, which is why /p/* does not exist on the listener
# this proxies to and is refused below as well.

# Used by both halves of the deployment, so it lives in the file that is always installed:
# homespool-printer.conf needs it for the printer's WebSocket and may not be present at all.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Which language the holding page is served in, for @starting at the bottom of this file. A map
# because it has to be decided at http level, not where it is used.
#
# The browser is the only thing that can be asked. The application stores a language on the account
# and that is what every other page follows - but this page exists precisely when the application is
# not answering, so the account, and the database it lives in, are exactly what is unavailable. A
# reader whose account is Danish and whose browser says English gets English here, once, for as long
# as the outage lasts.
#
# QUOTED, and that is not decoration: a `;` inside an unquoted map pattern ends the directive, and
# nginx reports "invalid number of the map parameters" pointing at the line rather than at the
# character.
#
# Matches the FIRST tag only, and ignores q-values, which nginx cannot parse. Browsers send their
# list in preference order, so this agrees with them; a hand-written `en;q=0.7,da;q=0.9` gets English
# where the application itself would give Danish. The word boundary is what keeps "dansk" - a
# language tag nobody sends, but a header nobody validates either - out of the Danish arm.
map $http_accept_language $hs_starting_language {
    default                                 en;
    "~*^[\s]*da([-_][A-Za-z]+)?([,;]|$)"    da;
}

# Kept separate from the language so the file name is the only thing that knows about file names.
# English is the neutral file and takes no suffix, the same shape SharedResource.resx uses.
map $hs_starting_language $hs_starting_suffix {
    default  "";
    da       ".da";
}

# Anything whose Host this deployment does not recognise is refused here, before it can reach a
# server block that would answer it. Two of these, because a default server is per-listener.
#
# WHY: the application builds absolute URLs from Request.Host - a password-reset link most of all -
# so whoever chose the Host chose where the emailed token pointed. server_name used to be `_`, which
# matches nothing and therefore made the first block the default for everything.
#
# 444 closes the connection without a response, which is right for a forged Host and unhelpful for an
# owner who simply browsed to the machine's IP address: they get an empty reply and no reason. If
# that trade reads wrong for your deployment, `return 421;` instead - it costs an attacker nothing
# they did not already know and tells the owner what happened.
#
# So USER_HOSTS is no longer cosmetic. A name that reaches this deployment and is not in it is
# refused - which is why it is a list: a machine answering to a second DNS name or to its bare IP
# address needs every one of them named there, semicolon-separated. AllowedHosts in compose.yaml is
# composed from the same variable, since a proxy is not the only way in.
server {
    listen 8080 default_server;
    return 444;
}

server {
    listen 8443 ssl default_server;

    # A TLS default server still has to complete a handshake before it can see the Host, so a
    # certificate is unavoidable here even though the answer is always 444.
    #
    # Its own certificate, naming nothing, generated by 25-self-signed-certificate.sh. NOT one of
    # the real ones: this block answers requests whose Host this deployment does not recognise -
    # a scan of the address, a forged Host - and presenting a real certificate to them hands over
    # the name on it before the connection is dropped. On a deployment with a publicly-issued
    # certificate that is the operator's domain, disclosed to anyone who connects to the port. The
    # certificate below discloses nothing and is refused in exactly the same way.
    #
    # A browser that reaches this gets a certificate warning and then an empty reply. That is the
    # honest report of what happened: the name it asked for is not served here.
    ssl_certificate     /etc/nginx/certs/default.crt;
    ssl_certificate_key /etc/nginx/certs/default.key;

    return 444;
}

server {
    listen 8080;

    # No literal `localhost` appended here: ${USER_SERVER_NAMES} already contains it, folded in and
    # deduplicated by 16-user-server-names.envsh. Appending one is what produced
    # `conflicting server name "localhost"` at every start on the default USER_HOSTS=localhost,
    # which names it twice.
    server_name ${USER_SERVER_NAMES};

    # Not redirected, and this is the same reasoning Program.cs applies to its own redirection: a
    # monitoring probe follows nothing, and `curl --fail` treats a 301 as success - so a redirected
    # /health would report a healthy service that was never actually reached.
    location /health {
        include /etc/nginx/homespool-health-access.conf;

        set $homespool_upstream http://homespool:8080;
        include /etc/nginx/homespool-proxy.conf;

        # A 512 MB upload over a household's wifi takes longer than the 60s default allows. Set here
        # as well as on the TLS block because the include no longer carries timeouts - see its header.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Everything else goes to TLS. $host carries no port, so this needs telling which one HTTPS is
    # published on - ${REDIRECT_PORT_SUFFIX} is derived from HTTPS_PORT by
    # 15-redirect-port-suffix.envsh at container start and substituted here: empty for the standard
    # 443 so ordinary deployments get a clean URL. Setting REDIRECT_PORT_SUFFIX in .env overrides
    # the derivation, for the stack where the port a browser must ask for is not the published one.
    # It used to assume 443 with a comment telling you to edit this line; the first person to
    # publish HTTPS elsewhere read that comment only after being redirected into a closed port.
    #
    # This file is a TEMPLATE - envsubst renders it into conf.d at start. Only the variables named in
    # NGINX_ENVSUBST_FILTER are touched, which is what keeps $host and $request_uri below from being
    # blanked: unfiltered envsubst would replace every one of them with nothing and the failure would
    # look like nginx misbehaving rather than like a substitution.
    #
    # 308, not 301: a 301 permits the client to replay the request as a GET, and enough of them do
    # that it is the documented behaviour rather than a bug. A form POST that arrives over http -
    # a bookmarked link, a typed address, a client that has not learned the redirect yet - then
    # reaches the application as a GET with its body dropped, which looks like the request silently
    # doing nothing rather than like a redirect problem. 308 preserves the method and the body.
    location / {
        return 308 https://$host${REDIRECT_PORT_SUFFIX}$request_uri;
    }
}

# THE USER-FACING TLS BLOCK IS NOT HERE. It is generated, one block per name, into conf.d at
# container start by 26-user-tls-servers.sh, and each generated block includes
# homespool-user-tls.conf for the body. Edit that file to change how the site is served; edit the
# generator to change how the blocks are built.
#
# WHY IT LEFT THIS FILE: a server block carries exactly one certificate, and USER_HOSTS is a list.
# While every name shared one self-signed certificate the single block above worked, because the
# names were all subject-alternative names on it. They stop sharing one the moment a name gets a
# publicly-issued certificate: no authority will sign `homespool.lan`, so a deployment reached at
# both a public name and a LAN name needs two certificates, and nginx chooses between them per
# server block, by SNI.
#
# The plain-HTTP block above keeps the whole list, because it presents no certificate and has
# nothing to choose between.
