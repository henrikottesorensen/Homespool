#!/bin/sh
# A host where OUR OWN compose network is up, so Docker has created a route for its bridge. That
# route is in the table because the network exists - it is not somebody else occupying the range.
case "$*" in
    *"route get"*) echo "1.1.1.1 via 192.168.13.1 dev wlan0 src 192.168.13.183 uid 1000" ;;
    *"addr show"*)
        cat <<'EOF'
1: lo    inet 127.0.0.1/8 scope host lo\       valid_lft forever preferred_lft forever
2: wlan0    inet 192.168.13.183/24 brd 192.168.13.255 scope global dynamic wlan0\       valid_lft 5000sec
3: br-2deab6694565    inet 172.28.0.1/16 brd 172.28.255.255 scope global br-2deab6694565\       valid_lft forever
EOF
        ;;
    *"route show"*)
        cat <<'EOF'
default via 192.168.13.1 dev wlan0 proto dhcp src 192.168.13.183 metric 600
172.28.0.0/16 dev br-2deab6694565 proto kernel scope link src 172.28.0.1
192.168.13.0/24 dev wlan0 proto kernel scope link src 192.168.13.183 metric 600
EOF
        ;;
esac
