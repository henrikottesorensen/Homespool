@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = Localiser["Account_ResetPasswordConfirmTitle"].Value;
}

<h1>@ViewData["Title"]</h1>
<p>
    @HtmlLocaliser["Account_PasswordReset", Markup.Link(Url.Page("./Login"), Localiser["Account_ClickToLogIn"].Value)]
</p>
@* Worded without reference to the account - a reset is spent with only an emailed link in hand, and
   naming the account back at the person confirms nothing they did not just prove. *@
<p>
    @HtmlLocaliser["Account_TokensRevoked", $"{Localiser["Manage_AccountMenu"].Value} › {Localiser["Manage_ApiTokens"].Value}"]
</p>
@* Passkeys are not revoked by a reset - they are the person's own sign-in, not a machine's - but a
   reset is the path somebody takes after a compromise, and a passkey the other party added is what
   they need to go and look for. Generic for the same reason as the paragraph above. *@
<p>
    @HtmlLocaliser["Account_ReviewPasskeysAfterReset", $"{Localiser["Manage_AccountMenu"].Value} › {Localiser["Manage_Passkeys"].Value}"]
</p>
