@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Mvc.ViewEngines
@inject IWebHostEnvironment Environment
@inject ICompositeViewEngine Engine
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Homespool</title>

    @* Browsers that understand an SVG icon prefer it and scale it cleanly; the .ico is the
       fallback, and carries a simplified cut of the mark because the full one turns to mush
       below about 24px. *@
    <link rel="icon" href="~/img/homespool-icon.svg" type="image/svg+xml" />
    <link rel="icon" href="~/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />

    <script>
        // Follow the browser/OS colour-scheme preference using Bootstrap 5.3 colour modes. Inline and
        // early so the theme is set before first paint (no flash), and updated live if the OS switches.
        (function () {
            var mql = window.matchMedia("(prefers-color-scheme: dark)");
            var apply = function (dark) { document.documentElement.setAttribute("data-bs-theme", dark ? "dark" : "light"); };
            apply(mql.matches);
            mql.addEventListener("change", function (e) { apply(e.matches); });
        })();
    </script>

    <environment include="Development">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
        <link rel="stylesheet" href="~/css/site.css" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    </environment>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm bg-body-tertiary border-bottom box-shadow mb-3">
            <div class="container">
                @* The mark and the wordmark are one link, not two: a screen reader would otherwise
                   announce the same destination twice and a keyboard user would tab through it
                   twice. d-inline-flex to centre the mark against the text rather than sit it on
                   the baseline. *@
                <a class="navbar-brand d-inline-flex align-items-center" href="~/">
                    <partial name="_BrandMark" />
                    Homespool
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="@Localiser["Nav_ToggleNavigation"]">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex flex-sm-row-reverse">
                    @{
                        var result = Engine.FindView(ViewContext, "_LoginPartial", isMainPage: false);
                    }
                    @if (result.Success)
                    {
                        await Html.RenderPartialAsync("_LoginPartial");
                    }
                    else
                    {
                        throw new InvalidOperationException("The default Identity UI layout requires a partial view '_LoginPartial' " +
                            "usually located at '/Pages/_LoginPartial' or at '/Views/Shared/_LoginPartial' to work. Based on your configuration " +
                            $"we have looked at it in the following locations: {System.Environment.NewLine}{string.Join(System.Environment.NewLine, result.SearchedLocations)}.");
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <partial name="_CookieConsentPartial" optional />
        @* Above the page body on every page, because the failure it exists for is one the app gives
           no other sign of: printing carries on, pages render, and nothing is being recorded. *@
        @await Component.InvokeAsync("HealthBanner")
        <main role="main" class="pb-1">
            @RenderBody()
        </main>
    </div>
    <footer class="footer border-top pl-3 text-muted">
        <div class="container">
@*  A range, not a single year, and not DateTime.Now.Year: it says when the work was done rather
    than what today's date is. Started over the 2025 holidays; nearly all of it is 2026. Bump the
    second year when a year sees work.

    The name links to the source, which is the AGPL's own suggestion for a program that talks to
    people over a network: section 13 obliges an operator to offer their users the source of what
    they are running, and the licence text proposes exactly this - "its interface could display a
    'Source' link that leads users to an archive of the code".

    It points upstream, which is right for a deployment running this code unmodified and wrong for
    one running a fork - section 13 is about *the running version*. Hardcoded rather than
    configurable because every deployment today is unmodified; the day someone ships a fork, this
    becomes a setting. *@
        &copy; 2025-2026 <a href="https://github.com/henrikottesorensen/Homespool" target="_blank" rel="noopener" title="@Localiser["Nav_GitHub"]">Homespool</a>
            @{
                var foundPrivacy = Url.Page("/Privacy", new { area = "" });
            }
            @if (foundPrivacy != null)
            {
                <a asp-area="" asp-page="/Privacy">@Localiser["Nav_Privacy"]</a>
            }
        </div>
    </footer>

    <environment include="Development">
        <script src="~/lib/jquery/dist/jquery.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
    </environment>
    @*
        Local, not a CDN, and that is a deliberate reversal of the scaffold's default.

        This is a self-hosted appliance whose whole job is to run on a LAN with printers on it. A
        deployment with no route to the internet is an ordinary deployment here, not a degraded one,
        and the CDN arrangement made every production page load depend on reaching cdnjs.cloudflare.com
        and cdn.jsdelivr.net before falling back. The files are already vendored - libman.json pins
        them and the fallback pointed at them - so serving them directly costs nothing and removes
        two third parties from the page.

        It also fixes two things that were quietly wrong. The CDN pinned jQuery 3.5.1 while
        wwwroot/lib holds 3.7.1, so production ran a 2020 build, development ran a 2023 one, and a
        CDN outage silently swapped production onto a version its integrity hash did not cover. And
        the stylesheet's fallback test asked for the class "sr-only", which Bootstrap 5 renamed to
        "visually-hidden" - so the test could never pass and production loaded the local copy on top
        of the CDN one every time.

        This is also what makes a real Content-Security-Policy affordable: with no third-party
        script hosts, script-src reduces to 'self' plus a nonce for the colour-mode block in <head>.
    *@
    <environment exclude="Development">
        <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
    </environment>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
