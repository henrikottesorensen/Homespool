{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PrinterServiceDb": "Data Source=PrinterService.Sqlite"
  },
  "Storage": {
    "AutoMigrate": true,
    "TelemetryRetentionDays": 14,
    "MinimumSampleIntervalSeconds": 0,
    "WriteBatchSize": 500,
    "WriteFlushIntervalSeconds": 2,
    "BusyTimeoutMilliseconds": 5000
  },
  "PrusaConnect": {
    "RegistrationCodeLifetimeMinutes": 60
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseImplicitTls": false,
    "UserName": "",
    "Password": "set-via-Smtp__Password-env-var-or-user-secrets",
    "FromAddress": "",
    "FromName": "PrinterService",
    "TimeoutSeconds": 30,
    "ProbeOnStartup": true
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "Override": {
      "Microsoft": "Warning",
      "System": "Warning"
    }
  }
}
