# Brings the Homespool stack up on every boot, and configures it on the first one.
#
# Not a "firstboot" unit in the run-once-and-disable sense despite the name: every step here is
# idempotent and reconciling the stack on each boot is what makes a power-cut recover by itself.
#
# This used to drive homespool-firstboot.sh, which carried its own copy of the address detection -
# find this machine's address, filter out Docker's own ranges, write PRINTER_HOST. setup-env.sh does
# that better, because it asks the Docker daemon which ranges are actually allocated instead of
# excluding 172.16/12 wholesale, so a board on a legitimate 172.x LAN is no longer refused its own
# address. One implementation, tested, rather than two that could drift.
[Unit]
Description=Homespool first-boot setup and stack start
# docker.service, not docker.socket: this calls the CLI, and socket activation would have it race the
# daemon's own startup on a Pi 3, where that is slow enough to lose.
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

# In [Unit], not [Service] - systemd moved these long ago, and in [Service] they are an unknown
# lvalue: warned about once in the journal and then ignored, leaving the default limit in force.
# Zero disables it, because the retry below may need to run for hours while nobody is looking.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/homespool

# The container images are ALREADY in /var/lib/docker - pi/build.sh loaded them into this card's
# Docker store while building it, so this normally does nothing. It fires only if somebody has
# deliberately staged a tarball: a hand-built card, or a rescue after a bad bake. No tarball ships.
#
# Guarded on the file's own presence rather than a stamp, and it removes the tarball on success, so
# the once-only-ness is carried by the evidence rather than by remembering.
ExecStartPre=/bin/sh -c 'test ! -f homespool-images.tar.gz || { docker load -i homespool-images.tar.gz && rm -f homespool-images.tar.gz; }'

# Both flags, and neither is optional here.
#
# --no-prompt answers from what the board can detect, and exits NON-ZERO when it cannot find an
# address a printer could reach, which is what the Restart= below depends on.
#
# --no-overwrite is what makes this safe to run on every boot with no stamp file: it fills in
# settings that have no value yet and never changes one that does. Without it a moved DHCP lease
# would silently rewrite PRINTER_HOST on some later boot, under a printer certificate that was
# minted once and cannot follow it - so every provisioning bundle would name an address the
# certificate does not cover, and nothing would say so.
ExecStart=/opt/homespool/setup-env.sh --no-prompt --no-overwrite

# --no-build is load-bearing. compose.yaml still carries a `build:` section for developers, and its
# context is the repository, which is not on this card. Without this a missing image sends compose
# looking for a source tree that was never shipped, and it fails describing a build error rather
# than the actual fault.
ExecStart=/usr/bin/docker compose up -d --no-build

# Keep trying rather than retiring on the first attempt. setup-env.sh --no-prompt fails, instead of
# succeeding quietly, when there is no address yet - which covers the case that actually happened on
# hardware: a board whose wi-fi never associated, being marked *Finished*, and then ignoring the
# ethernet cable plugged in five minutes later. It needed a power cycle to notice.
#
# The rate limit that would otherwise stop this after five attempts is disabled in [Unit] above.
Restart=on-failure
RestartSec=30s

# The database migration on a Pi 3 is the slow part - the container images are already unpacked in
# /var/lib/docker at build time, so nothing is loaded here. Still generous: a timeout part-way
# through a migration is worse than waiting.
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
