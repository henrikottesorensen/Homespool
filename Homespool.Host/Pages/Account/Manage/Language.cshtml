@page
@model LanguageModel

@{
    ViewData["Title"] = Localiser["Language_Heading"].Value;
}

<h1>@ViewData["Title"]</h1>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <p class="text-body-secondary">@Localiser["Language_Description"]</p>
        <form id="language-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            @foreach (var option in Model.Options)
            {
                @* Radios rather than a select: there are three choices and the difference between
                   "follow my browser" and "English" is worth being able to see at once rather than
                   discovering by opening a list. *@
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" asp-for="Selected"
                           id="language-@(option.Value.Length == 0 ? "auto" : option.Value)"
                           value="@option.Value" />
                    <label class="form-check-label"
                           for="language-@(option.Value.Length == 0 ? "auto" : option.Value)">@option.Text</label>
                </div>
            }
            <button id="language-submit" type="submit" class="w-100 btn btn-lg btn-primary mt-3">@Localiser["Language_Save"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
