#!/bin/sh
# Recorded from `netstat -rn -f inet` on macOS 24.6. The abbreviated destinations are the point:
# BSD prints "192.168.13" for a /24, and "224.0.0/4" where the prefix is not a whole number of
# octets. A parser that takes these literally reads every route as a /32.
cat <<'EOF'
Routing tables

Internet:
Destination        Gateway            Flags               Netif Expire
default            192.168.13.1       UGScg                 en0
127                127.0.0.1          UCS                   lo0
127.0.0.1          127.0.0.1          UH                    lo0
169.254            link#14            UCS                   en0      !
192.168.13         link#14            UCS                   en0      !
192.168.13.1/32    link#14            UCS                   en0      !
192.168.13.238     00:00:5e:00:53:0e  UHLWIi                lo0
224.0.0/4          link#14            UmCS                  en0      !
255.255.255.255/32 link#14            UCS                   en0      !
EOF
