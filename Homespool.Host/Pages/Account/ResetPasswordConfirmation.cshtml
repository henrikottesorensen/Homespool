@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = Localiser["Account_ResetPasswordConfirmTitle"].Value;
}

<h1>@ViewData["Title"]</h1>
<p>
    @Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["Account_PasswordReset"].Value, $"<a href=\"{Url.Page("./Login")}\">{Localiser["Account_ClickToLogIn"].Value}</a>"))
</p>
@* Worded without reference to the account - this page is reached by anyone who submits the form,
   including for an address that does not exist, so anything specific would confirm whether it did. *@
<p>
    @Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["Account_TokensRevoked"].Value, $"{Localiser["Manage_AccountTitle"].Value} &rsaquo; {Localiser["Manage_ApiTokens"].Value}"))
</p>
