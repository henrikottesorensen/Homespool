@page
@model ReauthenticateModel
@{
    ViewData["Title"] = Localiser["Reauthenticate_Title"].Value;
}

<h1>@ViewData["Title"]</h1>

@* Inline rather than the _StatusMessage partial: a refusal here is a warning, not a success. *@
@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-warning" role="alert">@Model.StatusMessage</div>
}

<div class="row">
    <div class="col-md-6">
        <p class="text-muted">@Localiser["Reauthenticate_Explanation"]</p>

        @if (Model.UsesPassword)
        {
            <form id="password-form" method="post" asp-route-returnUrl="@Model.ReturnUrl" class="mb-3">
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" autofocus placeholder="@Localiser["Common_PasswordPlaceholder"]" />
                    <label asp-for="Input.Password" class="form-label"></label>
                </div>
                <button type="submit" class="btn btn-primary">@Localiser["Reauthenticate_Confirm"]</button>
            </form>
        }

        @if (Model.PasskeysAvailable)
        {
            @* The same script and the same shape as the login page's button: hidden until the script
               finds a browser that can run the ceremony, the form carrying the antiforgery token for
               both the challenge and the answer. *@
            <form id="passkey-form" method="post" asp-page-handler="Passkey" asp-route-returnUrl="@Model.ReturnUrl" class="mb-3"
                  data-passkey-options="@Url.Page("./Reauthenticate", LoginModel.PasskeyOptionsHandler)"
                  data-passkey-cancelled="@Localiser["Account_PasskeyCancelled"]">
                <input type="hidden" name="@Homespool.Host.Authentication.PasskeyCredential.FormField" value="" />
                <button id="passkey-signin" type="submit" class="btn btn-outline-primary" hidden>@Localiser["Reauthenticate_WithPasskey"]</button>
                <p id="passkey-error" class="text-danger mt-2" role="alert" hidden></p>
            </form>
        }

        @foreach (var scheme in Model.Providers)
        {
            <form method="post" asp-page-handler="Provider" asp-route-returnUrl="@Model.ReturnUrl" class="mb-3">
                <input type="hidden" name="provider" value="@scheme.Name" />
                <button type="submit" class="btn btn-outline-primary">@Localiser["StepUp_ProviderConfirm", scheme.DisplayName ?? scheme.Name]</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.PasskeysAvailable)
    {
        <script src="~/js/passkey-signin.js" asp-append-version="true"></script>
    }
}
