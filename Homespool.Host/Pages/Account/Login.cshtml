@page
@model LoginModel

@{
    ViewData["Title"] = Localiser["Account_LogIn"].Value;
}

<h1>@ViewData["Title"]</h1>
<div class="row">
    <div class="col-md-4">
        <section>
            <form id="account" method="post">
                <h2>@Localiser["Account_LogInHelp"]</h2>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Login" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Login" class="form-label"></label>
                    <span asp-validation-for="Input.Login" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="@Localiser["Common_PasswordPlaceholder"]" />
                    <label asp-for="Input.Password" class="form-label"></label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="checkbox mb-3">
                    <label asp-for="Input.RememberMe" class="form-label">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <div>
                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">@Localiser["Account_LogIn"]</button>
                </div>
                <div>
                    <p>
                        <a id="forgot-password" asp-page="./ForgotPassword">@Localiser["Account_ForgotPassword"]</a>
                    </p>
                    <p>
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">@Localiser["Account_ResendConfirmation"]</a>
                    </p>
                </div>
            </form>
        </section>

        @if (Model.PasskeysAvailable)
        {
            @* The other local way in. The button stays hidden until passkey-signin.js finds a browser
               that can run the ceremony; there is no no-script path for WebAuthn to fall back to. The
               form posts the assertion the script fills in, so the antiforgery token guards both the
               challenge and the answer. *@
            <section id="passkey-section">
                <form id="passkey-form" method="post" asp-page-handler="Passkey" asp-route-returnUrl="@Model.ReturnUrl"
                      data-passkey-options="@Url.Page("./Login", "PasskeyOptions")"
                      data-passkey-cancelled="@Localiser["Account_PasskeyCancelled"]">
                    <input type="hidden" name="@Homespool.Host.Authentication.PasskeyAuthenticationOptions.CredentialFormField" value="" />
                    <input type="hidden" name="rememberMe" value="false" />
                    <div class="mt-3">
                        <button id="passkey-signin" type="submit" class="w-100 btn btn-lg btn-outline-primary" hidden>@Localiser["Account_SignInWithPasskey"]</button>
                    </div>
                    <p id="passkey-error" class="text-danger mt-2" role="alert" hidden></p>
                </form>
            </section>
        }

        @if (Model.ExternalLogins is { Count: > 0 })
        {
            @* The other way in. Which accounts a provider sign-in may create is decided in
               ExternalLogin's callback, not here - this only offers the round trip. *@
            <section id="external-login-section">
                <hr />
                <h2 class="h5">@Localiser["Account_OrSignInWith"]</h2>
                <form id="external-login-form" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    @foreach (var provider in Model.ExternalLogins)
                    {
                        <button id="@($"external-login-{provider.Name}")" type="submit" class="w-100 btn btn-lg btn-outline-primary"
                                name="provider" value="@provider.Name"
                                title="@Localiser["Account_SignInWithProviderTitle", provider.DisplayName ?? provider.Name]">@provider.DisplayName</button>
                    }
                </form>
            </section>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.PasskeysAvailable)
    {
        <script src="~/js/passkey-signin.js" asp-append-version="true"></script>
    }
}
