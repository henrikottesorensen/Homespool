@model BundleOffer

<div class="alert alert-success" role="alert">
    <p class="mb-1">
        <strong>@Localiser["Bundle_DownloadNow"]</strong> @Localiser["Bundle_TokenOnce"]
    </p>

    @if (Model.CanBuild)
    {
        <form method="post" asp-page="Bundle" class="mb-2">
            <input type="hidden" name="Token" value="@Model.Token" />
            <input type="hidden" name="PrinterId" value="@Model.PrinterId" />
            <input type="hidden" name="PrinterName" value="@Model.PrinterName" />

            <div class="mb-2">
                <label for="bundle-hostname" class="form-label">
                    @Localiser["Bundle_AddressLabel"]
                </label>
                <select id="bundle-hostname" name="Hostname" class="form-select">
                    @foreach (Homespool.Host.Certificates.PrinterAddressSuggestion name in Model.Names)
                    {
                        <option value="@name.Value">@name.Value</option>
                    }
                </select>
@*  The choice between a name and an address is the choice between surviving a moved DHCP lease and
    breaking silently one day, and the classifier already knows which is which. Rendering the note
    under the select rather than inside each option keeps the sentences whole - they are too long to
    read squeezed into a dropdown, and this is the one moment they are worth reading. *@
                <div class="form-text">
                    <p class="mb-1">
                        @Localiser["Bundle_AddressHelp"]
                    </p>
                    <ul class="mb-0">
                        @foreach (Homespool.Host.Certificates.PrinterAddressSuggestion name in Model.Names)
                        {
                            <li><code>@name.Value</code> &mdash; @name.Note</li>
                        }
                    </ul>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">@Localiser["Bundle_Download"]</button>
        </form>

        <p class="mb-2">
            @Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["Bundle_UnzipToRoot"].Value, $"<strong>{Localiser["Bundle_Root"].Value}</strong>", "<em>Prusa Connect &rarr; Load Settings</em>"))
        </p>

        @if (Model.TlsEnabled)
        {
            <p class="mb-2">
                @Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["Bundle_TrustStore"].Value, "<code>connect.der</code>", "<code>custom_cert = 1</code>", $"<strong>{Localiser["Bundle_Replaces"].Value}</strong>"))
            </p>
        }
        else
        {
            <p class="mb-2">
                <strong>@Localiser["Bundle_PlainHttp"]</strong>
                (<code>PrusaConnect:PrinterTls</code> is false), so the bundle carries no certificate
                and this printer's token will cross the network in clear.
            </p>
        }

        <details class="mb-0">
            <summary>@Localiser["Bundle_ReadIniInstead"]</summary>
            <p class="mt-2 mb-1">
                @Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["Bundle_WhatFileContains"].Value, $"<code>{Model.PreferredName}</code>", "<code>hostname</code>"))
            </p>
            <textarea class="form-control font-monospace" rows="7" readonly onclick="this.select()">@Model.Snippet</textarea>
        </details>
    }
    else
    {
        <p class="mb-1">
            This printer is provisioned, but no bundle can be built: the certificate carries no address a
            printer could actually reach.
        </p>
        <p class="mb-0">
            @Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["Bundle_CertIssuedTooEarly"].Value, "<code>PrusaConnect:PrinterHost</code>", "<em>Admin &rarr; Printer certificate</em>"))
        </p>
    }
</div>
