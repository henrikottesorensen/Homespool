#!/bin/sh
# `hostname -I` is the fallback when there is no default route. It offers everything the host holds,
# including Docker's own addresses and link-local - which is exactly what has to be filtered out.
case "$*" in
    -I) echo "192.168.13.238 172.17.0.1 169.254.1.1 127.0.0.1 " ;;
    *)  echo "testbox" ;;
esac
