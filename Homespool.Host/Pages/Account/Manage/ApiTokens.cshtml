@page
@model ApiTokensModel
@{
    ViewData["Title"] = Localiser["Manage_ApiTokens"].Value;
}

<h1>@ViewData["Title"]</h1>
<partial name="_StatusMessage" for="StatusMessage" />

<p class="text-muted">
    @Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["Tokens_Explanation"].Value, "<code>Authorization: Bearer &lt;token&gt;</code>"))
</p>

@if (Model.CreatedToken is not null)
{
    <div class="alert alert-success" role="alert">
        <h2 class="alert-heading h4">@Localiser["Tokens_CopyNow"]</h2>
        <p>@Localiser["Tokens_ShownOnce"]</p>
        <pre class="mb-0"><code id="created-token">@Model.CreatedToken</code></pre>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <form id="create-token-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Name" class="form-control" autocomplete="off" aria-required="true" placeholder="@Localiser["Manage_TokenNamePlaceholder"]" />
                <label asp-for="Input.Name" class="form-label"></label>
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>

            <fieldset class="mb-3">
                <legend class="fs-6 fw-semibold">@Localiser["Tokens_ScopeLegend"]</legend>
                <p class="text-muted small">@Localiser["Tokens_ScopeHint"]</p>
                <span asp-validation-for="Input.Scope" class="text-danger d-block mb-2"></span>

                @* Real submits with their own handlers, so they set the boxes with scripting off too.
                   token-scope.js cancels the post and does it here instead; formnovalidate is for the
                   case where that file is the one thing that did not load, so the fallback is not then
                   blocked by a name nobody has typed yet. *@
                <div class="d-flex gap-2 mb-3">
                    <button type="submit" asp-page-handler="TickAll" formnovalidate
                            data-tick-all="Input.Scope"
                            class="btn btn-sm btn-outline-secondary">@Localiser["Tokens_TickAll"]</button>
                    <button type="submit" asp-page-handler="UntickAll" formnovalidate
                            data-untick-all="Input.Scope"
                            class="btn btn-sm btn-outline-secondary">@Localiser["Tokens_UntickAll"]</button>
                </div>

                @foreach (var group in Homespool.Host.Localisation.CapabilityText.Groups)
                {
                    <div class="mb-2">
                        <div class="form-label small text-uppercase text-muted">@Model.Capabilities.Group(group.groupKey)</div>
                        @foreach (var capability in group.capabilities)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="Input.Scope"
                                       value="@capability" id="scope-@capability"
                                       checked="@(Model.Input.Scope.Contains(capability))" />
                                <label class="form-check-label" for="scope-@capability">
                                    @Model.Capabilities.For(capability)
                                </label>
                            </div>
                        }
                    </div>
                }
            </fieldset>

            <button type="submit" class="w-100 btn btn-lg btn-primary">@Localiser["Tokens_Create"]</button>
        </form>
    </div>
</div>

<h2 class="mt-4">@Localiser["Tokens_Yours"]</h2>

@if (Model.Tokens.Count == 0)
{
    <p class="text-muted">@Localiser["Tokens_None"]</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">@Localiser["Common_Name"]</th>
                <th scope="col">@Localiser["Tokens_ScopeColumn"]</th>
                <th scope="col">@Localiser["Tokens_Created"]</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var token in Model.Tokens)
        {
            <tr>
                <td class="typed-name">@token.Name</td>
                <td class="small">@Model.Capabilities.Describe(token.Scope)</td>
                <td>@token.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                <td class="text-end">
                    <form method="post" asp-page-handler="Revoke">
                        <input type="hidden" name="id" value="@token.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">@Localiser["Tokens_Revoke"]</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/token-scope.js" asp-append-version="true"></script>
}
