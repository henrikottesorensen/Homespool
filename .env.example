# Copy this file to .env and fill in the values you need:
#
#     cp .env.example .env
#
# .env is gitignored, so secrets stay out of the repository. docker compose reads it
# automatically - you should not need to edit compose.yaml.
#
# Leaving SMTP_HOST empty is a supported configuration. The server then runs with no outgoing
# mail: new accounts are created already confirmed, and password reset is unavailable.

# Host ports for people. The stack ships an nginx that terminates TLS and passes plain HTTP to the
# app over its own network; the app's port is not published at all, so the proxy is the only way in.
#
# HTTP is redirected to HTTPS, except /health - a monitoring probe follows nothing, and curl --fail
# counts a redirect as success, so a redirected health check would report a service it never reached.
# (The redirect itself is a 308, not a 301: 301 lets a client replay a POST as a GET and drop the
# body, which looks like the request quietly doing nothing.)
#
# If you publish HTTPS somewhere other than 443, set HTTPS_PORT_SUFFIX below to match. The redirect
# cannot work it out - $host carries no port - so it is told, and told once.
PORT=80
HTTPS_PORT=443

# The port the HTTP listener redirects to, as a suffix. Empty for the standard 443, so an ordinary
# deployment gets https://homespool/ rather than https://homespool:443/ in every address bar. Set it
# to match HTTPS_PORT otherwise - ":8443" for HTTPS_PORT=8443 - or plain-HTTP visitors are redirected
# to a port with nothing behind it.
#
# It is a second setting for something the line above already knows, which this file otherwise avoids.
# The reason is that the two are not the same fact: HTTPS_PORT is where Docker publishes the port on
# THIS machine, and the redirect needs the port a BROWSER should dial - and those differ the moment
# anything sits in front, a router forwarding 443 inward or a tunnel. Deriving one from the other
# would be right until it silently was not.
HTTPS_PORT_SUFFIX=

# Names the self-signed certificate the proxy generates on first start. Cosmetic - a browser warns
# about a self-signed certificate whatever name it carries. To use a real one, put homespool.crt and
# homespool.key into the homespool-proxy-certs volume and restart the proxy; nginx does not care
# where a certificate came from, which is the whole reason the stack ships nginx rather than
# something that insists on fetching one.
USER_HOST=localhost

# The address printers dial to reach this server - required for USB-key provisioning (Printers ->
# Add printer won't produce a snippet without it). Printers connect to this container directly,
# so this is this machine's own name or LAN address, NOT a proxy's: the printer listener serves a
# certificate this deployment mints itself, and putting a proxy in front of it breaks the
# handshake the firmware requires.
#
# Set it before the first start if you can. The certificate is issued once, on the first run,
# covering every address this machine can see plus whatever this says - so setting it first means
# it is covered by construction rather than by luck.
PRINTER_HOST=

# Port printers dial, published by the proxy - which terminates their TLS too, on a different port
# and with a completely different certificate from the browser's. Not 443: that belongs to the
# people-facing side above, where a port number in the URL would be a daily annoyance for everyone
# in the house. A printer's port costs nobody anything - it is written into the generated ini and
# typed by no one, since the firmware's own hostname field is read-only.
PRINTER_PORT=15443

# Whether printers use TLS to reach PRINTER_HOST. One switch, both ends: it is the tls line in every
# provisioning ini AND whether a certificate is issued for the proxy to present, so the two cannot
# disagree - with it off nothing is issued and the proxy has nothing to serve.
#
# false is a testing setting - for reading the protocol on the wire, since a capture of the TLS path
# is ciphertext, or for a rig that would otherwise have to be taught to trust a private CA. Setting
# it here is only half of it: in Compose, bring the stack up with the plaintext override as well, or
# the printer port is published by a proxy that will not serve it.
#
#   docker compose -f compose.yaml -f compose.plaintext.yaml up
#
# It puts every printer token on the network in clear, in both directions, and the server says so at
# every startup. Not for a deployment, LAN-only included: the LAN is where the token is worth taking.
#
# It says nothing about whether the web UI is served over TLS - that half is unaffected either way.
PRINTER_TLS=true

# Mail server hostname. Empty disables outgoing mail entirely.
SMTP_HOST=

# 587 for submission with STARTTLS, 465 for implicit TLS, 25 for unencrypted.
SMTP_PORT=587

# true for implicit TLS (port 465), false to upgrade via STARTTLS (port 587).
SMTP_USE_IMPLICIT_TLS=false

# Username for SMTP AUTH. Empty connects without authenticating.
SMTP_USERNAME=

# Password for SMTP AUTH. This is why .env is gitignored - keep it out of compose.yaml.
SMTP_PASSWORD=

# Envelope sender address. Falls back to SMTP_USERNAME when empty.
SMTP_FROM_ADDRESS=

# Display name on outgoing mail.
SMTP_FROM_NAME=Homespool

# Connect and authenticate once at startup to report a broken configuration early. Diagnostic
# only - it never changes behaviour. Set false if your mail server is in this same compose
# stack and starts after this container, since the probe would warn about a transient state.
SMTP_PROBE_ON_STARTUP=true

# --- Reverse proxy ---------------------------------------------------------------------------
# The network Homespool's own containers share, and the range whose forwarded headers are
# believed. These two MUST agree: PROXY_NETWORK is what the application trusts, PROXY_SUBNET is
# what Docker actually allocates.
#
# Leave PROXY_NETWORK empty and the forwarded-headers middleware is not registered at all. That is
# the safe state, not a broken one - but behind a reverse proxy it means links in outgoing mail
# will say http:// and logged client addresses will be the proxy's. The application says so at
# startup rather than leaving you to notice.
#
# NEVER widen this to "trust everything" to make it work. A forwarded header is just a request
# header: anything trusted here can tell Homespool who the client is.
#
# The same range answers a second question: which addresses exist only inside the stack. Detection
# from inside a container sees the container, so this is what stops the provisioning page offering an
# address no printer on your network can route to. Both uses read this one value, so changing the
# subnet cannot leave one of them behind.
PROXY_SUBNET=172.28.0.0/16
PROXY_NETWORK=172.28.0.0/16

# --- Telemetry storage -------------------------------------------------------------------------
# A floor, in seconds, on how often each printer's telemetry is written to the database. 0 stores
# every sample, which is the default and what you want on a machine with an ordinary disk.
#
# Raise it if Homespool runs on an SD card. Telemetry is by far the largest source of writes, a
# printer reports roughly once a second, and SD cards wear out by being written to. A value of 10
# removes about 90% of those writes and still leaves a graph you can read - the cost is resolution,
# so a spike shorter than the interval may not be recorded at all.
#
# Deleting old data is not a substitute: retention deletes are writes too.
TELEMETRY_MIN_SAMPLE_INTERVAL_SECONDS=0

# --- Cameras ------------------------------------------------------------------------------------
# Cameras are added in Homespool, not here: it registers them with the go2rtc sidecar for you. This
# is only the address of that sidecar, and the default is right unless you renamed the service.
#
# A camera plugged into this machine needs one uncommented line in compose.yaml - see the `go2rtc`
# service - because a device that does not exist stops the container from starting, so it cannot be
# enabled by default. Everything reachable over the network (RTSP, ONVIF, an HTTP snapshot) needs
# nothing here at all.
CAMERA_STREAM_SERVER_BASE_URL=http://go2rtc:1984

# A floor, in seconds, on how often each camera is re-read while somebody is watching. Frames are
# only fetched while a page is open, so a camera nobody is looking at costs nothing.
#
# Lower means a livelier picture and more CPU: measured on a Raspberry Pi 4, one H.264 RTSP camera
# costs about 1.4 seconds of CPU per frame and a USB camera far less. The default is chosen to sit
# just under a typical RTSP camera's own acquisition time, so it is not the limiting factor.
CAMERA_REFRESH_FLOOR_SECONDS=2

# How old a frame may be before it is thrown away rather than shown, in seconds.
#
# This is a safety setting, not a performance one. Frames are only captured while someone is
# looking, so a camera nobody has opened for a day still holds yesterday's picture in memory - and a
# day-old photograph of a clear print bed looks exactly like a current one. Past this age the
# picture is discarded and the page says it is capturing instead.
CAMERA_MAX_AGE_SECONDS=60
