@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        // The application's own shared layout. This previously pointed at
        // /Areas/Identity/Pages/_Layout.cshtml, which the Identity.UI package supplied - removing
        // that package took the file with it, and since no page sets ParentLayout, every page under
        // Account/Manage fell into this branch and failed to render at all.
        Layout = "/Pages/Shared/_Layout.cshtml";
    }
}

<h1>Manage your account</h1>

<div>
    <h2>Change your account settings</h2>
    <hr />
    <div class="row">
        <div class="col-md-3">
            <partial name="_ManageNav" />
        </div>
        <div class="col-md-9">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
