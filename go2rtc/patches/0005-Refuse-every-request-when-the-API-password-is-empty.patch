Date: Sat, 3 Oct 2026 01:40:29 +0000
Subject: [PATCH] Refuse every request when the API password is empty

Setting api.username switches authentication on, and the check compares
the request's password with the configured one. With no password
configured, a request carrying the username and an empty password
matches, so the API is open to anyone who knows the username.

That happens without anyone choosing it: a config that sets the
password from ${VAR:} resolves to empty when the variable is missing,
and a config file that fails to parse is skipped with a warning, leaving
the username from another source and no password.

Treat an empty password as no credential at all: every request is
refused, and a warning at startup says why.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 internal/api/api.go       |  6 +++++-
 internal/api/auth_test.go | 45 +++++++++++++++++++++++++++++++++++++++
 2 files changed, 50 insertions(+), 1 deletion(-)
 create mode 100644 internal/api/auth_test.go

diff --git a/internal/api/api.go b/internal/api/api.go
index dfb6511..367fc6b 100644
--- a/internal/api/api.go
+++ b/internal/api/api.go
@@ -66,6 +66,9 @@ func Init() {
 	}
 
 	if cfg.Mod.Username != "" {
+		if cfg.Mod.Password == "" {
+			log.Warn().Msg("[api] username is set but password is empty, so every request will be refused")
+		}
 		Handler = middlewareAuth(cfg.Mod.Username, cfg.Mod.Password, cfg.Mod.LocalAuth, Handler) // 2nd
 	}
 
@@ -213,7 +216,8 @@ func middlewareAuth(username, password string, localAuth bool, next http.Handler
 	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
 		if localAuth || !isLoopback(r.RemoteAddr) {
 			user, pass, ok := r.BasicAuth()
-			if !ok || user != username || pass != password {
+			// An empty password is a credential nobody was given, not one everybody has
+			if !ok || password == "" || user != username || pass != password {
 				w.Header().Set("Www-Authenticate", `Basic realm="go2rtc"`)
 				http.Error(w, "Unauthorized", http.StatusUnauthorized)
 				return
diff --git a/internal/api/auth_test.go b/internal/api/auth_test.go
new file mode 100644
index 0000000..ee1631d
--- /dev/null
+++ b/internal/api/auth_test.go
@@ -0,0 +1,45 @@
+package api
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func authStatus(username, password string, request func(r *http.Request)) int {
+	next := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusOK)
+	})
+
+	r := httptest.NewRequest("GET", "/api/streams", nil)
+	r.RemoteAddr = "192.0.2.1:1234"
+	request(r)
+
+	w := httptest.NewRecorder()
+	middlewareAuth(username, password, true, next).ServeHTTP(w, r)
+	return w.Code
+}
+
+func TestAuthAcceptsTheConfiguredCredential(t *testing.T) {
+	status := authStatus("admin", "secret", func(r *http.Request) { r.SetBasicAuth("admin", "secret") })
+	require.Equal(t, http.StatusOK, status)
+}
+
+func TestAuthRefusesAWrongPassword(t *testing.T) {
+	status := authStatus("admin", "secret", func(r *http.Request) { r.SetBasicAuth("admin", "wrong") })
+	require.Equal(t, http.StatusUnauthorized, status)
+}
+
+func TestAuthWithAnEmptyPasswordRefusesEveryRequest(t *testing.T) {
+	for name, request := range map[string]func(r *http.Request){
+		"the username and an empty password": func(r *http.Request) { r.SetBasicAuth("admin", "") },
+		"the username and a password":        func(r *http.Request) { r.SetBasicAuth("admin", "secret") },
+		"no credential at all":               func(r *http.Request) {},
+	} {
+		t.Run(name, func(t *testing.T) {
+			require.Equal(t, http.StatusUnauthorized, authStatus("admin", "", request))
+		})
+	}
+}
