@model DetailModel
@{
    var uuid = Model.Statistics.Printer.Uuid;
}

@* Reordering and cancelling are edits to a list - nothing here reaches the printer. The producer
   loop is what turns the head of this queue into a transfer and a print, and it advances only when
   the printer is Ready, which only a person sets. *@
@if (Model.Queue.Count == 0)
{
    <p>
        @HtmlLocaliser["Printers_NothingQueued", Markup.Link(Url.Page("/Files/Index"), Localiser["Files_Title"].Value)]
    </p>
}
else
{
    @* The roles are for below the phone breakpoint, where site.css lays each entry out as a block
       of its own: Safari stops announcing a table once its rows are given another display, and the
       explicit roles keep it one. *@
    <table class="table table-sm w-auto align-middle queue-table" role="table">
        <thead role="rowgroup">
            <tr role="row">
                <th scope="col" role="columnheader">#</th>
                <th scope="col" role="columnheader">@Localiser["Common_File"]</th>
                <th scope="col" class="text-end" role="columnheader">@Localiser["Files_Size"]</th>
                <th scope="col" role="columnheader">@Localiser["Common_Queued"]</th>
                <th scope="col" role="columnheader">@Localiser["Queue_QueuedBy"]</th>
                <th scope="col" role="columnheader">@Localiser["Common_Status"]</th>
                @if (Model.QueueHasActions)
                {
                    <th scope="col" role="columnheader"><span class="visually-hidden">@Localiser["Common_Actions"]</span></th>
                }
            </tr>
        </thead>
        <tbody role="rowgroup">
            @for (int index = 0; index < Model.Queue.Count; index++)
            {
                var job = Model.Queue[index];

                <tr role="row">
                    @* The row's place in the list, not its stored Position - cancelling leaves gaps in
                       those, deliberately, and a gap shown to a person reads as a bug. *@
                    <td class="queue-position" role="cell">@(index + 1)</td>
                    <td class="typed-name queue-name" role="cell">@(job.File?.Name ?? "(missing)")</td>
                    <td class="text-end queue-meta" role="cell">@($"{(job.File?.Size ?? 0) / 1024.0:N0} KiB")</td>

                    @* Fixed format rather than a culture-dependent one, matching the Files table -
                       and ToLocalTime, without which this column rendered UTC while the print history
                       below it rendered local, two hours apart on the same page. *@
                    <td class="queue-meta" role="cell">@job.QueuedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>

                    @* Whose work this is. The loop sends as whoever queued it, so this is also who
                       the permission will be checked against when it goes. data-label is the column
                       heading again, for the phone layout, where there is no heading above it and a
                       bare account name among a size and a date says nothing about why it is there. *@
                    <td class="typed-name queue-meta queue-by" role="cell" data-label="@Localiser["Queue_QueuedBy"]">@Model.QueuedByDescription(job)</td>

                    @* Derived on every read - the entry stores no state. Only the head is ever
                       anything but waiting, because the loop never looks past it. *@
                    <td class="queue-meta" role="cell">@Model.QueueStatusText(Model.QueueStatusOf(index))</td>

                    @* Reordering moves everybody's work, so it is ControlPrinter's; removing an entry
                       is Print's for your own and ControlPrinter's for anybody's. A row with neither
                       keeps its empty cell so the columns still line up. *@
                    @if (Model.QueueHasActions)
                    {
                        <td class="text-nowrap queue-actions" role="cell">
                            @if (Model.CanControlPrinter)
                            {
                                <form method="post" asp-page-handler="Move" asp-route-uuid="@uuid"
                                      class="d-inline">
                                    <input type="hidden" name="printUuid" value="@job.PrintUuid" />
                                    <input type="hidden" name="position" value="@(index - 1)" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                                            title="@Localiser["Printers_MoveUp"]" aria-label="@Localiser["Printers_MoveJobUp", job.File?.Name ?? string.Empty]"
                                            @(index == 0 ? "disabled" : string.Empty)>&uarr;</button>
                                </form>
                                <form method="post" asp-page-handler="Move" asp-route-uuid="@uuid"
                                      class="d-inline">
                                    <input type="hidden" name="printUuid" value="@job.PrintUuid" />
                                    <input type="hidden" name="position" value="@(index + 1)" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                                            title="@Localiser["Printers_MoveDown"]" aria-label="@Localiser["Printers_MoveJobDown", job.File?.Name ?? string.Empty]"
                                            @(index == Model.Queue.Count - 1 ? "disabled" : string.Empty)>&darr;</button>
                                </form>
                            }
                            @if (Model.CanWithdraw(job))
                            {
                                <form method="post" asp-page-handler="Cancel" asp-route-uuid="@uuid"
                                      class="d-inline">
                                    <input type="hidden" name="printUuid" value="@job.PrintUuid" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            aria-label="@Localiser["Printers_RemoveJob", job.File?.Name ?? string.Empty]">@Localiser["Cameras_Remove"]</button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
