{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PrinterServiceDb": "Data Source=PrinterService.Sqlite"
  },
  "Storage": {
    "AutoMigrate": true,
    "TelemetryRetentionDays": 14,
    "MinimumSampleIntervalSeconds": 0,
    "WriteBatchSize": 500,
    "WriteFlushIntervalSeconds": 2,
    "BusyTimeoutMilliseconds": 5000
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "Override": {
      "Microsoft": "Warning",
      "System": "Warning"
    }
  }
}
