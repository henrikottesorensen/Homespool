From: =?UTF-8?q?Henrik=20O=2E=20S=C3=B8rensen?= <henrik.sorensen@gmail.com>
Date: Sun, 27 Sep 2026 12:31:30 +0200
Subject: [PATCH] Add missing Huffman tables to stream.mjpeg frames

api/frame.jpeg repairs AVI1 frames via FixJPEG, adding the standard DHT
tables that MJPEG cameras omit. api/stream.mjpeg writes frames through
unrepaired, and Apple's JPEG decoder fails outright on most such frames
where libjpeg-turbo and ffmpeg supply the standard tables - so in Safari
the stream downloads fine and paints nothing, with no error, while Chrome
and Firefox render it normally.

The stream uses InjectDHT rather than FixJPEG. FixJPEG also decodes and
re-encodes any frame whose header is neither JFIF, Exif nor AVI1, which
is cheap for one snapshot and not for every frame of a stream: measured
on a Raspberry Pi 3 at 640x480 and 24 fps, such a camera took a full core
per viewer and fell to 10.5 fps. InjectDHT adds the tables only to a
frame that has none and never re-encodes; a Logitech C910 costs about
1.5% of a core more per viewer with it.

Frames that already carry tables pass through untouched, Content-Length
is written after the repair so part framing stays correct, and Write
still reports the length it was given.

writer_test.go checks both: a frame without tables comes out decoding -
Go's decoder, like Apple's, refuses one that lacks them - with a
Content-Length that counts them, and a complete frame comes out byte for
byte.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 pkg/mjpeg/writer.go      | 12 +++++-
 pkg/mjpeg/writer_test.go | 89 ++++++++++++++++++++++++++++++++++++++++
 2 files changed, 99 insertions(+), 2 deletions(-)
 create mode 100644 pkg/mjpeg/writer_test.go

diff --git a/pkg/mjpeg/writer.go b/pkg/mjpeg/writer.go
index 8845bf2..50a5ba2 100644
--- a/pkg/mjpeg/writer.go
+++ b/pkg/mjpeg/writer.go
@@ -20,10 +20,18 @@ type writer struct {
 }
 
 func (w *writer) Write(p []byte) (n int, err error) {
+	// Safari can't decode JPEG without DHT (AVI1 MJPEG from USB cams).
+	// InjectDHT rather than FixJPEG, which api/frame.jpeg uses: it adds the
+	// standard tables only to a frame that has none and never re-encodes,
+	// where FixJPEG re-encodes every frame whose header it does not know -
+	// cheap once per snapshot, a full CPU core per viewer on a stream.
+	// - https://github.com/pion/mediadevices/pull/493
+	frame := InjectDHT(p)
+
 	w.buf = w.buf[:len(header)]
-	w.buf = append(w.buf, strconv.Itoa(len(p))...)
+	w.buf = append(w.buf, strconv.Itoa(len(frame))...)
 	w.buf = append(w.buf, "\r\n\r\n"...)
-	w.buf = append(w.buf, p...)
+	w.buf = append(w.buf, frame...)
 	w.buf = append(w.buf, "\r\n"...)
 
 	// Chrome bug: mjpeg image always shows the second to last image
diff --git a/pkg/mjpeg/writer_test.go b/pkg/mjpeg/writer_test.go
new file mode 100644
index 0000000..c1dc171
--- /dev/null
+++ b/pkg/mjpeg/writer_test.go
@@ -0,0 +1,89 @@
+package mjpeg
+
+import (
+	"bytes"
+	"image"
+	"image/color"
+	"image/jpeg"
+	"net/http/httptest"
+	"strconv"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// A frame as a USB camera sends it: a baseline JPEG with its DHT segments left out.
+// Go's decoder, like Apple's, will not decode it - which is the failure the writer
+// has to repair.
+func frameWithoutDHT(t *testing.T) []byte {
+	img := image.NewRGBA(image.Rect(0, 0, 32, 24))
+	for y := 0; y < 24; y++ {
+		for x := 0; x < 32; x++ {
+			img.Set(x, y, color.RGBA{R: uint8(x * 8), G: uint8(y * 10), B: 128, A: 255})
+		}
+	}
+
+	var buf bytes.Buffer
+	require.NoError(t, jpeg.Encode(&buf, img, nil))
+
+	b := buf.Bytes()
+	out := append([]byte{}, b[:2]...) // SOI
+	for i := 2; i < len(b); {
+		require.Equal(t, byte(0xFF), b[i])
+		if b[i+1] == markerSOS {
+			out = append(out, b[i:]...)
+			break
+		}
+		size := 2 + (int(b[i+2])<<8 | int(b[i+3]))
+		if b[i+1] != markerDHT {
+			out = append(out, b[i:i+size]...)
+		}
+		i += size
+	}
+
+	_, err := jpeg.Decode(bytes.NewReader(out))
+	require.Error(t, err, "the frame must lack its tables, or its repair proves nothing")
+
+	return out
+}
+
+// The one part a single Write produces, as a stream.mjpeg viewer receives it.
+func writeOnePart(t *testing.T, frame []byte) (body []byte, declared int) {
+	rec := httptest.NewRecorder()
+	_, err := NewWriter(rec).Write(frame)
+	require.NoError(t, err)
+
+	part := rec.Body.Bytes()
+	require.True(t, bytes.HasPrefix(part, []byte(header)))
+
+	rest := part[len(header):]
+	end := bytes.Index(rest, []byte("\r\n\r\n"))
+	require.Positive(t, end)
+
+	declared, err = strconv.Atoi(string(rest[:end]))
+	require.NoError(t, err)
+
+	body = rest[end+4:]
+	require.True(t, bytes.HasSuffix(body, []byte("\r\n")))
+
+	return body[:len(body)-2], declared
+}
+
+func TestWriterAddsMissingTables(t *testing.T) {
+	body, declared := writeOnePart(t, frameWithoutDHT(t))
+
+	require.Equal(t, len(body), declared, "Content-Length must count the tables added")
+
+	img, err := jpeg.Decode(bytes.NewReader(body))
+	require.NoError(t, err, "the frame a viewer receives must decode")
+	require.Equal(t, image.Rect(0, 0, 32, 24), img.Bounds())
+}
+
+func TestWriterLeavesACompleteFrameAlone(t *testing.T) {
+	complete := InjectDHT(frameWithoutDHT(t))
+
+	body, declared := writeOnePart(t, complete)
+
+	require.Equal(t, complete, body)
+	require.Equal(t, len(complete), declared)
+}
