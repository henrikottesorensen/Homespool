<Project>

    <!--
        Settings every project in this repository shares. MSBuild imports this before each .csproj,
        so a project can still override anything here.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>

        <!--
            Stated rather than defaulted. Without this every assembly carried 1.0.0 - the SDK's
            default, which nobody chose and which claims a finished product; this project has no
            release and no git tag at all. The version argument reads it, so somebody sees it.

            (Note for anyone editing this comment: a doubled hyphen cannot appear inside an XML
            comment, so the argument is named in prose here. Writing it out makes this file fail to
            parse, and the error that follows is NETSDK1013 "TargetFramework value '' was not
            recognized" on every project - naming neither this file nor the reason.)

            The commit is NOT set here. SourceLink ships inside the SDK and resolves SourceRevisionId
            from the repository, which the SDK appends as "+<sha>", so every local build is already
            stamped. A container build is the exception, because .dockerignore excludes **/.git: the
            Dockerfile passes the value in as a SourceRevisionId environment variable instead, since
            MSBuild reads environment variables as properties. See Homespool.Host/BuildInformation.cs.
        -->
        <VersionPrefix>0.0.1</VersionPrefix>

        <!-- Nothing here is allowed to accumulate warnings, so they are failures. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!--
            Load-bearing: without it the compiler does not bind cref attributes at all, so every XML
            doc diagnostic is silently absent - including the ones .editorconfig asks for by name.
            Severity there filters diagnostics; only this produces them.
        -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!--
            The same story one level up. .editorconfig configures ~50 IDE#### rules, several at error
            severity - the var bans, using placement, file-scoped namespaces - and not one of them ran
            until this was set, because severity is a filter and this is the switch.
        -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <!--
            Forensics for the Razor-cascade investigation - notes/housekeeping.md, "One C# error can
            present as a storm of Razor errors". When the cascade fires, the errors point into
            generated code that otherwise exists only inside the compiler server's memory; with this
            on, the generator's actual output is on disk under obj/**/generated/, so a poisoned
            build's generated source can be read and diffed against a clean build's.

            In the props file rather than the flight recorder's own -p flag deliberately: a property
            on the command line makes CLI and IDE builds disagree, and every switch between them
            would recompile the world. Here every build agrees.

            Costs a little IO per build, and note the emitted tree is never cleaned - a deleted page
            leaves its stale .g.cs behind. That is forensic noise, not a build input; the SDK does
            not compile from this directory. Remove when the investigation ends.
        -->
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    </PropertyGroup>

    <!--
        Every test run writes a .trx, without anyone asking for one.

        A run reduced to its summary line cannot say which test failed: the summary is the one part
        of the output with no test name in it. That matters for a failure that appears once in
        several runs, where the run that catches it is rarely the one somebody was watching. The
        file survives whatever the caller does with stdout, so attributing a failure does not
        depend on having expected it.

        Named per project so the pruning below is per project - a long E2E run's evidence should
        not be deleted by a unit-test run that finishes after it.
    -->
    <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Test'))">
        <VSTestLogger>trx%3BLogFileName=$(MSBuildProjectName)_$([System.DateTime]::Now.ToString('yyyyMMdd_HHmmss')).trx</VSTestLogger>
        <VSTestResultsDirectory>$(MSBuildThisFileDirectory)TestResults</VSTestResultsDirectory>
    </PropertyGroup>

    <!--
        Keeps the three most recent runs per test project. Enough to compare a failure against the
        runs either side of it, which is what a flake needs, without accumulating a file per run
        forever in a directory nobody looks at.

        Not run on Windows: nothing here is developed or built there, and the cost of skipping it is
        an ignored directory growing. ContinueOnError because losing old results must never fail a
        test run - the results being pruned are the least valuable thing in the room.
    -->
    <Target Name="PruneOldTestResults" AfterTargets="VSTest" Condition="'$(OS)' != 'Windows_NT'">
        <Exec Command="ls -1t &quot;$(VSTestResultsDirectory)&quot;/$(MSBuildProjectName)_*.trx 2>/dev/null | tail -n +4 | while read -r stale; do rm -f &quot;$stale&quot;; done"
              ContinueOnError="true"
              StandardOutputImportance="low" />
    </Target>

    <ItemGroup>
        <!--
            Everywhere, so style is enforced uniformly rather than per-project. The "Unstable" package
            is the one that understands modern C#: stable 1.1.118 predates file-scoped namespaces,
            records and collection expressions.
        -->
        <PackageReference Include="StyleCop.Analyzers.Unstable" Version="1.2.0.556">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <!--
            The using layout StyleCop cannot express: System, then third party, then Homespool, as
            blocks separated by a blank line. SA1210 has to be off for it, which .editorconfig says
            more about. Everywhere for the same reason StyleCop is everywhere.
        -->
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <PackageReference Include="UsingLayoutAnalyser" Version="0.3.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
