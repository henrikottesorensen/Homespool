@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Reset password confirmation";
}

<h1>@ViewData["Title"]</h1>
<p>
    Your password has been reset. Please <a asp-page="./Login">@Localiser["Account_ClickToLogIn"]</a>.
</p>
@* Worded without reference to the account - this page is reached by anyone who submits the form,
   including for an address that does not exist, so anything specific would confirm whether it did. *@
<p>
    Any API tokens on the account have been revoked. Scripts using one will need a new token, which
    you can create under Account &rsaquo; API tokens.
</p>
