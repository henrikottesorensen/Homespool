@page
@model Homespool.Host.Pages.Cameras.IndexModel
@using Homespool.Host.Cameras
@{
    ViewData["Title"] = Localiser["Cameras_Title"].Value;
}

<h1>@ViewData["Title"]</h1>

@if (Model.Message is not null)
{
    <div class="alert alert-success" role="alert">@Model.Message</div>
}
@if (Model.Warning is not null)
{
    <div class="alert alert-warning" role="alert">@Model.Warning</div>
}
@if (Model.Error is not null)
{
    <div class="alert alert-danger" role="alert">@Model.Error</div>
}

@if (Model.Cameras.Count == 0)
{
    <p class="text-body-secondary">@Localiser["Cameras_None"]</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">@Localiser["Common_Name"]</th>
                    <th scope="col">@Localiser["Cameras_Source"]</th>
                    <th scope="col">@Localiser["Common_Printer"]</th>
                    <th scope="col">@Localiser["Cameras_Picture"]</th>
                    <th scope="col"><span class="visually-hidden">@Localiser["Cameras_Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var camera in Model.Cameras)
                {
                    var age = Model.FrameAge(camera);
                    <tr>
                        <td class="typed-name">
                            @Model.DisplayName(camera)
                            @if (Homespool.Host.Pages.Cameras.IndexModel.IsAttached(camera))
                            {
                                @* Attached cameras are the server's, not a team's - worth saying so
                                   where somebody is deciding whether they may remove one. *@
                                <span class="badge border border-secondary text-body-secondary ms-1">@Localiser["Cameras_Attached"]</span>
                            }
                        </td>
                        <td><code class="small">@CameraSourceDisplay.WithoutCredential(camera.Source)</code></td>
                        <td class="typed-name">@(camera.Printer?.Name ?? camera.Printer?.Model ?? "—")</td>
                        <td>
                            @if (age is null)
                            {
                                <span class="text-body-secondary">@Localiser["Cameras_NoPictureYet"]</span>
                            }
                            else
                            {
                                <span>@Localiser["Cameras_Seen", age]</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary"
                               asp-page="/Cameras/Index" asp-route-edit="@camera.Uuid">@Localiser["Cameras_Edit"]</a>
                            <form method="post" asp-page-handler="Delete" class="d-inline">
                                <input type="hidden" name="uuid" value="@camera.Uuid" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">@Localiser["Cameras_Remove"]</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.Editing is not null)
{
    <h2 class="h5 mt-4">@Localiser["Cameras_EditHeading"]</h2>
    <form method="post" asp-page-handler="Edit" class="row g-2 align-items-end">
        <input type="hidden" name="uuid" value="@Model.Editing.Uuid" />

        <div class="col-md-3">
            <label class="form-label" for="edit-name">@Localiser["Common_Name"]</label>
            <input class="form-control" id="edit-name" name="name" value="@Model.Editing.Name" />
        </div>

        <div class="col-md-5">
            <label class="form-label" for="edit-source">@Localiser["Cameras_Source"]</label>
            <input class="form-control" id="edit-source" name="source" value="@Model.EditingSource" required />
        </div>

        @* Only for a camera plugged into this server: a network camera's size is set on the camera
           itself, by whichever of a dozen mechanisms its firmware provides, and nothing here can
           reach it. The list is what the camera reports; the default entry is always available,
           including for a camera the stream server has not enumerated. *@
        @if (Homespool.Host.Pages.Cameras.IndexModel.IsAttached(Model.Editing))
        {
            <div class="col-md-2">
                <label class="form-label" for="edit-resolution">@Localiser["Cameras_Resolution"]</label>
                <select class="form-select" id="edit-resolution" name="resolution">
                    <option value="">@Localiser["Cameras_ResolutionDefault"]</option>
                    @foreach (var size in Model.EditingResolutions)
                    {
                        <option value="@size" selected="@(size == Model.Editing.Resolution)">@size</option>
                    }
                    @* A size chosen before the camera was re-enumerated, or on another machine, must
                       still show as selected rather than silently reverting to the default. *@
                    @if (Model.Editing.Resolution is { Length: > 0 } current && !Model.EditingResolutions.Contains(current))
                    {
                        <option value="@current" selected>@current</option>
                    }
                </select>
            </div>
        }

        <div class="col-md-2">
            <label class="form-label" for="edit-printer">@Localiser["Common_Printer"]</label>
            <select class="form-select" id="edit-printer" name="printerId">
                <option value="">@Localiser["Common_None"]</option>
                @foreach (var printer in Model.Printers)
                {
                    <option value="@printer.Id" selected="@(printer.Id == Model.Editing.PrinterId)">
                        @(printer.Name ?? printer.Model ?? printer.Uuid.ToString())
                    </option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">@Localiser["Common_Save"]</button>
            <a class="btn btn-link" asp-page="/Cameras/Index">@Localiser["Common_Cancel"]</a>
        </div>
    </form>
}

@if (Model.Teams.Count > 0)
{
    <h2 class="h5 mt-4">@Localiser["Cameras_AddNetwork"]</h2>
    @* Formatted rather than split into "before" and "after" keys: a sentence broken around its
       own markup only reassembles correctly in languages that share English word order. The raw
       write is safe because both halves are ours - a resource string and a literal - and neither
       comes from a request. *@
    <p class="text-body-secondary small">
        @Html.Raw(string.Format(
            System.Globalization.CultureInfo.CurrentCulture,
            Localiser["Cameras_NetworkHelp"].Value,
            "<code>rtsp://192.168.1.50/live</code>"))
    </p>

    <form method="post" asp-page-handler="AddNetwork" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="add-name">@Localiser["Common_Name"]</label>
            <input class="form-control" id="add-name" name="name" placeholder="Core One" />
        </div>

        <div class="col-md-4">
            <label class="form-label" for="add-source">@Localiser["Cameras_Address"]</label>
            <input class="form-control" id="add-source" name="source"
                   placeholder="rtsp://192.168.1.50/live" required />
        </div>

        <div class="col-md-2">
            <label class="form-label" for="add-team">@Localiser["Common_Team"]</label>
            <select class="form-select" id="add-team" name="teamId">
                @foreach (var team in Model.Teams)
                {
                    <option value="@team.Id">@(team.Name ?? $"Team {team.Id}")</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label" for="add-printer">@Localiser["Common_Printer"]</label>
            <select class="form-select" id="add-printer" name="printerId">
                <option value="">@Localiser["Common_None"]</option>
                @foreach (var printer in Model.Printers)
                {
                    <option value="@printer.Id">@(printer.Name ?? printer.Model ?? printer.Uuid.ToString())</option>
                }
            </select>
        </div>

        <div class="col-md-1">
            <button type="submit" class="btn btn-primary">@Localiser["Common_Add"]</button>
        </div>
    </form>
}

@* Absent entirely for anyone who could not claim one, and absent when there is nothing free to
   claim - a control that cannot act explains nothing. *@
@if (Model.IsAdministrator && Model.AvailableDevices.Count > 0)
{
    <h2 class="h5 mt-4">@Localiser["Cameras_AddAttached"]</h2>
    <p class="text-body-secondary small">@Localiser["Cameras_AttachedHelp"]</p>

    <form method="post" asp-page-handler="AddAttached" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="attach-name">@Localiser["Common_Name"]</label>
            <input class="form-control" id="attach-name" name="name" placeholder="@Localiser["Cameras_NamePlaceholder"]" />
        </div>

        <div class="col-md-4">
            <label class="form-label" for="attach-device">@Localiser["Cameras_Device"]</label>
            <select class="form-select" id="attach-device" name="device" required
                    data-resolution-target="attach-resolution">
                @foreach (var device in Model.AvailableDevices)
                {
                    @* The sizes ride along on the option so the select beside this can be
                       repopulated without a round trip. Empty for a device the stream server has
                       not enumerated - see the rescan button below. *@
                    <option value="@device.Name"
                            data-sizes="@(Model.DeviceResolutions.TryGetValue(device.Name, out var sizes) ? string.Join(' ', sizes) : string.Empty)">@device.Description</option>
                }
            </select>
        </div>

        @* "Whatever the camera provides" is the default and always available: a camera the stream
           server has not enumerated still has to be addable, and no size at all is a valid source. *@
        <div class="col-md-2">
            <label class="form-label" for="attach-resolution">@Localiser["Cameras_Resolution"]</label>
            <select class="form-select" id="attach-resolution" name="resolution">
                <option value="">@Localiser["Cameras_ResolutionDefault"]</option>
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label" for="attach-team">@Localiser["Common_Team"]</label>
            <select class="form-select" id="attach-team" name="teamId">
                @foreach (var team in Model.Teams)
                {
                    <option value="@team.Id">@(team.Name ?? $"Team {team.Id}")</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label" for="attach-printer">@Localiser["Common_Printer"]</label>
            <select class="form-select" id="attach-printer" name="printerId">
                <option value="">@Localiser["Common_None"]</option>
                @foreach (var printer in Model.Printers)
                {
                    <option value="@printer.Id">@(printer.Name ?? printer.Model ?? printer.Uuid.ToString())</option>
                }
            </select>
        </div>

        <div class="col-md-1">
            <button type="submit" class="btn btn-primary">@Localiser["Common_Add"]</button>
        </div>
    </form>

    @* Its own form, because it is a different action with a different cost - and the cost is in the
       button's own help text rather than a surprise, following the Set Ready and STUN prompts. The
       stream server reads the device list once per process, so a camera plugged in after it started
       cannot appear any other way. *@
    <form method="post" asp-page-handler="Rescan" class="mt-2">
        <button type="submit" class="btn btn-outline-secondary btn-sm">@Localiser["Cameras_Rescan"]</button>
        <span class="text-body-secondary small ms-2">@Localiser["Cameras_RescanHelp"]</span>
    </form>
}
else if (Model.IsAdministrator)
{
    <p class="text-body-secondary small mt-4">
        @Localiser["Cameras_NoneUnclaimed"]
        @Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["Cameras_DeviceLineIn"].Value, "<code>devices:</code>", "<code>compose.yaml</code>"))
    </p>
}

@section Scripts {
    <script src="~/js/camera-resolution.js" asp-append-version="true"></script>
}
