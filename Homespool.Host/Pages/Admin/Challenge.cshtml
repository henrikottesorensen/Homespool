@page
@model Homespool.Host.Pages.Admin.ChallengeModel
@{
    ViewData["Title"] = Localiser["AdminChallenge_Title"].Value;
}

<h1>@ViewData["Title"]</h1>

@* Inline rather than the _StatusMessage partial, which lives under Account/Manage and is not on
   this folder's search path. A refusal here is a warning, not a success. *@
@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-warning" role="alert">@Model.StatusMessage</div>
}

<div class="row">
    <div class="col-md-6">
        <p class="text-muted">@Localiser["AdminChallenge_Explanation"]</p>

        @if (!Model.UsesPassword)
        {
            @* No password to prove, so the provider does the proving: a round trip that ends back
               here with a confirmation the button below spends. Its own form, since a form cannot
               nest in the confirm form. *@
            <p class="form-text">@Localiser["StepUp_ProviderWhy", Model.Providers.Count > 0 ? (Model.Providers[0].DisplayName ?? Model.Providers[0].Name) : Localiser["StepUp_YourProvider"].Value]</p>
            @foreach (var scheme in Model.Providers)
            {
                <form method="post" asp-page-handler="Reauthenticate" asp-route-returnUrl="@Model.ReturnUrl" class="mb-3">
                    <input type="hidden" name="provider" value="@scheme.Name" />
                    <button type="submit" class="btn btn-outline-primary">@Localiser["StepUp_ProviderConfirm", scheme.DisplayName ?? scheme.Name]</button>
                </form>
            }
        }

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            @if (Model.UsesPassword)
            {
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" autofocus placeholder="@Localiser["Common_PasswordPlaceholder"]" />
                    <label asp-for="Input.Password" class="form-label"></label>
                </div>
            }

            <button type="submit" class="btn btn-primary">@Localiser["AdminChallenge_Confirm"]</button>
        </form>
    </div>
</div>
