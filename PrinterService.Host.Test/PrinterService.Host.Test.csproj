<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" Version="9.5.0" />
        <PackageReference Include="AwesomeAssertions.Analyzers" Version="9.0.8">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <!-- Used only for pure interface stubs with no behaviour of their own. Doubles that actually
             simulate something - FakeWebSocketPipe (a real System.IO.Pipelines.Pipe, so a test can
             split a message mid-UTF8-character) and the MessageDispatcher subclasses - stay
             hand-rolled: a substitute cannot fragment a byte stream, and substituting a concrete
             class's virtuals is where this library gets fragile. The analyzer catches the main
             footgun, substituting a non-virtual member and silently getting nothing. -->
        <PackageReference Include="NSubstitute" Version="6.0.0" />
        <PackageReference Include="NSubstitute.Analyzers.CSharp" Version="1.0.17">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Only used by JsonDotNetDeserialiseTests, which exists to compare Json.NET against
             System.Text.Json on the framings the printer actually sends. Production code uses
             System.Text.Json exclusively, so this reference belongs here and not in Api. -->
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="xunit" Version="2.9.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\PrinterService.Host\PrinterService.Host.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="example.nd.json" />
      <Content Include="example.newlinedelimited.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <None Remove="example.concatinated.json" />
      <Content Include="example.concatenated.json">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
      <!-- A real capture from a Prusa Core One (2025-12-22), credentials/identity fields
           redacted - see CaptureReplayTests for why. -->
      <Content Include="websocket.capture">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
