@page
@using Homespool.Host.Configuration
@model SettingsModel
@{
    ViewData["Title"] = Localiser["Settings_Title"].Value;
}

<h1>@ViewData["Title"]</h1>

<p class="text-body-secondary">@Localiser["Settings_Intro"]</p>

<p class="text-body-secondary">@Localiser["Settings_AppliesNote"]</p>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert @(Model.StatusSuccess ? "alert-success" : "alert-warning")" role="alert">@Model.StatusMessage</div>
}

@if (Model.AwaitingConfirmation.Count > 0)
{
    @* The whole form is replaced rather than shown alongside: the question is about the values that
       were just submitted, and leaving the fields editable underneath would let them drift between
       being asked and answering. *@
    <div class="alert alert-warning" role="alert">
        <h2 class="h5">@Localiser["Settings_ConfirmHeading"]</h2>

        @foreach (EditableSetting setting in Model.AwaitingConfirmation)
        {
            <p class="mb-2">@Localiser[setting.ConfirmOnEnableKey!]</p>
        }
    </div>

    <form method="post">
        @foreach (var pair in Model.Values)
        {
            <input type="hidden" name="Values[@pair.Key]" value="@pair.Value" />
        }

        @foreach (EditableSetting setting in Model.AwaitingConfirmation)
        {
            <input type="hidden" name="Confirmed" value="@setting.Path" />
        }

        <button type="submit" class="btn btn-warning">@Localiser["Settings_ConfirmButton"]</button>
        <a class="btn btn-outline-secondary" asp-page="/Admin/Settings">@Localiser["Settings_ConfirmCancel"]</a>
    </form>

    return;
}

<form method="post">
    @foreach (var section in Model.Sections)
    {
        @* A card per section, because the headings alone did not read as boundaries: everything sat
           at one weight in a single column and a reader could not see where one group ended. The
           outline is what says "these belong together". *@
        <div class="card mb-4">
            <div class="card-header">
                <h2 class="h4 mb-0">@Localiser["Settings_Section_" + section.Key]</h2>
            </div>
            <div class="card-body">
                @{ var firstSubsection = true; }

                @foreach (var subsection in section.GroupBy(setting => setting.DisplaySubgroup))
                {
                    @if (subsection.Key is not null)
                    {
                        <h3 class="h6 text-body-secondary text-uppercase @(firstSubsection ? "" : "mt-4 pt-3 border-top")">
                            @Localiser["Settings_Subsection_" + subsection.Key]
                        </h3>
                    }

                    firstSubsection = false;

                    @foreach (EditableSetting setting in subsection)
                    {
                        var path = setting.Path;
                        var id = path.Replace(':', '-');
                        var error = Model.Errors.TryGetValue(path, out var message) ? message : null;
                        var type = setting.OptionsType.GetProperty(setting.Key)?.PropertyType;
                        var isFlag = type == typeof(bool);
                        var isNumber = type is not null && type != typeof(bool) && type != typeof(string);

                        <div class="mb-3">
                            <label class="form-label" for="@id">@Localiser["Settings_Label_" + id.Replace('-', '_')]</label>

                            @if (isFlag)
                            {
                                <select class="form-select @(error is null ? "" : "is-invalid")"
                                        style="max-width: 12rem"
                                        id="@id"
                                        name="Values[@path]">
                                    <option value="false" selected="@(!string.Equals(Model.Values.GetValueOrDefault(path), "true", StringComparison.OrdinalIgnoreCase))">@Localiser["Settings_Off"]</option>
                                    <option value="true" selected="@(string.Equals(Model.Values.GetValueOrDefault(path), "true", StringComparison.OrdinalIgnoreCase))">@Localiser["Settings_On"]</option>
                                </select>
                            }
                            else
                            {
                                @* Numbers get a field the size of the answer. A full-width box for "2"
                                   reads as though a paragraph were expected. *@
                                <input class="form-control @(error is null ? "" : "is-invalid")"
                                       style="@(isNumber ? "max-width: 12rem" : null)"
                                       id="@id"
                                       name="Values[@path]"
                                       type="@(setting.IsSecret ? "password" : "text")"
                                       autocomplete="@(setting.IsSecret ? "new-password" : "off")"
                                       value="@Model.Values.GetValueOrDefault(path)" />
                            }

                            @if (error is not null)
                            {
                                <div class="invalid-feedback d-block">@error</div>
                            }

                            @{ var size = Model.SizeHint(setting); }
                            @if (size is not null)
                            {
                                <div class="form-text">@size</div>
                            }

                            @* Only the exceptions carry a badge. Saying "applies immediately" on
                               two dozen fields buried the two that do not, so the ordinary case is
                               stated once above the form and absence means it. *@
                            @if (setting.Grade != SettingGrade.Live)
                            {
                                <div class="form-text">
                                    <span class="badge text-bg-warning">@Model.AppliesWhen(setting)</span>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">@Localiser["Settings_Save"]</button>
        @* Tests what is on the form rather than what is running, which is the only useful question
           for a setting that needs a restart. Saves nothing. *@
        <button type="submit" class="btn btn-outline-secondary" asp-page-handler="TestMail">@Localiser["Settings_TestMail"]</button>
    </div>
</form>
