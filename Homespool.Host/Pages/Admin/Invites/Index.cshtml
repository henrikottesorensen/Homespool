@page
@model IndexModel
@{
    ViewData["Title"] = "Invitations";
}

<h1>@ViewData["Title"]</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success" role="alert">@Model.StatusMessage</div>
}

<p>
    <a class="btn btn-primary" asp-page="Create">@Localiser["Invites_Create"]</a>
</p>

@if (Model.Invitations.Count == 0)
{
    <p>@Localiser["Invites_None"]</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>@Localiser["Account_Email"]</th>
                <th>@Localiser["Invites_Target"]</th>
                <th>@Localiser["Common_Status"]</th>
                <th>@Localiser["Common_Created"]</th>
                <th>@Localiser["Common_Expires"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var invite in Model.Invitations)
        {
            var status = IndexModel.StatusOf(invite);
            <tr>
                <td>@invite.Email</td>
                <td>@Model.TargetOf(invite)</td>
                <td>@status</td>
                @* Fixed big-endian format rather than "g", which is mixed-endian on an
                   invariant-culture container: 08/12/2026 is August to it and December to most of
                   the people reading it. Matches the Files and print-history tables. *@
                <td>@invite.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                <td>@invite.ExpiresAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                <td>
                    @if (status == "Outstanding")
                    {
                        <form method="post" asp-page-handler="Revoke" asp-route-id="@invite.Id">
                            <button type="submit" class="btn btn-sm btn-outline-danger">@Localiser["Tokens_Revoke"]</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
