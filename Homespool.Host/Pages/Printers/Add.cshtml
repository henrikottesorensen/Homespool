@page
@model AddModel
@{
    ViewData["Title"] = Localiser["Printers_Add"].Value;
}

<h1>@ViewData["Title"]</h1>

<p>
    @Localiser["Printers_AddIntro"]
</p>

@if (Model.Offer is not null)
{
    <partial name="_BundleDownload" model="Model.Offer" />
}

@if (!Model.PrinterAddressConfigured)
{
    <div class="alert alert-warning" role="alert">
        @Html.Raw(string.Format(System.Globalization.CultureInfo.CurrentCulture, Localiser["Printers_NoPublicAddress"].Value, "<code>PrusaConnect:PrinterHost</code>"))
    </div>
}

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Name" class="form-control" placeholder="@Localiser["Printers_NamePlaceholder"]" />
                <label asp-for="Input.Name" class="form-label"></label>
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Location" class="form-control" placeholder="@Localiser["Common_LocationPlaceholder"]" />
                <label asp-for="Input.Location" class="form-label"></label>
                <span asp-validation-for="Input.Location" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.TeamId" class="form-label"></label>
                <select asp-for="Input.TeamId" asp-items="@Model.TeamOptions" class="form-select"></select>
                <span asp-validation-for="Input.TeamId" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary" disabled="@(!Model.PrinterAddressConfigured)">
                @Localiser["Printers_ProvisionButton"]
            </button>
            <a class="btn btn-link" asp-page="Index">@Localiser["Printers_BackToList"]</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
